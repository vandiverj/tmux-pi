@@ -0,0 +1,26 @@
+import { describe, expect, it } from 'vitest';
+import { formatRemainingShots, getRemainingShots } from './boardFeedback';
+import type { GameState } from './types';
+
+const stateWith = (shotCount: number, shotLimit: number) => ({ shotCount, shotLimit }) as GameState;
+
+describe('getRemainingShots', () => {
+  it('subtracts the shots used from the limit', () => {
+    expect(getRemainingShots(stateWith(4, 26))).toBe(22);
+  });
+
+  it('never goes below zero', () => {
+    expect(getRemainingShots(stateWith(30, 26))).toBe(0);
+  });
+});
+
+describe('formatRemainingShots', () => {
+  it('uses the singular for one shot', () => {
+    expect(formatRemainingShots(1)).toBe('1 shot remaining');
+  });
+
+  it('uses the plural otherwise', () => {
+    expect(formatRemainingShots(0)).toBe('0 shots remaining');
+    expect(formatRemainingShots(3)).toBe('3 shots remaining');
+  });
+});
