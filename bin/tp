#!/usr/bin/env bash
# tp — launch the tmux-pi workspace.
#
#   ┌──────────────┬──────────────┐
#   │              │ status       │
#   │ main pi      ├──────────────┤
#   │              │ viewer slot  │
#   └──────────────┴──────────────┘
#
# Usage: tp [workdir]    (defaults to the current directory)
# Env:   TP_SESSION      tmux session name (default: tmux-pi)
set -euo pipefail

# Resolve symlinks (e.g. ~/.local/bin/agent -> bin/tp) to find the repo.
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
WORKDIR="$(cd "${1:-$PWD}" && pwd)"
SESSION="${TP_SESSION:-tmux-pi}"
STATE_DIR="$WORKDIR/.tmux-pi"

command -v tmux >/dev/null || { echo "tp: tmux not found (brew install tmux)" >&2; exit 1; }
command -v pi   >/dev/null || { echo "tp: pi not found" >&2; exit 1; }

# Load the LM Studio models this machine's config routes to; if that fails, say so and go on.
"$ROOT/bin/tp-lmstudio" ensure ||
  echo "tp: warning: LM Studio models are not ready; workers on them will fail (bin/tp-lmstudio status)" >&2

# Slot commands: they must never exit (ignore ctrl-c/ctrl-\\/ctrl-z, and the status list restarts).
status_cmd="trap '' INT QUIT TSTP; while true; do '$ROOT/bin/tp-status'; sleep 1; done"
viewer_cmd="trap '' INT QUIT TSTP; stty -echo -icanon; clear; echo 'no subagent selected'; exec tail -f /dev/null"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  # Reattaching must not leave the client in the status/viewer or an old worker.
  # Pane ids survive client detach, so the recorded main pane is the reliable target.
  main_pane="$(tmux show-options -qv -t "=$SESSION:" @tp_main_pane)"
  # Repair the layout: a status or viewer pane that was closed is recreated.
  # A viewer that is parked while a subagent occupies its slot is left alone.
  if [[ -n "$main_pane" ]] && tmux list-panes -a -F '#{pane_id}' | grep -qx "$main_pane"; then
    pane_alive() { [[ -n "$1" ]] && tmux list-panes -a -F '#{pane_id}' | grep -qx "$1"; }
    opt() { tmux show-options -qv -t "=$SESSION:" "$1"; }
    win="$(tmux display-message -p -t "$main_pane" '#{window_id}')"
    # Right-hand column: any pane in the main window that is not main and not the status pane.
    side_pane() { tmux list-panes -t "$win" -F '#{pane_id}' | grep -vx -e "$main_pane" -e "$(opt @tp_status_pane)" | head -1 || true; }
    if ! pane_alive "$(opt @tp_status_pane)"; then
      side="$(side_pane)"
      if [[ -n "$side" ]]; then
        new="$(tmux split-window -v -b -l 35% -P -F '#{pane_id}' -t "$side" -c "$WORKDIR" "$status_cmd")"
      else
        new="$(tmux split-window -h -l 50% -P -F '#{pane_id}' -t "$main_pane" -c "$WORKDIR" "$status_cmd")"
      fi
      tmux set-option -t "=$SESSION:" @tp_status_pane "$new"
      tmux select-pane -t "$new" -T status
    fi
    if ! pane_alive "$(opt @tp_viewer_pane)"; then
      new="$(tmux split-window -v -l 65% -P -F '#{pane_id}' -t "$(opt @tp_status_pane)" -c "$WORKDIR" "$viewer_cmd")"
      tmux set-option -t "=$SESSION:" @tp_viewer_pane "$new"
      tmux set-option -t "=$SESSION:" @tp_viewing ""
      tmux select-pane -t "$new" -T viewer
    fi
  fi
  [[ -z "$main_pane" ]] || tmux select-pane -t "$main_pane"
  if [[ -n "${TMUX:-}" ]]; then exec tmux switch-client -t "$SESSION"; fi
  exec tmux attach -t "$SESSION"
fi

mkdir -p "$STATE_DIR/state" "$STATE_DIR/tasks"

# pi reads settings, models, auth, extensions, skills, prompts and themes only
# from the repo's agent/ dir — never from ~/.pi/agent.
AGENT_DIR="$ROOT/agent"

main_cmd="'$ROOT/bin/tp-pi'"

# The status and viewer slots must never exit: a closed slot pane breaks the
# layout. Both ignore ctrl-c/ctrl-\\/ctrl-z (ignored signals carry into the
# commands they run), and the status list is restarted if it ever exits.
cols="$(tput cols 2>/dev/null || echo 200)"
lines="$(tput lines 2>/dev/null || echo 50)"

main_pane="$(tmux new-session -d -P -F '#{pane_id}' -s "$SESSION" -n main -c "$WORKDIR" -x "$cols" -y "$lines" \
  -e "PI_CODING_AGENT_DIR=$AGENT_DIR" -e "PATH=$ROOT/bin:$PATH")"
# Session-level env so every later pane/window (subagents) gets it too, and
# tp-* commands are on PATH for you and the agents.
tmux set-environment -t "$SESSION" PI_CODING_AGENT_DIR "$AGENT_DIR"
tmux set-environment -t "$SESSION" PATH "$ROOT/bin:$PATH"
# pi needs extended keys for modified Enter (e.g. shift+enter). Server-wide option.
tmux set-option -s extended-keys on
tmux set-option -s extended-keys-format csi-u
# Set before the status pane starts so tp-status can find the session's state.
tmux set-option -t "$SESSION" @tp_root "$ROOT"
tmux set-option -t "$SESSION" @tp_agent_dir "$AGENT_DIR"
tmux set-option -t "$SESSION" @tp_state_dir "$STATE_DIR"
status_pane="$(tmux split-window -h -l 50% -P -F '#{pane_id}' -t "$main_pane" -c "$WORKDIR" "$status_cmd")"
viewer_pane="$(tmux split-window -v -l 65% -P -F '#{pane_id}' -t "$status_pane" -c "$WORKDIR" "$viewer_cmd")"

# Record pane ids so other tp-* tools and extensions can find the slots.
tmux set-option -t "$SESSION" @tp_main_pane "$main_pane"
tmux set-option -t "$SESSION" @tp_status_pane "$status_pane"
tmux set-option -t "$SESSION" @tp_viewer_pane "$viewer_pane"

tmux select-pane -t "$status_pane" -T status
tmux select-pane -t "$viewer_pane" -T viewer
tmux select-pane -t "$main_pane" -T main
tmux set-option -t "$SESSION" pane-border-status top
tmux set-option -t "$SESSION" mouse on
# Mouse mode captures drags, so native Terminal selection stops working. Make a
# drag-select copy straight to the system clipboard instead (Apple Terminal has
# no OSC 52 support, so pipe to a clipboard tool when one is available).
tmux set-option -s set-clipboard on
for clip in pbcopy wl-copy "xclip -selection clipboard"; do
  if command -v "${clip%% *}" >/dev/null 2>&1; then
    for table in copy-mode copy-mode-vi; do
      tmux bind-key -T "$table" MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$clip"
    done
    break
  fi
done

tmux send-keys -t "$main_pane" "$main_cmd" Enter

# Make the main Pi editor—not either read-only side pane—the active pane for
# the client that is about to attach.
tmux select-pane -t "$main_pane"

if [[ "${TP_NO_ATTACH:-}" == 1 ]]; then exit 0; fi
if [[ -n "${TMUX:-}" ]]; then exec tmux switch-client -t "$SESSION"; fi
exec tmux attach -t "$SESSION"
