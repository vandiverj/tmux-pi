#!/usr/bin/env bash
# tp — launch the tmux-pi workspace.
#
#   ┌──────────────┬──────────────┐
#   │              │ status       │
#   │ main agent   ├──────────────┤
#   │              │ viewer slot  │
#   └──────────────┴──────────────┘
#
# Usage: agent|tp [--resume] [--main pi|claude] [workdir] (defaults to the current directory)
# Default main harness: claude when invoked as `agent` (the console symlink to
# this script), pi when invoked as `tp`. TP_MAIN_HARNESS or --main overrides it.
# Env:   TP_SESSION      optional explicit tmux session name (default: a fresh project run)
set -euo pipefail

# Resolve symlinks (e.g. ~/.local/bin/agent -> bin/tp) to find the repo.
src="${BASH_SOURCE[0]}"
invoked_as="$(basename "$src")"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
default_harness=pi
[[ "$invoked_as" != agent ]] || default_harness=claude
MAIN_HARNESS="${TP_MAIN_HARNESS:-$default_harness}"
MAIN_HARNESS_EXPLICIT=0
WORKDIR_ARG=""
RESUME=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --resume) RESUME=1; shift ;;
    --main) MAIN_HARNESS="${2:?choose pi or claude}"; MAIN_HARNESS_EXPLICIT=1; shift 2 ;;
    -h|--help) echo "usage: agent|tp [--resume] [--main pi|claude] [workdir] (agent defaults to claude; tp to pi)"; exit 0 ;;
    -*) echo "tp: unknown option $1" >&2; exit 2 ;;
    *) [[ -z "$WORKDIR_ARG" ]] || { echo "tp: only one workdir is allowed" >&2; exit 2; }
       WORKDIR_ARG="$1"; shift ;;
  esac
done
case "$MAIN_HARNESS" in pi|claude) ;; *) echo "tp: --main must be pi or claude" >&2; exit 2 ;; esac
# The older TP_MAIN entry point uses a different Claude prompt, but must still
# identify its harness correctly for resume checks, status, and worker routing.
case "${TP_MAIN:-}" in
  "") ;;
  pi|claude)
    if (( MAIN_HARNESS_EXPLICIT )) && [[ "$MAIN_HARNESS" != "$TP_MAIN" ]]; then
      echo "tp: TP_MAIN and --main disagree" >&2; exit 2
    fi
    MAIN_HARNESS="$TP_MAIN"
    MAIN_HARNESS_EXPLICIT=1
    ;;
  *) echo "tp: TP_MAIN must be 'pi' or 'claude', got '$TP_MAIN'" >&2; exit 2 ;;
esac
WORKDIR="$(cd "${WORKDIR_ARG:-$PWD}" && pwd -P)"
SESSION="${TP_SESSION:-}"
RUN_ID="$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
STATE_DIR="$WORKDIR/.tmux-pi/sessions/$RUN_ID"

command -v tmux >/dev/null || { echo "tp: tmux not found (brew install tmux)" >&2; exit 1; }
command -v python3 >/dev/null || { echo "tp: python3 not found" >&2; exit 1; }
# Check the selected harness only when creating a session. Resuming an existing
# workspace must not require the invoking command's default harness to be installed.

# A live harness cannot be moved to another project by attaching to it.
# Reuse a legacy session only when its recorded workspace is this directory.
session_workdir() {
  local directory state
  directory="$(tmux show-options -qv -t "=$1:" @tp_workdir)"
  if [[ -z "$directory" ]]; then
    state="$(tmux show-options -qv -t "=$1:" @tp_state_dir)"
    [[ "$state" == */.tmux-pi ]] && directory="${state%/.tmux-pi}"
  fi
  [[ -n "$directory" && -d "$directory" ]] || return 1
  (cd "$directory" && pwd -P)
}
if [[ -z "$SESSION" ]]; then
  if [[ "$RESUME" == 1 ]]; then
    while IFS= read -r candidate; do
      if [[ "$(session_workdir "$candidate" || true)" == "$WORKDIR" ]]; then
        SESSION="$candidate"
        break
      fi
    done < <(tmux list-sessions -F '#{session_created} #{session_name}' 2>/dev/null | sort -nr | cut -d ' ' -f2-)
    [[ -n "$SESSION" ]] || { echo "tp: no running workspace for '$WORKDIR'; run agent to start one" >&2; exit 1; }
  else
    project_key="$(python3 -c 'import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:12])' "$WORKDIR")"
    SESSION="tmux-pi-$project_key-${RUN_ID:0:12}"
  fi
fi

# Local models are loaded on demand by tp-spawn when selected for a worker.
# Starting the workspace must not wait for an optional model service.

# Slot commands: they must never exit (ignore ctrl-c/ctrl-\\/ctrl-z, and the status list restarts).
status_cmd="trap '' INT QUIT TSTP; while true; do '$ROOT/bin/tp-status'; sleep 1; done"
viewer_cmd="trap '' INT QUIT TSTP; stty -echo -icanon; clear; echo 'no subagent selected'; exec tail -f /dev/null"

if tmux has-session -t "=$SESSION" 2>/dev/null; then
  if [[ "$RESUME" != 1 ]]; then
    echo "tp: session '$SESSION' already exists; use --resume or unset TP_SESSION for a fresh run" >&2
    exit 1
  fi
  existing_workdir="$(session_workdir "$SESSION" || true)"
  if [[ "$existing_workdir" != "$WORKDIR" ]]; then
    echo "tp: session '$SESSION' belongs to '${existing_workdir:-an unknown directory}', not '$WORKDIR'; unset TP_SESSION or choose another name" >&2
    exit 1
  fi
  existing_harness="$(tmux show-options -qv -t "=$SESSION:" @tp_main_harness)"
  if [[ "$MAIN_HARNESS_EXPLICIT" == 1 && -n "$existing_harness" && "$existing_harness" != "$MAIN_HARNESS" ]]; then
    echo "tp: session '$SESSION' already runs $existing_harness as main; end it or choose another TP_SESSION to start $MAIN_HARNESS" >&2
    exit 1
  fi
  # Reattaching must not leave the client in the status/viewer or an old worker.
  # Pane ids survive client detach, so the recorded main pane is the reliable target.
  main_pane="$(tmux show-options -qv -t "=$SESSION:" @tp_main_pane)"
  # Repair the layout: a status or viewer pane that was closed is recreated.
  # A viewer that is parked while a subagent occupies its slot is left alone.
  if [[ -n "$main_pane" ]] && tmux list-panes -a -F '#{pane_id}' | grep -qx "$main_pane"; then
    pane_alive() { [[ -n "$1" ]] && tmux list-panes -a -F '#{pane_id}' | grep -qx "$1"; }
    opt() { tmux show-options -qv -t "=$SESSION:" "$1"; }
    win="$(tmux display-message -p -t "$main_pane" '#{window_id}')"
    # Right-hand column: any pane in the main window that is not main and not the status pane.
    side_pane() { tmux list-panes -t "$win" -F '#{pane_id}' | grep -vx -e "$main_pane" -e "$(opt @tp_status_pane)" | head -1 || true; }
    if ! pane_alive "$(opt @tp_status_pane)"; then
      side="$(side_pane)"
      if [[ -n "$side" ]]; then
        new="$(tmux split-window -v -b -l 35% -P -F '#{pane_id}' -t "$side" -c "$WORKDIR" "$status_cmd")"
      else
        new="$(tmux split-window -h -l 50% -P -F '#{pane_id}' -t "$main_pane" -c "$WORKDIR" "$status_cmd")"
      fi
      tmux set-option -t "=$SESSION:" @tp_status_pane "$new"
      tmux select-pane -t "$new" -T status
    fi
    if ! pane_alive "$(opt @tp_viewer_pane)"; then
      new="$(tmux split-window -v -l 65% -P -F '#{pane_id}' -t "$(opt @tp_status_pane)" -c "$WORKDIR" "$viewer_cmd")"
      tmux set-option -t "=$SESSION:" @tp_viewer_pane "$new"
      tmux set-option -t "=$SESSION:" @tp_viewing ""
      tmux select-pane -t "$new" -T viewer
    fi
  fi
  [[ -z "$main_pane" ]] || tmux select-pane -t "$main_pane"
  if [[ "${TP_NO_ATTACH:-}" == 1 ]]; then exit 0; fi
  if [[ -n "${TMUX:-}" ]]; then exec tmux switch-client -t "=$SESSION"; fi
  exec tmux attach -t "=$SESSION"
fi

[[ "$RESUME" != 1 ]] || { echo "tp: session '$SESSION' does not exist" >&2; exit 1; }
command -v "$MAIN_HARNESS" >/dev/null || { echo "tp: $MAIN_HARNESS not found" >&2; exit 1; }

# The workdir is the root these are checked from: a link at .tmux-pi, sessions, the session dir, state or tasks (a repo can
# commit one) is refused, so the session state never lands outside the project.
python3 "$ROOT/lib/safe_write.py" mkdir --root "$WORKDIR" "$STATE_DIR/state" "$STATE_DIR/tasks" \
  || { echo "tp: refusing to start: a symlink in the session state path under $WORKDIR/.tmux-pi" >&2; exit 1; }

# pi reads settings, models, auth, extensions, skills, prompts and themes only
# from the repo's agent/ dir — never from ~/.pi/agent.
AGENT_DIR="$ROOT/agent"

case "${TP_MAIN:-}" in
  # tp-main launches the harness recorded for this session (pi or claude).
  ""|pi) main_cmd="TP_MAIN_HARNESS='$MAIN_HARNESS' '$ROOT/bin/tp-main'" ;;
  # Legacy remote entry point: plain Claude as main with its own prompt.
  claude) main_cmd="TP_MODE=legacy '$ROOT/bin/tp-claude' --append-system-prompt-file '$ROOT/claude/main-prompt.md'" ;;
  *)      echo "tp: TP_MAIN must be 'pi' or 'claude', got '$TP_MAIN'" >&2; exit 2 ;;
esac

# The status and viewer slots must never exit: a closed slot pane breaks the
# layout. Both ignore ctrl-c/ctrl-\\/ctrl-z (ignored signals carry into the
# commands they run), and the status list is restarted if it ever exits.
cols="$(tput cols 2>/dev/null || echo 200)"
lines="$(tput lines 2>/dev/null || echo 50)"

main_pane="$(tmux new-session -d -P -F '#{pane_id}' -s "$SESSION" -n main -c "$WORKDIR" -x "$cols" -y "$lines" \
  -e "PI_CODING_AGENT_DIR=$AGENT_DIR" -e "TP_MAIN_HARNESS=$MAIN_HARNESS" -e "TP_WORKDIR=$WORKDIR" -e "TP_STATE_DIR=$STATE_DIR" \
  -e "TP_CLAUDE_CONFIG_DIR=${TP_CLAUDE_CONFIG_DIR:-}" -e "PATH=$ROOT/bin:$PATH")"
# Session-level env so every later pane/window (subagents) gets it too, and
# tp-* commands are on PATH for you and the agents.
tmux set-environment -t "$SESSION" PI_CODING_AGENT_DIR "$AGENT_DIR"
tmux set-environment -t "$SESSION" PATH "$ROOT/bin:$PATH"
tmux set-environment -t "$SESSION" TP_MAIN_HARNESS "$MAIN_HARNESS"
tmux set-environment -t "$SESSION" TP_WORKDIR "$WORKDIR"
tmux set-environment -t "$SESSION" TP_STATE_DIR "$STATE_DIR"
tmux set-environment -t "$SESSION" TP_CLAUDE_CONFIG_DIR "${TP_CLAUDE_CONFIG_DIR:-}"
# pi needs extended keys for modified Enter (e.g. shift+enter). Server-wide option.
tmux set-option -s extended-keys on
tmux set-option -s extended-keys-format csi-u
# Set before the status pane starts so tp-status can find the session's state.
tmux set-option -t "$SESSION" @tp_root "$ROOT"
tmux set-option -t "$SESSION" @tp_agent_dir "$AGENT_DIR"
tmux set-option -t "$SESSION" @tp_state_dir "$STATE_DIR"
tmux set-option -t "$SESSION" @tp_workdir "$WORKDIR"
tmux set-option -t "$SESSION" @tp_main_harness "$MAIN_HARNESS"
status_pane="$(tmux split-window -h -l 50% -P -F '#{pane_id}' -t "$main_pane" -c "$WORKDIR" "$status_cmd")"
viewer_pane="$(tmux split-window -v -l 65% -P -F '#{pane_id}' -t "$status_pane" -c "$WORKDIR" "$viewer_cmd")"

# Record pane ids so other tp-* tools and extensions can find the slots.
tmux set-option -t "$SESSION" @tp_main_pane "$main_pane"
tmux set-option -t "$SESSION" @tp_status_pane "$status_pane"
tmux set-option -t "$SESSION" @tp_viewer_pane "$viewer_pane"

tmux select-pane -t "$status_pane" -T status
tmux select-pane -t "$viewer_pane" -T viewer
tmux select-pane -t "$main_pane" -T main
tmux set-option -t "$SESSION" pane-border-status top
tmux set-option -t "$SESSION" mouse on
# Mouse mode captures drags, so native Terminal selection stops working. Make a
# drag-select copy straight to the system clipboard instead (Apple Terminal has
# no OSC 52 support, so pipe to a clipboard tool when one is available).
tmux set-option -s set-clipboard on
for clip in pbcopy wl-copy "xclip -selection clipboard"; do
  if command -v "${clip%% *}" >/dev/null 2>&1; then
    for table in copy-mode copy-mode-vi; do
      tmux bind-key -T "$table" MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "$clip"
    done
    break
  fi
done

tmux send-keys -t "$main_pane" "$main_cmd" Enter

# Make the main agent—not either read-only side pane—the active pane for
# the client that is about to attach.
tmux select-pane -t "$main_pane"

if [[ "${TP_NO_ATTACH:-}" == 1 ]]; then exit 0; fi
if [[ -n "${TMUX:-}" ]]; then exec tmux switch-client -t "=$SESSION"; fi
exec tmux attach -t "=$SESSION"
