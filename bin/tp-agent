from worker_process import (FINISHED, READ_ONLY_ROLES, alive_on_workdir, clear_commands, describe_state, end_or_refuse, end_process,  # noqa: E402
                            end_orphan, finishes_alone, guard_retry, guard_review, live_process, orphans, pane_table, same_tree,
                            state_words, task_state)

ROLES = ROOT / "agent" / "roles"
TESTS_SCOPES = ("affected", "full", "none")
TESTS_DEFAULT = "affected"
IDENT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
ACTIVE = {"starting", "working", "tool", "permission", "needs_input"}
LOCAL = ("slotstream/", "lmstudio/", "mlx/", "ollama/")


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def read_json(path, default=None):
    try:
        value = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {} if default is None else default
    return value if isinstance(value, dict) else {} if default is None else default  # every record here is an object


def atomic_text(path, text, root=None):
    """Temp file in the same directory, then one rename: a reader (or a crash) sees the old file or the new one, never half.
    A link at path is replaced, never written through; one in a directory below root (the session state directory, which
    every caller passes) is refused."""
    path = Path(path)
    safe_write.ensure_dir(path.parent, root=root)
    safe_write.write_atomic(path, text, mode=0o600, root=root)


def atomic_json(path, value, root=None):
    atomic_text(path, json.dumps(value, indent=2) + "\n", root)


def state_dir():
    explicit = os.getenv("TP_STATE_DIR")
    if explicit:
        return Path(explicit).resolve()
    if os.getenv("TMUX"):
        target = ["-t", os.environ["TMUX_PANE"]] if os.getenv("TMUX_PANE") else []
        session = subprocess.check_output(["tmux", "display-message", "-p", *target, "#S"], text=True).strip()
    else:
        session = os.getenv("TP_SESSION", "tmux-pi")
    value = subprocess.check_output(["tmux", "show-options", "-qv", "-t", f"={session}:", "@tp_state_dir"], text=True).strip()
    if not value:
        raise ValueError("no tmux-pi state directory; start a workspace with tp")
    return Path(value)


def refreshed(base, ident, value):
    """After a change of a task's state, bring its canonical record (task.md) up to date, so no reader sees the old state.
    The change stands whatever happens here: a failure is said on stderr and in the answer, not turned into a failed command."""
    problem = refresh_record(base, ident)
    if problem:
        print(f"tp-agent: {problem}", file=sys.stderr)
        value["record"] = problem


def task_dir(base, ident):
    if not IDENT.fullmatch(ident):
        raise ValueError("invalid task id")
    path = base / "tasks" / ident
    safe_write.check_below(base, path, f"task directory {ident}")  # tasks/ and tasks/<id> are both owned: neither may be a link
    if not (path / "meta.json").is_file():
        archived = find_archived_task(base, ident)
        if archived:  # stop and collect move a task here; every command that works on a task refuses it by place
            raise ValueError(f"task {ident} is in the session archive at {archived}, not among the active tasks; "
                             "retry and review work only on active tasks (a retry's lineage and review rounds are read from tasks/)")
        raise ValueError(f"unknown task: {ident}")
    return path


def lifecycle(path):
    # tp-agent does not look at panes: contract.lifecycle reads an unobserved pane as present.
    return task_lifecycle(path)[0]


def usage_fields(state):
    """(tokens, cost) for a task record, only what the harness measured. Tokens are null until the reporter has counted some
    (a Claude worker's are counted from its transcript at each prompt and at Stop, so a zero before that is not a count).
    A harness that reports no cost (Claude's transcripts carry none; the reporter sets costKnown false) has no cost key at all:
    a 0 there read as free work."""
    tokens = state.get("tokens")
    if isinstance(tokens, dict) and not any(isinstance(v, (int, float)) and not isinstance(v, bool) and v > 0 for v in tokens.values()):
        tokens = None
    fields = {"tokens": tokens}
    if state.get("costKnown") is False:
        fields["cost_known"] = False
    else:
        fields["cost"] = state.get("cost")
    return fields


def record(path, include_result=False):
    meta = read_json(path / "meta.json")
    state = read_json(path / "state.json")
    result_path = path / "result.md"
    report_path = path / "report.md"
    # display text only (a lossy decode never feeds a verdict); a review's verdict comes from review_verdict.read_review below
    result_text = result_path.read_bytes().decode("utf-8", "replace") if result_path.exists() else ""
    result = {
        "id": meta.get("id", path.name), "role": meta.get("role", "generic"),
        "harness": meta.get("worker", "unknown"), "model": state.get("model") or meta.get("model"),
        "effort": meta.get("thinking"), "status": lifecycle(path),
        "assignment": (path / "request.md").read_text() if (path / "request.md").exists() else "",
        "deliverable": meta.get("deliverable", ""), "parent": meta.get("parent", ""),
        "route": meta.get("route_info", {}), "task_dir": str(path),
        "packet": str(path / "packet.md"), "result_path": str(result_path) if result_path.exists() else None,
        "result_status": result_status(result_text),
        "tool": state.get("tool", ""), "updated": state.get("updated", meta.get("created")),
        **usage_fields(state),
        "permission": read_json(path / "permission-request.json") if (path / "permission-request.json").exists() else None,
        "capability_request": read_json(path / "capability-request.json") if (path / "capability-request.json").exists() else None,
        # the same test lib/contract.py uses to hold a task at needs_input for human capability approval
        "capability_pending": (path / "pending-capability.json").exists(),
        # The worker's own report file, kept apart from result.md (the last reply, rewritten at every Stop).
        "report_path": str(report_path) if report_path.is_file() else None,
        "report_bytes": report_path.stat().st_size if report_path.is_file() else None,
        "transcript": (path / "transcript-path").read_text().strip() if (path / "transcript-path").exists()
                      else str(path / "transcript.jsonl") if (path / "transcript.jsonl").exists() else None,
    }
    if "lane" in meta and "lane_step" in meta:  # shown only; a task with no lane has neither key
        result.update(lane=meta["lane"], lane_step=meta["lane_step"])
    reported = failing_tests.read(path)
    if reported:  # a report without the block has no such key
        result["failing_tests"] = reported
    if (path / "review-of").is_file():
        # a reviewer's verdict; a reply that is not one is reported as such, never read as an approval. A review without a
        # Coverage section keeps its stated verdict but is incomplete: result_status says so and it approves nothing.
        try:
            result["verdict"], result["verdict_notes"], incomplete = review_verdict.assess(review_verdict.read_review(result_path))
        except review_verdict.ReviewMissing:
            result["verdict"], result["verdict_notes"], incomplete = "unparseable", "the review has no result yet", "the review has no result yet"
        except ValueError as exc:
            result["verdict"], result["verdict_notes"], incomplete = "unparseable", str(exc), str(exc)
        result["review_complete"] = incomplete is None
        if incomplete:
            result["review_incomplete_reason"] = incomplete
            result["stated_result_status"], result["result_status"] = result["result_status"], "incomplete"
            result["review_notice"] = (f"{result['id']}'s review is incomplete: {incomplete}. Its verdict "
                                       f"({result['verdict']}) is kept for the record but does not count as an approval; "
                                       "ask for the review again.")
    if include_result:
        result["result"] = result_text
    return result


def paused_notice(base, path, ident, status):
    """What collect says of a paused task: why nothing was collected, the form a reply needs, and the commands that go on.
    A worker whose pane still runs is asked with `tp-agent message`; one whose pane is gone cannot be, so the notice offers a
    retry instead of a command that would fail."""
    try:
        asked = live_process(path, pane_table()) is not None
    except (RuntimeError, ValueError):
        asked = True  # the pane list cannot be read here; the message command is still the right one to try
    if status:
        why = f"{ident} is paused; nothing was collected."
        ask = f"tp-agent message {ident} --text \"Continue, or reply with your final result\""
    else:
        why = (f"{ident} replied without a result status (paused); nothing was collected. A reply is collected when it has "
               f"{RESULT_STATUS_FORM}.")
        ask = f"tp-agent message {ident} --text \"End your reply with a line that reads exactly RESULT_STATUS: complete\""
    if asked:
        return f"{why} Ask the worker with: `{ask}`. Or end it: `tp-agent stop {ident}`."
    return (f"{why} Its pane is gone, so it cannot be asked: `tp-agent retry {ident} --reason \"say what changed\"` starts it again, "
            f"or `tp-agent stop {ident}` marks it stopped.")


def reap(base, args):
    """List finished tasks whose process is still alive; end them only with --yes."""
    for ident in args.ids:
        task_dir(base, ident)  # an unknown id refuses by name
    table, found = pane_table(), []
    tasks = base / "tasks"
    for path in sorted(tasks.iterdir()) if tasks.exists() else []:
        if not (path / "meta.json").is_file() or (args.ids and path.name not in args.ids):
            continue
        live = live_process(path, table)
        if live and lifecycle(path) in FINISHED:
            found.append({"id": path.name, "status": lifecycle(path), "pane": live[0], "pid": live[1]})
    found += orphans(tasks, args.ids)  # a failed stop's process, its pane gone (process.json)
    failed = []
    for row in found:
        if args.yes:
            row.update(end_orphan(tasks, row) if row.get("orphan") else end_process(tasks / row["id"]))
            if row.get("ended") is False:
                failed.append(row)
    if failed:  # the requested cleanup was not done: non-zero, the survivors named; a later reap retries
        raise RuntimeError("; ".join(f"{row['id']}'s process is still alive: {row.get('reason')} (pane {row.get('pane')}, pid {row.get('pid')})"
                                     for row in failed))
    return {"confirmed": bool(args.yes), "tasks": found,
            **({} if args.yes or not found else {"note": "nothing ended; run again with --yes to end these processes"})}


def all_records(base):
    tasks = base / "tasks"
    rows = [record(path) for path in tasks.iterdir() if (path / "meta.json").is_file()] if tasks.exists() else []
    for path in queue_files(base):
        _, item, reason = queue_entry(path)
        item = item or {}  # a refused entry shows only its file name and why
        rows.append({"id": item.get("id", path.stem), "role": item.get("role"), "harness": item.get("worker"),
                     "model": item.get("model"), "effort": item.get("thinking"), "status": "queued",
                     "assignment": item.get("task"), "deliverable": item.get("deliverable"),
                     "parent": item.get("parent"), "route": item.get("route_info"),
                     "reason": reason or item.get("queue_reason") or None,
                     "task_dir": None, "packet": None, "result_path": None, "updated": item.get("created"),
                     **({"lane": item["lane"], "lane_step": item["lane_step"]} if "lane" in item and "lane_step" in item else {})})
    return sorted(rows, key=lambda row: row.get("updated") or "")


def build_index(base):
    rows = all_records(base)
    objective = base / "session-objective.md"
    def brief(row):
        out = {key: row.get(key) for key in ("id", "role", "harness", "model", "status", "result_status",
               "deliverable", "task_dir", "result_path", "permission", "capability_request", "capability_pending",
               "reason", "updated")}
        # a reviewer row carries its stated verdict and whether the review is complete; only a complete one approves
        out.update({key: row[key] for key in ("verdict", "review_complete", "review_incomplete_reason", "lane", "lane_step") if key in row})
        if row.get("failing_tests"):  # the worker reported failing tests it does not own (T12)
            out["failing_tests"] = len(row["failing_tests"]["entries"]) or 1
        return out
    value = {
        "schema": "tp-session-index:v1", "updated": now(),
        "objective": objective.read_text().strip() if objective.exists() else "",
        "active": [brief(r) for r in rows if r["status"] in {"queued", "starting", "working", "needs_input"}],
        "pending": [brief(r) for r in rows if r["status"] in {"settled", "failed"}],
        # paused workers, however old: shown to the main agent, never collected
        "unstatused": [brief(r) for r in rows if r["status"] == "paused" and not r.get("result_status")],
        "paused": [brief(r) for r in rows if r["status"] == "paused" and r.get("result_status")],
        "recent": [brief(r) for r in rows[-12:]],
    }
    summary = {}  # lane -> its tasks by status and the steps they ran; no lane tasks, no block
    for row in rows:
        if "lane" in row:
            entry = summary.setdefault(row["lane"], {"tasks": 0, "by_status": {}, "steps": []})
            entry["tasks"] += 1
            entry["by_status"][row["status"]] = entry["by_status"].get(row["status"], 0) + 1
            if row["lane_step"] not in entry["steps"]:
                entry["steps"] = sorted(entry["steps"] + [row["lane_step"]])
    if summary:
        value["lanes"] = summary
    try:
        block = work_index.build(base, tasks=[{"id": r.get("id"), "status": r.get("status"), "result_path": r.get("result_path")} for r in rows])
    except Exception as error:  # an unreadable or malformed work store never blocks the task index
        value["work_error"] = str(error)[:200]
    else:
        if block:  # no workspace and no note anywhere: no key, and the index is what it was before this block existed
            value["work"] = block
    return value


def write_index(base):
    value = build_index(base)
    atomic_json(base / "session-index.json", value, base)
    return value


ROUTE_INFO_KEYS = ("source", "level", "effort", "effort_abstract", "provider", "decided_by", "reason", "review",
                   "router_review", "steps", "approvals", "local_only", "catalog_version", "prompt_sha256", "card_sha256",
                   "selection_id")


def route_info(result):
    return {key: result.get(key) for key in ROUTE_INFO_KEYS}


def route(task, role, worker, model, thinking, context=(), deliverable="", level=None, approve_effort=False,
          local_only=False, workdir=None, base=None):
    """Choose (worker, model, effort, route_info) with the catalog router (lib/model_router.py). Explicit --worker,
    --model, --thinking and --level are constraints; the pair is always valid, or ValueError says why the user must
    decide. Nothing here calls Laya."""
    sys.path.insert(0, str(ROOT / "lib"))
    import model_router
    result = model_router.select({"task": task, "role": role, "deliverable": deliverable, "context": list(context),
                                  "workdir": workdir, "worker": worker, "model": model, "thinking": thinking,
                                  "level": level, "local_only": local_only, "approve_effort": approve_effort}, base=base)
    return result["worker"], result["model"], result["thinking"], route_info(result)


def escalation_evidence(base, previous):
    """(failed attempts, REQUEST_CHANGES reviews) along the retry lineage that ends at `previous`. The walk has the
    limits lib/review_rounds.py puts on the same lineage: a loop or more than MAX_ANCESTORS tasks refuses (ValueError)
    instead of counting only part of the evidence."""
    failed = changes = 0
    seen, path = set(), previous
    while True:
        meta = read_json(path / "meta.json")
        ident = meta.get("id", path.name)
        if ident in seen:
            raise ValueError(f"the retry lineage of '{previous.name}' loops back to '{ident}'; cannot count its failed attempts")
        if len(seen) >= review_rounds.MAX_ANCESTORS:
            raise ValueError(f"the retry lineage of '{previous.name}' is longer than {review_rounds.MAX_ANCESTORS} tasks; "
                             "refusing rather than counting only part of it")
        seen.add(ident)
        rec = record(path)
        if rec["status"] in {"failed", "stopped"} or rec["result_status"] in {"incomplete", "blocked"}:
            failed += 1
        if meta.get("review"):
            try:
                text = review_verdict.read_review(task_dir(base, meta["review"]) / "result.md")
                # only a stated REQUEST_CHANGES counts toward escalation, complete or not (an incomplete review is never an
                # approval); APPROVED, APPROVED_WITH_NOTES and incomplete approvals count as neither
                changes += 1 if review_verdict.assess(text)[0] == "REQUEST_CHANGES" else 0
            except (ValueError, OSError):
                pass
        if not meta.get("parent"):
            break
        try:
            path = task_dir(base, meta["parent"])
        except ValueError as error:
            if find_archived_task(base, meta["parent"]):  # an archived ancestor: counting without it would understate the evidence
                raise ValueError(f"the retry lineage of '{previous.name}' passes through an archived task: {error}")
            break
    return failed, changes


def escalation_route(base, previous, args, contexts):
    """(worker, model, effort, route_info) for `retry --escalate`: effort up before level, only after the catalog's
    number of failed attempts or REQUEST_CHANGES reviews."""
    sys.path.insert(0, str(ROOT / "lib"))
    import model_router
    import router_catalog
    catalog = router_catalog.load_catalog()
    failed, changes = escalation_evidence(base, previous)
    need = catalog["escalation"]["after"]
    if max(failed, changes) < need:
        raise ValueError(f"escalation needs {need} failed attempts or {need} REQUEST_CHANGES reviews; found {failed} and "
                         f"{changes}. Retry without --escalate, or request a level explicitly with --level")
    meta = read_json(previous / "meta.json")
    try:  # the task text and admitted context, so the escalation record carries the same card hash as the dispatch
        meta = dict(meta, task=(previous / "request.md").read_text().strip(), context=contexts)
    except OSError:
        pass
    result = model_router.escalate_route(meta, catalog, role=args.role or meta.get("role"), worker=args.worker,
                                         approve_effort=args.approve_effort, base=base,
                                         local_only=getattr(args, "local_only", False))
    return result["worker"], result["model"], result["thinking"], route_info(result)


def lane_holders(base, lane, worktree, role, own=None):
    """[(task id, description)] of everything that holds lane `lane` against a new task of `role`. Three sources, because no
    one of them sees everything: the lane's lease (shared by every session of the repository: a worker or a start in ANY
    session), a process alive on its working tree among this session's tasks (read from the pane table, so a task started
    around the tool counts), and a queued item of this session for the lane or its tree (a queued item holds its lane's claim;
    queues are per session, and tick's start goes through the lease like any other). A read-only role (a reviewer) is held
    back only by a writer. When `own` is the id of a queued item, only the entries ahead of it in the queue count (tick: the
    oldest starts first). A lease, task directory, pane table or queue entry that cannot be read refuses: a writer cannot be
    ruled out. This is the early look that lets dispatch refuse and tick wait; the authority is the reservation tp-spawn makes."""
    holders = []
    common = lanes.git_common_dir(worktree)
    holders += [(h["task"], lane_lease.describe([h], base), h["access"] == "write", lane_lease.waiting_helps([h]))
                for h in lane_lease.conflicts(common, lane, role, own)]
    tasks = base / "tasks"
    if tasks.is_dir():
        holders += [(row[0], describe_state(tasks, [row]) + f"; to end it: {' or '.join(clear_commands(task_state(tasks, row[0]), row[0]))}",
                     row[1] not in READ_ONLY_ROLES, finishes_alone(task_state(tasks, row[0])))
                    for row in alive_on_workdir(tasks, worktree) if role not in READ_ONLY_ROLES or row[1] not in READ_ONLY_ROLES]
    for path in queue_files(base):
        if own is not None and path.stem == own:
            break
        raw, item, reason = queue_entry(path)
        if item is None:
            if isinstance(raw, dict) and raw.get("lane") != lane and isinstance(raw.get("workdir"), str) \
                    and not same_tree(raw["workdir"], worktree):
                continue  # an unusable entry that names another tree is not this lane's
            # tp-agent stop removes a queue entry by its id; a file whose name is no id can only be deleted by hand
            remove = f"`tp-agent stop {path.stem}`" if IDENT.fullmatch(path.stem) else f"delete the file {path}"
            raise ValueError(f"queue entry {path.name} cannot be read ({reason}), so a queued item for lane {lane} cannot be ruled out; "
                             f"remove it with: {remove}")
        if (item.get("lane") == lane or same_tree(item["workdir"], worktree)) and (role not in READ_ONLY_ROLES or item["role"] not in READ_ONLY_ROLES):
            holders.append((item["id"], f"{item['id']} (queued; to remove it: `tp-agent stop {item['id']}`)", item["role"] not in READ_ONLY_ROLES, True))
    seen, unique = set(), []
    for held in holders:  # the lease and the pane scan can both see one task
        if held[0] not in seen:
            seen.add(held[0])
            unique.append(held)
    return unique


def lane_refusal(name, holders):
    """The refusal for a lane that `holders` (lane_holders) keep: who holds it, in what state, and what frees it. A reviewer is
    called a reviewer; waiting is offered only when every holder is at work and will finish by itself."""
    first = f"lane {name} already has a writer" if any(held[2] for held in holders) else f"lane {name} is in use by a reviewer"
    return f"{first}: {', '.join(held[1] for held in holders)}. {lane_lease.advice_text(all(held[3] for held in holders))}, then dispatch again"


def capacity(base, item):
    """(ok, reason) for starting a queue item now. The item is validated here, so no caller can pass raw data."""
    item = queue_item(item)
    refusal = autonomy.gate(base, role=item["role"], deliverable=item["deliverable"], lane=item.get("lane", ""), lane_step=item.get("lane_step", ""),
                            parent=item["parent"])
    if refusal:  # the early look at tp-spawn's own gate: a queued item keeps waiting, with the reason, and starts once recovery is done
        return False, refusal
    if "lane" in item:  # the one-writer rule again at start, for what was written around the tool
        holders = lane_holders(base, item["lane"], item["workdir"], item["role"], own=item["id"])
        if holders:
            first = holders[0]
            # a holder that will not finish by itself (settled, paused) is not waited for: say what it is and what ends it
            return False, f"waiting for lane {item['lane']}'s writer {first[0]}" + ("" if first[3] else f" (it will not finish by itself: {first[1]})")
    worker, model = item["worker"], item["model"]
    cfg = read_json(ROOT / "config/orchestration.json")
    active = [r for r in all_records(base) if r["status"] in {"starting", "working", "needs_input"}]
    if len(active) >= int(cfg.get("max_active_workers", 4)):
        return False, "global worker slots full"
    if worker == "pi" and model.startswith(LOCAL):
        local = [r for r in active if r.get("harness") == "pi" and str(r.get("model") or "").startswith(LOCAL)]
        if len(local) >= int(cfg.get("max_local_workers", 2)):
            return False, "local model slots full"
    for parent in item["after"]:
        try:
            predecessor_dir = task_dir(base, parent)
            meta = read_json(predecessor_dir / "meta.json")
            if not meta:
                return False, f"dependency {parent} is unreadable"
            predecessor = record(predecessor_dir)
            life, state, events, reply = task_lifecycle(predecessor_dir)
        except ValueError:
            archived = find_archived_task(base, parent)
            if archived:
                return False, f"dependency {parent} is in the session archive at {archived}, not among the active tasks"
            return False, f"dependency {parent} has not started"
        # The shared answer first (a pause or an unstatused reply never satisfies), then admission's own
        # stricter rule: only a task that has a reply, settled or completed.
        if not satisfies_dependency(life, state, events, reply) or predecessor["status"] not in {"settled", "completed"} \
                or not predecessor["result_path"]:
            return False, f"waiting for {parent}"
    return True, ""


def admitted_context(path, specs):
    """Split context specs by tp-spawn's own omission notes in the packet; file contents are never read."""
    try:
        lines = set((path / "packet.md").read_text().splitlines())
    except OSError:
        return [], list(specs)  # admission cannot be confirmed
    admitted, omitted = [], []
    for spec in specs:
        marker = f"- Sensitive context {spec} was omitted from the packet."
        (omitted if any(line.startswith(marker) for line in lines) else admitted).append(spec)
    return admitted, omitted


def replay_inputs(previous, kept, problem=None):
    """Return (context, notes, remark) to replay from a prior attempt. `kept` is dispatch_record's return value, or
    None with its RecordError as `problem`; an unusable record replays nothing."""
    if kept is None:
        return [], [], ("The prior attempt has no dispatch record, so its selected context and notes were not replayed"
                        if problem is not None and problem.missing
                        else "The prior dispatch record is malformed, so its selected context and notes were not replayed")
    # Recheck against the prior packet too: records written before admission was tracked hold raw specs.
    contexts, omitted = admitted_context(previous, kept["context"])
    omitted = len(set(kept["omitted_context"] + omitted))
    notes = [note for note in kept["notes"] if not note.startswith("Retry of ")]
    return contexts, notes, (f"{omitted} context input(s) omitted as sensitive in the prior attempt were not replayed"
                             if omitted else "")


def launch(base, item):
    item = queue_item(item)  # every field below comes from the validator's return value
    args = [str(ROOT / "bin/tp-spawn"), "--task-id", item["id"], "--role", item["role"],
            "--worker", item["worker"], "--model", item["model"], "--thinking", item["thinking"],
            "--route-json", json.dumps(item["route_info"]), "--tests", item["tests"]]
    if item["deliverable"]:
        args += ["--deliverable", item["deliverable"]]
    args += ["--workdir", item["workdir"]]
    if item["parent"]:
        args += ["--parent", item["parent"]]
    if "lane" in item:
        args += ["--lane", item["lane"], "--lane-step", item["lane_step"], "--preamble-from", item["preamble_from"]]
    for spec in item["context"]:
        args += ["--context", spec]
    for note in item["notes"]:
        args += ["--note", note]
    for parent in item["after"]:
        predecessor = record(task_dir(base, parent))
        if predecessor.get("result_path"):
            args += ["--note", f"Dependency {parent} result: {predecessor['result_path']}"]
    args += ["--", item["task"]]
    started_at = failing_tests.head_commit(item["workdir"])  # the commit this task starts from (--investigate-failure diffs against it)
    run = subprocess.run(args, text=True, capture_output=True)
    if run.returncode:
        raise RuntimeError(run.stderr.strip() or "tp-spawn failed")
    # Record what the packet actually admitted so retry never replays an omitted sensitive input.
    path = task_dir(base, item["id"])
    admitted, omitted = admitted_context(path, item["context"])
    atomic_json(path / "dispatch.json",
                {"context": admitted, "omitted_context": omitted, "notes": item["notes"], "tests": item["tests"], "base_commit": started_at,
                 **({"lane": item["lane"], "lane_step": item["lane_step"]} if "lane" in item else {})}, base)  # shown only; retry reads meta.json
    return record(task_dir(base, item["id"]))


def locked(base):
    base.mkdir(parents=True, exist_ok=True)
    lock = safe_write.open_append(base / ".tp-agent.lock", root=base)
    fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def check_workdir(role, workdir=None, contexts=(), lane=None):
    """The canonical absolute workdir tp-spawn --check validated (explicit, else the main pane's); ValueError if
    tp-spawn refuses it or reports anything but an absolute path. The same check refuses a --context spec that is missing,
    binary or over the size cap, saying the cap, the size and the largest range that fits, so it fails here and not when
    a queued task starts."""
    command = [str(ROOT / "bin/tp-spawn"), "--check", "--role", role] + (["--workdir", workdir] if workdir else [])
    if lane:  # (name, step, preamble source): the lane's tree is the lane's to use, and its preamble comes from the repository
        command += ["--lane", lane[0], "--lane-step", lane[1]] + (["--preamble-from", lane[2]] if lane[2] else [])
    for spec in contexts:
        command += ["--context", spec]
    command += ["--", "check"]
    run = subprocess.run(command, text=True, capture_output=True)
    if run.returncode:
        raise ValueError(run.stderr.strip() or "tp-spawn could not check the workdir")
    effective = run.stdout.strip()
    if not effective.startswith("/") or "\n" in effective:
        raise ValueError(f"tp-spawn did not report a usable workdir: {run.stdout.strip()!r}")
    return effective


def string_list(value):
    return isinstance(value, list) and all(isinstance(entry, str) for entry in value)


QUEUE_TEXT = ("id", "role", "worker", "model", "thinking", "task")


def queue_item(value, name=None):
    """The one check of a queue item (what dispatch writes to queue/<id>.json). It covers every field any reader uses
    and returns a new dict of just those fields, normalised; launch, capacity, tick, the index and the queue views take
    their data only from this return value. Every field but queue_reason is required, tests included: the default
    scope is applied only where dispatch builds the record from the command line, never to a stored one. `name` is
    the file stem the id must match. ValueError says which field is wrong."""
    if not isinstance(value, dict):
        raise ValueError("the queue entry is not an object")
    for key in QUEUE_TEXT:
        if not isinstance(value.get(key), str) or not value[key]:
            raise ValueError(f"the record has no usable {key}")
    if not IDENT.fullmatch(value["id"]) or (name is not None and value["id"] != name):
        raise ValueError(f"the record id {value['id']!r} is not a valid id matching its file")
    if not IDENT.fullmatch(value["role"]) or not (ROLES / f"{value['role']}.md").is_file():
        raise ValueError(f"the record has an unknown role {value['role']!r}")
    if value["worker"] not in ("pi", "claude"):
        raise ValueError(f"the record has an unknown worker {value['worker']!r}")
    workdir = value.get("workdir")
    if not isinstance(workdir, str) or not workdir.startswith("/"):
        raise ValueError(f"the record has no validated workdir ({workdir!r}); dispatch it again with --workdir")
    if "tests" not in value:
        raise ValueError("the record has no test scope")
    tests = value["tests"]
    if not isinstance(tests, str) or tests not in TESTS_SCOPES:
        raise ValueError(f"the record has an invalid test scope {tests!r}")
    if not isinstance(value.get("route_info"), dict):
        raise ValueError("the record has no route information")
    for key in ("created", "deliverable", "parent"):
        if not isinstance(value.get(key), str):
            raise ValueError(f"the record has no usable {key}")
    for key in ("after", "context", "notes"):
        if not string_list(value.get(key)):
            raise ValueError(f"the record's {key} is not a list of strings")
    if not all(IDENT.fullmatch(parent) for parent in value["after"]):
        raise ValueError("the record's after list holds an invalid task id")
    clean = {key: value[key] for key in QUEUE_TEXT + ("workdir", "route_info", "created", "deliverable", "parent")}
    clean.update({key: list(value[key]) for key in ("after", "context", "notes")}, tests=tests)
    if ("lane" in value) != ("lane_step" in value):
        raise ValueError("the record has a lane without a lane_step, or a lane_step without a lane")
    if "lane" in value:  # a lane task: the lane, its step and where its repository's preamble is read from (all required together)
        if not lanes.valid_lane_name(value["lane"]):
            raise ValueError(f"the record has an invalid lane {value['lane']!r}")
        if not isinstance(value["lane_step"], str) or not lanes.STEP_ID.fullmatch(value["lane_step"]):
            raise ValueError(f"the record has an invalid lane_step {value['lane_step']!r}")
        source = value.get("preamble_from")
        if not isinstance(source, str) or not source.startswith("/") or "\n" in source:
            raise ValueError(f"the record has no usable preamble_from ({source!r}); a lane task reads its repository's preamble from there")
        clean.update(lane=value["lane"], lane_step=value["lane_step"], preamble_from=source)
    if "queue_reason" in value:  # optional (tp-agent's own note, only displayed), but a present value must be text
        if not isinstance(value["queue_reason"], str):
            raise ValueError("the record's queue_reason is not text")
        clean["queue_reason"] = value["queue_reason"]
    return clean


def read_queue_file(path):
    """The decoded content of a queue file. The entry is lstat'ed first and anything that is not a regular file
    (a symlink, readable or dangling, a FIFO, socket, device, directory) is refused unopened, so it can neither block
    a reader nor be followed to a record elsewhere."""
    try:
        if not stat.S_ISREG(path.lstat().st_mode):
            raise ValueError("it is not a regular file")
        return json.loads(path.read_text())
    except (OSError, ValueError, RecursionError) as error:
        raise ValueError(f"cannot read {path.name} ({error})")


def queue_files(base):
    """The queue entries, oldest first. Every *.json name is an entry, a dangling symlink or a directory included
    (queue_entry refuses it with a reason); only one that vanishes while listing is skipped."""
    found = []
    for path in (base / "queue").glob("*.json"):
        try:
            found.append((path.lstat().st_mtime, path))
        except OSError:
            continue
    return [path for _, path in sorted(found)]


def queue_entry(path):
    """(raw, item, reason) for one queue file. raw is the decoded content (None if unreadable); item is queue_item's
    return value, or None with reason 'start refused: why'. The one way any reader gets an item from a file."""
    raw = None
    try:
        raw = read_queue_file(path)
        return raw, queue_item(raw, path.stem), ""
    except ValueError as error:
        return raw, None, f"start refused: {error}"


def printable(text):
    return re.sub(r"[\x00-\x1f\x7f]", "?", str(text))


def queue_view(base):
    """One display line per queue entry, for tp-list and tp-status. A refused entry shows its file name and why;
    it is never shown as an ordinary queued task."""
    lines = []
    for path in queue_files(base):
        _, item, reason = queue_entry(path)
        lines.append(printable(f"  {path.stem}  queued  {reason}") if item is None else
                     printable(f"  {item['id']}  {item['role']}  queued  {item.get('queue_reason', '')}"))
    return lines


class RecordError(ValueError):
    def __init__(self, message, missing=False):
        super().__init__(message)
        self.missing = missing


def dispatch_record(previous):
    """The one check of a task's dispatch.json (what launch writes). Covers every field a reader uses and returns
    {"context", "omitted_context", "notes", "tests"}; tests is None only in an older record that predates the field.
    Retry's replay and its recorded test scope take their data only from this return value. RecordError otherwise;
    omitted_context is optional (older records lack it) but a list of strings when present."""
    path = previous / "dispatch.json"
    try:
        kept = json.loads(path.read_text())
    except FileNotFoundError:
        raise RecordError(f"cannot read the prior dispatch record {path} (no such file)", missing=True)
    except (OSError, ValueError) as error:
        raise RecordError(f"cannot read the prior dispatch record {path} ({error})")
    if not isinstance(kept, dict):
        raise RecordError(f"the prior dispatch record {path} is malformed (not an object)")
    for key in ("context", "notes") + (("omitted_context",) if "omitted_context" in kept else ()):
        if not string_list(kept[key] if key in kept else None):
            raise RecordError(f"the prior dispatch record {path} is malformed ({key} is not a list of strings)")
    tests = kept.get("tests")
    if "tests" in kept and (not isinstance(tests, str) or tests not in TESTS_SCOPES):
        raise RecordError(f"the prior dispatch record {path} has an invalid test scope {tests!r}")
    return {"context": list(kept["context"]), "omitted_context": list(kept.get("omitted_context", [])),
            "notes": list(kept["notes"]), "tests": tests}


def lane_tags(meta):
    """The lane tags of a prior task's meta.json for retry: None when it has none, else {lane, lane_step, preamble_from, workdir}.
    A retry stays in the lane and step of the attempt it replaces and takes them from nowhere else; tags that are half there,
    or not text, refuse."""
    if "lane" not in meta and "lane_step" not in meta:
        return None
    tags = {key: meta.get(key) for key in ("lane", "lane_step", "preamble_from", "workdir")}
    if not all(isinstance(value, str) and value for value in tags.values()):
        raise ValueError("the prior task records an incomplete lane (lane, lane_step, preamble_from and workdir must all be text); "
                         "it cannot be retried into its lane. Start a new task instead: tp-agent dispatch --lane NAME --step ID ...")
    return tags


def prior_dispatch(previous):
    """(record, None) from dispatch_record, or (None, the RecordError)."""
    try:
        return dispatch_record(previous), None
    except RecordError as error:
        return None, error


LANE_FLAGS = (("step", "--step"), ("domain", "--domain"), ("touches", "--touches"), ("repo", "--repo"), ("base", "--base"))


def lane_plan(args, base, tests):
    """Checks 1-14 of `dispatch --lane` (design 3.1), in their order and without taking a lock: everything that can refuse
    before a task is routed. Returns what the locked part needs. A retry (args.lane_meta, the prior task's own lane tags)
    skips only the checks about flags it cannot have. Creating a lane is left to the locked part."""
    retry = getattr(args, "lane_meta", None)
    name, step = (retry["lane"], retry["lane_step"]) if retry else (args.lane, getattr(args, "step", None))
    lane_commands.check_lane_name(name)  # 1
    if step is not None and not lanes.STEP_ID.fullmatch(step):  # 2
        raise ValueError(f"invalid step id {step!r}: use up to 40 characters of letters, digits, . _ -")
    if not step:  # 3
        raise ValueError(f"dispatch --lane {name} needs --step ID, the slice this task belongs to")
    if getattr(args, "workdir", None) and not retry:  # 4
        raise ValueError("--lane chooses the working tree; remove --workdir")
    if tests == "full":  # 5
        raise ValueError("lane tasks run the tests that check their change: pass --tests affected or --tests none. The whole suite "
                         "is run once, from the main checkout, when the lanes are integrated (tp-agent integrate ships in a later slice; "
                         "until then run it there yourself)")
    if retry:
        directory = retry["preamble_from"]
    elif getattr(args, "repo", None):
        directory = os.path.abspath(args.repo)
    else:  # the repository of the main pane's directory, as tp-spawn --check reports it
        directory = check_workdir(args.role, None, (), (name, step, None))
    try:
        common, repo = lane_commands._main_repo(directory)
    except ValueError as error:
        raise ValueError(f"cannot find a git repository for lane {name} from {directory} ({error})")
    machine = lanes.load_machine_config()  # 6: absent keys default, malformed ones refuse naming key and file
    repo_config = lanes.load_repo_config(repo)
    plan = {"name": name, "step": step, "common": common, "repo": repo, "machine": machine, "repo_config": repo_config,
            "preamble_from": repo}
    if name in lanes.lane_names(common):
        record = lanes.read_lane(common, name)  # 7
        if not retry:
            lane_declaration_check(record, args)  # 10
        lane_use_checks(record)  # 11, 12
        lane_steps.next_step_checks(lane_steps.Session(base), record, step)  # 15, 16, 17
        if retry and os.path.realpath(retry["workdir"]) != record["worktree"]:
            raise ValueError(f"the task being retried ran in {retry['workdir']}, which is not lane {name}'s working tree "
                             f"{record['worktree']}; start a new task with --lane {name} instead")
        plan.update(exists=True, route_workdir=record["worktree"])
        return plan
    if retry:
        raise ValueError(f"lane {name} has no record, so a task of it cannot be retried; its record would be in {lanes.lanes_dir(common)}. "
                         f"Start the lane again: tp-agent dispatch --lane {name} --step ID --domain TEXT --touches PATH ...")
    lanes.precheck_lane_slot(common, repo_config, name)  # 8 (and an existing branch)
    if not getattr(args, "domain", None) or not getattr(args, "touches", None):  # 9
        raise ValueError(f"lane {name} does not exist; pass --domain TEXT and --touches PATH [PATH ...] to create it")
    lanes.check_lane_capacity(common, machine["max_active_lanes"])  # 13
    touches = lane_commands.validate_declaration(repo_config, name, args.domain, args.touches)  # 14
    base_ref, base_commit = lane_commands._resolve_base(repo, getattr(args, "base", None), repo_config["integration_branch"])
    plan.update(exists=False, route_workdir=repo, domain=args.domain, touches=touches, base_ref=base_ref, base_commit=base_commit)
    return plan


def lane_declaration_check(record, args):
    """Check 10: a lane that has a record takes no declaration flags. --repo is allowed: it only locates the lane (the
    record was found in that repository), which a main pane in another repository needs."""
    if any(getattr(args, attr, None) for attr in ("domain", "touches", "base")):
        raise ValueError(f"lane {record['name']} already exists (domain: {record['domain']}); its declaration is set when it is created")


def lane_use_checks(record):
    """Checks 11 and 12 for a lane that has a record: it is open, and git agrees with the record."""
    lane_steps.lane_use_checks(record)


def lane_admit(base, plan, item):
    """With .tp-agent.lock held: the lane's record (created now when it has none) and the one-writer look (checks 18 and 19)
    under the lane lock, then start or queue the task. The lane lock is NOT held while the task starts: tp-spawn takes the
    lane's reservation (lane_lease.reserve, under that same lock) and is the authority, so a start that loses a race to another
    session or to a reviewer refuses there. Returns (value, record, created, warnings). A lane this call created is undone
    again when the task could not be started or queued and nothing else holds the lane; nothing is undone once it has."""
    name, common = plan["name"], plan["common"]
    created = False
    with lanes.lane_lock(common):
        if name in lanes.lane_names(common):
            record = lanes.read_lane(common, name)  # 7 again, under the lock
            lane_use_checks(record)  # 11, 12 again; the flag check (10) needs no lock
            lane_steps.next_step_checks(lane_steps.Session(base), record, plan["step"])  # 15, 16, 17 again
            warnings = lane_commands._warnings(name, record["domain"], record["touches"], [lanes.read_lane(common, n) for n in lanes.lane_names(common)])
        else:
            if not plan.get("domain"):
                raise ValueError(f"lane {name} has no record any more; dispatch again")
            record, warnings = lane_commands.create_lane_locked(common, plan["repo"], name, plan["domain"], plan["touches"], plan["base_ref"],
                                                               plan["base_commit"], plan["machine"], plan["repo_config"])
            created = True
        try:
            holders = lane_holders(base, name, record["worktree"], item["role"])  # 18; 19 is the refusals worker_process raises
            if holders:
                raise ValueError(lane_refusal(name, holders))
        except BaseException:
            if created:
                lane_commands.undo_created_lane(record)  # nothing could hold a lane made a moment ago; raises if it cannot be undone
            raise
    started = False
    try:
        item = queue_item(dict(item, workdir=record["worktree"], lane=name, lane_step=plan["step"], preamble_from=plan["preamble_from"]))
        ok, reason = capacity(base, item)
        if ok:
            value = launch(base, item)
        else:
            item["queue_reason"] = reason
            atomic_json(base / "queue" / f"{item['id']}.json", item, base)
            value = {"id": item["id"], "status": "queued", "reason": reason, "role": item["role"],
                     "harness": item["worker"], "model": item["model"], "effort": item["thinking"]}
        started = True
    except BaseException as error:
        if created and not started:
            try:
                with lanes.lane_lock(common):
                    if lane_lease.live(lane_lease.read(common, name)):
                        raise ValueError(f"another task holds lane {name} now, so the lane is kept")
                    lane_commands.undo_created_lane(record)
            except ValueError as left:
                raise ValueError(f"{error}. The lane {name} created for it was not removed again: {left}")
        raise
    return dict(value, lane=name, lane_step=plan["step"], lane_created=created), record, warnings


def dispatch(args, base):
    if not (ROLES / f"{args.role}.md").is_file():
        raise ValueError(f"unknown role: {args.role}")
    # Autonomy's recovery gate comes before anything is written: a refused dispatch creates no lane, branch, worktree or queue entry.
    # (A dispatch is never a review, so the lane and the deliverable change nothing: while recovery is pending all of them wait.)
    retry = getattr(args, "lane_meta", None)
    refusal = autonomy.gate(base, role=args.role, deliverable=args.deliverable or "", parent=args.parent or "",
                            lane=(retry["lane"] if retry else getattr(args, "lane", None)) or "")
    if refusal:
        raise ValueError(refusal)
    tests = getattr(args, "tests", None)
    if tests is None:  # a caller that never sets the field (not a read value) gets the dispatch default
        tests = TESTS_DEFAULT
    if tests not in TESTS_SCOPES:
        raise ValueError(f"--tests must be one of {', '.join(TESTS_SCOPES)}")
    plan = warnings = None
    if getattr(args, "lane", None) is None and not getattr(args, "lane_meta", None):
        for attr, flag in LANE_FLAGS:
            if getattr(args, attr, None):
                raise ValueError(f"{flag} needs --lane")
        if args.workdir and args.workdir.startswith("/"):
            lanes.refuse_lane_tree(args.workdir)  # the lane's tree is the lane's to use: no way around its one writer
    else:
        plan = lane_plan(args, base, tests)
    # Refuse before routing or queueing. tp-spawn resolves the effective workdir (the explicit one, else the main
    # pane's) exactly as it will when it builds the packet, so both dispatch forms are checked the same way.
    # The canonical directory it reports is what the task stores, routing reads and launch passes back, so a queued
    # task cannot start in a different repository than the one validated here.
    if plan:  # a lane's tree, or for a lane not created yet the repository's, which has the same preamble and files
        workdir = check_workdir(args.role, plan["route_workdir"], args.context or [], (plan["name"], plan["step"], plan["preamble_from"]))
    else:
        workdir = check_workdir(args.role, args.workdir, args.context or [])
        if not args.workdir:  # recheck the resolved directory the way launch will pass it (an explicit --workdir)
            workdir = check_workdir(args.role, workdir)
        warnings = lanes.refuse_lane_tree(workdir)  # a lane's tree refuses; a hand-made linked worktree only warns
    chosen = getattr(args, "preroute", None) or route(
        args.task, args.role, args.worker, args.model, args.thinking, args.context or [], args.deliverable,
        level=getattr(args, "level", None), approve_effort=getattr(args, "approve_effort", False),
        local_only=getattr(args, "local_only", False), workdir=workdir, base=base)
    worker, model, thinking, info = chosen
    item = queue_item({"id": f"{args.role}-{uuid4().hex[:10]}", "created": now(), "role": args.role,
            "task": args.task, "workdir": workdir, "worker": worker, "model": model,
            "thinking": thinking, "route_info": info, "deliverable": args.deliverable or "",
            "parent": args.parent or "", "after": args.after or [], "context": args.context or [],
            "notes": args.note or [], "tests": tests})
    if plan:
        with locked(base):
            value, _, warnings = lane_admit(base, plan, item)
            write_index(base)
    else:
        with locked(base):
            ok, reason = capacity(base, item)
            if ok:
                value = launch(base, item)
            else:
                item["queue_reason"] = reason
                atomic_json(base / "queue" / f"{item['id']}.json", item, base)
                value = {"id": item["id"], "status": "queued", "reason": reason, "role": item["role"],
                         "harness": worker, "model": model, "effort": thinking}
            write_index(base)
    if warnings:
        value = dict(value, warnings=warnings)
        for warning in warnings:
            print(lane_commands.warning_text(warning), file=sys.stderr)
    return value


def note_queue_reason(path, raw, reason):
    """Leave the entry queued with why it did not start. Only an object can carry a reason; an unreadable or
    non-object entry is never rewritten (that would destroy it) and is reported in tick's output instead."""
    if isinstance(raw, dict) and raw.get("queue_reason") != reason:
        try:
            atomic_json(path, dict(raw, queue_reason=reason), path.parent.parent)
        except OSError:
            pass


def tick(base):
    started, refused = [], []
    with locked(base):
        for path in queue_files(base):
            raw, item, reason = queue_entry(path)
            if item is None:
                note_queue_reason(path, raw, reason)
                refused.append({"id": path.stem, "reason": reason})
                continue
            try:
                ok, why = capacity(base, item)
                if not ok:
                    if isinstance(raw, dict) and "queue_reason" in raw:  # an entry that carries a reason says why it waits now,
                        note_queue_reason(path, raw, why)             # not what an earlier tick or failed start said
                    continue
                started.append(launch(base, item)["id"])
                path.unlink()
            except (ValueError, RuntimeError, OSError) as error:
                reason = f"start failed: {error}"
                note_queue_reason(path, raw, reason)
                refused.append({"id": item["id"], "reason": reason})
        write_index(base)
    return {"started": started, "refused": refused}


def discover_context(task, workdir=None):
    """Return {contexts, reasons, skipped} for dispatch --context; tp-spawn still caps and screens every
    spec. skipped lists paths named in the task that were refused unread, each with its reason."""
    root = Path(workdir or os.getcwd()).resolve()
    if not root.is_dir():
        raise ValueError(f"workdir is not a directory: {root}")
    if not task.strip():
        raise ValueError("context needs a task")
    sys.path.insert(0, str(ROOT / "lib"))
    from context_broker import context_reasons, select_context
    out = select_context(task, root)
    return {"contexts": out["contexts"], "reasons": context_reasons(out["manifest"]), "skipped": out["skipped"]}


def review(base, args):
    """Run bin/tp-review for a finished task. The reviewer is chosen by the resolver (lib/model_router.review_plan):
    never the author's provider when another is available."""
    command = [str(ROOT / "bin/tp-review")] + (["--force"] if args.force else []) + (["--force-alive"] if args.force_alive else [])
    for flag, value in (("--level", args.level), ("--thinking", args.thinking)):
        if value:
            command += [flag, value]
    if args.approve_effort:
        command.append("--approve-effort")
    run = subprocess.run(command + [args.id], text=True, capture_output=True, env={**os.environ, "TP_STATE_DIR": str(base)})
    if run.returncode == 3:
        return {"id": args.id, "review": None, "status": "not_needed", "reason": run.stderr.strip()}
    if run.returncode:
        raise RuntimeError(run.stderr.strip() or "tp-review failed")
    value = {"id": args.id, "review": run.stdout.strip().splitlines()[-1], "status": "started"}
    write_index(base)
    return value


def investigate(base, args):
    """tp-agent dispatch --investigate-failure TASK_ID (T12): a tester on the failing tests a task reported as not its own,
    in a clean worktree at the commit the task started from, with the task's diff. Every refusal names a command that clears it."""
    ident = args.investigate_failure
    # The recovery gate comes before the investigation folder, the diff and the clean worktree (git) are written: dispatch() below asks
    # the same question, but only after those exist.
    refusal = autonomy.gate(base, role="tester", deliverable=args.deliverable or "investigation.md", parent=ident)
    if refusal:
        raise ValueError(refusal)
    if not IDENT.fullmatch(ident) or not ((base / "tasks" / ident / "meta.json").is_file() or find_archived_task(base, ident)):
        raise ValueError(f"unknown task: {ident}; list the tasks with: tp-agent list")
    path = base / "tasks" / ident if (base / "tasks" / ident / "meta.json").is_file() else find_archived_task(base, ident)
    reported = failing_tests.read(path)
    if args.failing_test:  # the main agent names the test itself, when the worker's report has no block
        reported = {"entries": [{"test": text} for text in args.failing_test], "text": "\n".join(f"- test: {text}" for text in args.failing_test),
                    "malformed": [], "source": "--failing-test"}
    if not reported:
        raise ValueError(f"{ident} reports no failing tests (no FAILING_TESTS: block in its report.md or result.md). To investigate a "
                         f"failure you saw in its output, name the test: tp-agent dispatch --investigate-failure {ident} "
                         "--failing-test 'TEST NAME and the command that fails'")
    workdir = read_json(path / "meta.json").get("workdir")
    if not workdir or not Path(workdir).is_dir():
        raise ValueError(f"{ident}'s working directory is gone ({workdir}); see what it reported with: tp-agent inspect {ident}")
    base_commit = args.base or read_json(path / "dispatch.json").get("base_commit")
    if not base_commit:
        raise ValueError(f"{ident} did not record the commit it started from. Name one: tp-agent dispatch --investigate-failure "
                         f"{ident} --base COMMIT (git -C {workdir} log --oneline shows the candidates)")
    for other in (base / "tasks").iterdir() if (base / "tasks").is_dir() else ():  # an open investigation of the same task: said, not refused
        if read_json(other / "dispatch.json").get("investigates") == ident and record(other)["status"] not in {"completed", "failed", "stopped"}:
            print(f"tp-agent: note: {other.name} already investigates {ident}'s failing tests; this starts another", file=sys.stderr)
    patch = failing_tests.diff_of(workdir, base_commit)  # git errors (an unknown commit) surface as the ValueError they are
    moved = failing_tests.moved_commits(workdir, base_commit)
    folder = base / "investigations" / f"{ident}-{uuid4().hex[:6]}"
    safe_write.ensure_dir(folder.parent, what="investigations directory", root=base)
    folder.mkdir()
    safe_write.write_atomic(folder / "failing-tests.md", reported["text"] + "\n", root=base)
    safe_write.write_atomic(folder / "diff.patch", patch, root=base)
    top = Path(failing_tests.repo_top(workdir))  # beside the repository, as a lane's worktree is: tp-spawn refuses a workdir inside the state directory
    tree = failing_tests.clean_worktree(workdir, base_commit, top.parent / f"{top.name}-investigate-{folder.name}")
    replacement = argparse.Namespace(
        role="tester", worker=args.worker, model=args.model, thinking=args.thinking, level=args.level,
        approve_effort=args.approve_effort, local_only=args.local_only, workdir=tree, deliverable=args.deliverable or "investigation.md",
        parent=ident, after=[], context=[], tests="affected", note=[], lane=None, preroute=None,
        task=failing_tests.task_text(ident, reported["text"], base_commit, workdir, tree, folder / "diff.patch", patch.count("\n"), moved))
    try:
        value = dispatch(replacement, base)
    except BaseException:
        failing_tests.remove_worktree(workdir, tree)  # nothing is left behind when the investigator cannot start
        raise
    if value.get("id") and (base / "tasks" / value["id"]).is_dir():
        atomic_json(base / "tasks" / value["id"] / "dispatch.json", dict(read_json(base / "tasks" / value["id"] / "dispatch.json"), investigates=ident),
                    base)
    return dict(value, investigates=ident, worktree=tree, diff=str(folder / "diff.patch"), base_commit=base_commit,
                patch_note=failing_tests.PATCH_NOTE.format(workdir=workdir) + (f" HEAD has moved since the task started: {len(moved)} commit(s)." if moved else ""),
                cleanup=f"git -C {workdir} worktree remove --force {tree}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    d = sub.add_parser("dispatch", help="route and start or queue a role task")
    d.add_argument("--role")
    d.add_argument("--task")
    d.add_argument("--worker", choices=["pi", "claude"], help="require this harness; the router still picks the model")
    d.add_argument("--model", help="explicit model (skips the router)")
    d.add_argument("--thinking", help="explicit effort; above high needs --approve-effort")
    d.add_argument("--level", help="explicit catalog level key, e.g. top (skips the router)")
    d.add_argument("--approve-effort", action="store_true",
                   help="record that the user approved an effort above high for this task")
    d.add_argument("--local-only", action="store_true", help="private work: local router and local model, or stop and ask")
    d.add_argument("--workdir")
    d.add_argument("--deliverable", default="")
    d.add_argument("--parent")
    d.add_argument("--after", action="append", default=[])
    d.add_argument("--context", action="append", default=[])
    d.add_argument("--note", action="append", default=[])
    d.add_argument("--tests", choices=TESTS_SCOPES, default=TESTS_DEFAULT,
                   help="how much of the test suite the worker runs: affected (default) = the tests that check "
                        "what it changed, full = everything, none")
    d.add_argument("--lane", help="run the task in this lane's worktree (T10); the lane is created on first use")
    d.add_argument("--step", help="with --lane: the slice this task belongs to")
    d.add_argument("--domain", help="with --lane, creating it: the independence claim in words")
    d.add_argument("--touches", nargs="+", metavar="PATH", help="with --lane, creating it: repo-relative path prefixes the lane will change")
    d.add_argument("--repo", help="with --lane, creating it: the repository (default: the main pane's)")
    d.add_argument("--base", help="with --lane, creating it: branch or commit to start from (default: the integration branch); "
                                  "with --investigate-failure: the commit to check out clean (default: the one the task started from)")
    d.add_argument("--investigate-failure", metavar="TASK_ID",
                   help="start a tester on the failing tests TASK_ID reported as not its own (its FAILING_TESTS: block), with that task's "
                        "diff and a clean worktree at the commit it started from")
    d.add_argument("--failing-test", action="append", default=[], metavar="TEXT",
                   help="with --investigate-failure: name the failing test and command yourself, when the report has no block")
    retry = sub.add_parser("retry", help="start a linked attempt with a recorded reason")
    retry.add_argument("id")
    retry.add_argument("--reason", required=True)
    retry.add_argument("--task")
    retry.add_argument("--role")
    retry.add_argument("--worker", choices=["pi", "claude"])
    retry.add_argument("--model")
    retry.add_argument("--thinking")
    retry.add_argument("--level", help="explicit catalog level key")
    retry.add_argument("--approve-effort", action="store_true", help="record the user's approval of an effort above high")
    retry.add_argument("--local-only", action="store_true")
    retry.add_argument("--tests", choices=TESTS_SCOPES, help="test scope; default is the prior attempt's")
    retry.add_argument("--force-alive", action="store_true",
                       help="start the attempt although a process is still alive on the same working tree (skips only the retry guard; a lane's one writer is still enforced: stop the writer instead)")
    retry.add_argument("--escalate", action="store_true",
                       help="after two failed attempts or two REQUEST_CHANGES: effort up, then level up (never above high unapproved)")
    rv = sub.add_parser("review", help="start an independent reviewer for a finished task (a different provider from the author)")
    rv.add_argument("id")
    rv.add_argument("--force", action="store_true", help="review even when the policy says none")
    rv.add_argument("--level", help="explicit reviewer level key")
    rv.add_argument("--thinking", help="explicit reviewer effort")
    rv.add_argument("--approve-effort", action="store_true", help="record the user's approval of an effort above high")
    rv.add_argument("--force-alive", action="store_true", help="review although a writer is still alive on the same working tree (does not apply to a lane: stop its writer with tp-agent stop)")
    ea = sub.add_parser("end-author", help="end a settled task's process before its review starts (bin/tp-review runs this)")
    ea.add_argument("id")
    gr = sub.add_parser("guard-review", help="refuse while a writer is alive on the task's working tree (bin/tp-review runs this)")
    gr.add_argument("id")
    gr.add_argument("--force-alive", action="store_true")
    rp = sub.add_parser("reap", help="list finished tasks whose process is still alive; --yes ends them")
    rp.add_argument("ids", nargs="*")
    rp.add_argument("--yes", action="store_true", help="confirm: end the listed processes")
    for name in ("list", "tick"):
        sub.add_parser(name)
    # Read-only text lines for the shell views (tp-list, tp-status); the validator stays the only reader.
    sub.add_parser("queue-view")
    # --no-tick: write and print the index without launching queued work.
    ix = sub.add_parser("index")
    ix.add_argument("--no-tick", action="store_true")
    ix.add_argument("--no-write", action="store_true", help="print the index without writing session-index.json (implies --no-tick: nothing is launched or rewritten)")
    ix.add_argument("--bounded", action="store_true",
                    help="print the open decisions as the bounded summary (counts, top ids, the command), not the full list; "
                         "session-index.json still has the full list")
    for name in ("inspect", "collect", "stop"):
        sub.add_parser(name).add_argument("id")
    m = sub.add_parser("message")
    m.add_argument("id")
    m.add_argument("--text", required=True)
    o = sub.add_parser("objective")
    o.add_argument("text")
    q = sub.add_parser("request", help="worker asks main for a skill, tool, or context")
    q.add_argument("--kind", choices=["skill", "tool", "context"], required=True)
    q.add_argument("--what", required=True)
    q.add_argument("--reason", required=True)
    c = sub.add_parser("context", help="suggest context specs for a task; prints contexts and reasons")
    c.add_argument("--task", required=True)
    c.add_argument("--workdir")
    ln = sub.add_parser("lane", help="lane commands (T10)").add_subparsers(dest="lane_command", required=True)
    lc = ln.add_parser("create", help="create a lane: a branch, a worktree and a record; nothing is left behind on failure")
    lc.add_argument("name")
    lc.add_argument("--domain", required=True, help="the independence claim in words")
    lc.add_argument("--touches", nargs="+", required=True, metavar="PATH", help="repo-relative path prefixes the lane will change")
    lc.add_argument("--repo", default=".", help="the repository (default: the current directory)")
    lc.add_argument("--base", help="branch or commit to start from (default: the repository's integration branch, lane/integrate unless configured)")
    lcl = ln.add_parser("close", help="record that a step is finished: its review approved the committed work (lane close NAME STEP)")
    lcl.add_argument("name")
    lcl.add_argument("step")
    lcl.add_argument("--repo", default=".", help="the repository (default: the current directory)")
    lr = ln.add_parser("remove", help="remove an integrated lane (or, with --abandon, an open one): worktree, branch; the record is archived")
    lr.add_argument("name")
    lr.add_argument("--abandon", action="store_true", help="remove an open lane whose work is not integrated; its tip is printed first so the branch can be restored")
    lr.add_argument("--repo", default=".", help="the repository (default: the current directory)")
    ls = sub.add_parser("lanes", help="list the repository's lanes and unrecorded worktrees (read-only)")
    ls.add_argument("name", nargs="?")
    ls.add_argument("--repo", default=".")
    work_commands.add_parsers(sub)
    au = sub.add_parser("autonomy", help="opt in to autonomous protection: while recovery is pending no new worker starts (Claude main only)").add_subparsers(
        dest="autonomy_command", required=True)
    on = au.add_parser("on", help="turn it on for this run and arm recovery-pending (clear it once with: work recovered)")
    on.add_argument("--workspace", required=True, help="the workspace this run works in; it is attached to the run")
    on.add_argument("--reason", default="")
    off = au.add_parser("off", help="turn it off (a user action; running workers are not touched)")
    off.add_argument("--reason", default="")
    au.add_parser("status", help="on or off, the recovery state, and what is blocked since when")
    fd = sub.add_parser("find", help="search workspaces, notes, decisions and the archived tasks of earlier sessions (read-only; ~160-char snippets)")
    fd.add_argument("terms", nargs="*", help="all must match (case-insensitive substring); none means filters only")
    fd.add_argument("--kind", choices=list(work_find.KINDS), help="workspace|note|decision|task|session|shared (a read-only shared clone; only when shared.search is on in config/work.local.json); default: all of them")
    fd.add_argument("--ticket")
    fd.add_argument("--tag")
    fd.add_argument("--status")
    fd.add_argument("--workspace", help="only this workspace, its linked notes, and decisions")
    fd.add_argument("--since", metavar="YYYY-MM-DD")
    fd.add_argument("--all", action="store_true", help="include archived and superseded workspaces and notes")
    fd.add_argument("--limit", type=int, default=20)
    fd.add_argument("--json", action="store_true")
    args = parser.parse_args()
    # The output boundary for the whole `find` and `work` family: every subcommand, every exception type, stdout, stderr and JSON
    # go through work_find.bounded, which relabels configured roots and redacts the complete output once before it is printed.
    if args.command == "find":
        sys.exit(work_find.bounded(lambda: run_find(args)))
    if args.command == "work":
        sys.exit(work_find.bounded(lambda: run_work(args)))
    if args.command in ("lane", "lanes"):
        # Lanes live in the repository's git directory, not in a session. Creating or listing one needs no session; the steps
        # of a lane (lane close, and the open_step / queued / waiting_on of a row) are read from this session's tasks.
        if args.command == "lanes":
            try:
                session = lane_steps.Session(state_dir())
            except (ValueError, OSError, subprocess.CalledProcessError) as error:
                session = None
                print(f"tp-agent: warning: no session state directory ({error}), so open_step, queued and waiting_on are not shown; "
                      "run this from the workspace (tp), or with TP_STATE_DIR set", file=sys.stderr)
            print(json.dumps(lane_commands.list_lanes(args.repo, args.name, steps=session and (lambda record: lane_steps.row_fields(session, record))), indent=2))
            return
        if args.lane_command == "close":
            try:
                state = state_dir()
            except (OSError, subprocess.CalledProcessError) as error:
                raise ValueError("no tmux-pi state directory; start a workspace with tp, or set TP_STATE_DIR") from error
            common, _ = lane_commands._main_repo(args.repo)
            print(json.dumps(lane_steps.close_step(state, common, args.name, args.step), indent=2))
            return
        if args.lane_command == "remove":
            try:
                state = state_dir()
            except (OSError, subprocess.CalledProcessError) as error:
                raise ValueError("no tmux-pi state directory (queued work cannot be ruled out without it); start a workspace with tp, or set TP_STATE_DIR") from error
            print(json.dumps(lane_remove.remove_lane(state, args.repo, args.name, args.abandon), indent=2))
            return
        value = lane_commands.create_lane(args.repo, args.name, args.domain, args.touches, args.base)
        for warning in value["warnings"]:
            print(lane_commands.warning_text(warning), file=sys.stderr)
        print(json.dumps(value, indent=2))
        return
    if args.command == "autonomy":
        print(json.dumps(run_autonomy(args), indent=2))
        return
    if args.command == "context":
        # Read-only suggestion: needs no session state and writes no manifest or log.
        print(json.dumps(discover_context(args.task, args.workdir), indent=2))
        return
    base = state_dir()
    if args.command == "queue-view":
        for line in queue_view(base):
            print(line)
        return
    if args.command == "dispatch" and args.investigate_failure:
        value = investigate(base, args)
        write_index(base)
    elif args.command == "dispatch":
        if not (args.role and args.task):
            parser.error("the following arguments are required: " + ", ".join(f for f, v in (("--role", args.role), ("--task", args.task)) if not v))
        value = dispatch(args, base)
    elif args.command == "retry":
        if not args.reason.strip():
            raise ValueError("retry reason must describe what changed")
        previous = task_dir(base, args.id)
        meta = read_json(previous / "meta.json")
        prior = record(previous)
        if prior["status"] in {"starting", "working", "needs_input"}:
            wait = "Wait for it to settle, or end it" if finishes_alone(prior["status"]) else "It will not settle by itself: end it"
            raise ValueError(f"{args.id} is still {state_words(prior['status'])}, so it cannot be retried yet. "
                             f"{wait} with {' or '.join(clear_commands(prior['status'], args.id))}, then retry")
        if not args.force_alive:
            guard_retry(previous)
        original = (previous / "request.md").read_text().strip()
        # Replay only admitted context and notes; spawn re-applies the sensitive-read omission. Skip
        # prior retry notes (rebuilt below) and dependencies (stale; the prior packet records them).
        kept, problem = prior_dispatch(previous)
        contexts, notes, remark = replay_inputs(previous, kept, problem)
        if args.tests:
            tests = args.tests
        elif kept is None:
            raise ValueError(f"{problem}; the prior attempt's test scope is unknown, pass --tests")
        else:
            tests = kept["tests"] or TESTS_DEFAULT  # None only in an older valid record
        lane_meta = lane_tags(meta)
        preroute = None
        if args.escalate:
            if args.model or args.level or args.thinking:
                raise ValueError("--escalate chooses the next step itself; use --level to request a level instead")
            preroute = escalation_route(base, previous, args, contexts)
        replacement = argparse.Namespace(role=args.role or meta.get("role", "coder"),
                                         task=args.task or original, worker=args.worker,
                                         model=args.model, thinking=args.thinking, level=args.level,
                                         approve_effort=args.approve_effort, preroute=preroute,
                                         local_only=args.local_only or bool((meta.get("route_info") or {}).get("local_only")),
                                         workdir=meta.get("workdir"), lane_meta=lane_meta,
                                         deliverable=meta.get("deliverable", ""),
                                         parent=args.id, after=[], context=contexts,
                                         tests=tests,
                                         note=notes + [f"Retry of {args.id}: {args.reason}. Prior task: {previous}. Prior packet: {previous / 'packet.md'} (original constraints and dependency pointers; re-read as needed). Prior result: {prior['result_path'] or 'none'}. Preserve and inspect partial work before claiming completion. Capability requests and sensitive context from the prior attempt are not re-granted."
                                                      + (f" {remark}; see the prior packet." if remark else "")])
        value = dispatch(replacement, base)
        if problem is not None:  # reachable only through an explicit --tests
            value = dict(value, prior_record=f"not used: {problem}")
    elif args.command == "reap":
        value = reap(base, args)
    elif args.command == "end-author":
        value = {"id": args.id, "process": end_or_refuse(task_dir(base, args.id))}
    elif args.command == "guard-review":
        if not args.force_alive:
            guard_review(task_dir(base, args.id))
        value = {"id": args.id, "guard": "clear"}
    elif args.command == "review":
        task_dir(base, args.id)
        value = review(base, args)
    elif args.command == "tick":
        value = tick(base)
    elif args.command == "index":
        if not args.no_tick and not args.no_write:  # tick launches queued work and rewrites the index: --no-write is a pure read
            tick(base)
        value = build_index(base) if args.no_write else write_index(base)
        if args.bounded:
            value = work_index.bounded(value)
    elif args.command == "list":
        value = all_records(base)
    elif args.command == "objective":
        atomic_text(base / "session-objective.md", args.text.strip() + "\n", base)
        value = write_index(base)
    elif args.command == "request":
        own = os.getenv("TP_TASK_DIR")
        if not own:
            raise ValueError("request is only available inside a worker task")
        path = Path(own)
        try:  # tasks/ and the task directory are looked at themselves, never resolved: a link at either is refused
            rel = safe_write.check_below(base, path, "worker task directory")
        except ValueError:
            rel = None
        if rel is None or Path(rel).parts != ("tasks", path.name) or not (path / "meta.json").is_file():
            raise ValueError("invalid worker task directory")
        value = {"kind": args.kind, "what": args.what, "reason": args.reason,
                 "status": "pending", "requested": now()}
        atomic_json(path / "capability-request.json", value, base)
        write_index(base)
        refreshed(base, path.name, value)
    elif args.command in {"inspect", "collect", "stop", "message"}:
        queued = base / "queue" / f"{args.id}.json"
        if args.command == "stop" and IDENT.fullmatch(args.id) and (queued.is_symlink() or queued.exists()):
            if queued.is_dir() and not queued.is_symlink():
                queued.rmdir()  # an empty directory named like an entry; a full one refuses (OSError)
            else:
                queued.unlink()
            value = {"id": args.id, "status": "stopped"}
            write_index(base)
            print(json.dumps(value, indent=2))
            return
        path = task_dir(base, args.id)
        if args.command == "inspect":
            value = record(path, include_result=True)
            if value.get("review_notice"):
                value = {"notice": value["review_notice"], **value}
        elif args.command == "collect":
            value = record(path, include_result=True)
            if value.get("review_notice"):
                value = {"notice": value["review_notice"], **value}  # first key, so a reader sees it at once
                print(value["notice"], file=sys.stderr)
            if value.get("failing_tests"):
                print(failing_tests.notice(args.id, value["failing_tests"]), file=sys.stderr)
            if value["status"] in {"settled", "completed"}:
                # The process is ended BEFORE the completed marker is written (tp-contract collect does the same): a process that
                # survives, or cannot be looked up, fails the command with the task still settled, and the next collect tries
                # again. A task already completed has its cleanup retried here too.
                value["process"] = end_or_refuse(path)
                if value["status"] == "settled":
                    atomic_json(path / "collected.json", {"collected": now()}, base)
                    value["status"] = "completed"
                    write_index(base)
                    refreshed(base, args.id, value)
            elif value["status"] == "paused" and value["result_path"]:
                notice = paused_notice(base, path, args.id, value.get("result_status"))
                value = {"notice": notice, **value}  # first key, so a reader sees it at once
                print(notice, file=sys.stderr)
        elif args.command == "stop":
            run = subprocess.run([str(ROOT / "bin/tp-kill"), args.id], text=True, capture_output=True)
            if run.returncode:
                raise RuntimeError(run.stderr.strip())
            value = {"id": args.id, "status": "stopped"}
            warning = run.stderr.strip()
            if warning:  # the process is ended; tp-kill still said something (task.md not refreshed): a success that says so
                print(warning, file=sys.stderr)
                value["warning"] = warning
            write_index(base)
        else:
            pane = read_json(path / "meta.json").get("pane")
            if not pane or lifecycle(path) in {"failed", "stopped"}:
                raise ValueError("worker cannot receive a message (it has no pane, or it failed or was stopped); "
                                 f"start it again with: `tp-agent retry {args.id} --reason \"say what changed\"`")
            if (path / "reaped.json").exists():
                raise ValueError("worker's process was ended (task collected or reviewed); retry it instead of messaging")
            subprocess.run(["tmux", "send-keys", "-t", pane, "-l", args.text.replace("\n", " ")], check=True)
            subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True)
            (path / "collected.json").unlink(missing_ok=True)
            value = {"id": args.id, "sent": True}
            try:
                safe_write.append_text(path / "messages.jsonl", json.dumps({"sent": now(), "text": args.text}) + "\n", root=base)
                requested = path / "capability-request.json"
                if requested.exists():
                    pending = read_json(requested)
                    if pending.get("status") == "pending":
                        pending.update({"status": "answered", "answered": now()})
                        atomic_json(requested, pending, base)
            finally:  # collected.json is already gone: the record is refreshed even if a later write fails
                refreshed(base, args.id, value)
    else:
        raise ValueError("unknown command")
    print(json.dumps(value, indent=2))


def run_find(args):
    """`tp-agent find`: returns what to print (text, or a dict for --json); work_find.bounded prints it."""
    incomplete = []
    rows, total = work_find.search(args.terms, args.kind, args.ticket, args.tag, args.status, args.workspace, args.since,
                                   args.all, args.limit, incomplete)
    if args.json:
        return {"total": total, "rows": rows, "incomplete": bool(incomplete), "incomplete_reasons": incomplete}
    return work_find.format_rows(rows, total, incomplete)


def run_autonomy(args):
    """`tp-agent autonomy on|off|status`. `on` checks the caller (a Claude orchestrator main) before it looks for any state, so a
    refusal writes nothing; it then attaches the workspace, so the compaction hooks checkpoint it and the index shows it."""
    cmd = args.autonomy_command
    if cmd == "on":
        problem = autonomy.env_problem(os.environ)
        if problem:
            raise ValueError(problem)
    base = state_dir()
    if cmd == "status":
        return autonomy.status(base)
    reason = args.reason.strip()
    if cmd == "off":
        value = autonomy.disable(base, reason)
        note = autonomy.audit(value["workspace"], "autonomy off" + (f": {reason}" if reason else "")) if value["workspace"] else None
    else:
        value = autonomy.enable(base, os.environ, args.workspace, reason)
        work_commands.run(argparse.Namespace(work_command="attach", id=args.workspace), base)
        note = autonomy.audit(args.workspace, "autonomy on" + (f": {reason}" if reason else "") + "; recovery pending until `work recovered`")
        value = {**autonomy.status(base), "attached": args.workspace}
    if note:
        print(f"tp-agent: warning: {note}", file=sys.stderr)
        value["warning"] = note
    write_index(base)
    return value


def run_work(args):
    """`tp-agent work ...`: returns what to print (text, or a JSON-able value); work_find.bounded prints it."""
    # The work store is user-level and needs no session, except `attach` and `compacted`, which write this run's own files.
    # checkpoint and recover use a session when there is one, and so does every mutation (work_commands.post_mutation checkpoints an
    # attached workspace): all of them resolve the run through state_dir(), an exported TP_STATE_DIR or the session's own alike.
    cmd = args.work_command
    session = None
    task_status = None
    if cmd in {"attach", "compacted", "checkpoint", "recover", "recovered"} or work_commands.mutating(args):
        try:
            session = state_dir()
        except (ValueError, OSError, subprocess.CalledProcessError) as error:
            if cmd in {"attach", "compacted", "recovered"}:
                raise ValueError("no tmux-pi state directory; start a workspace with tp, or set TP_STATE_DIR") from error
    tasks = None
    if session is not None:
        def task_status(ident):
            try:
                return record(task_dir(session, ident))["status"]
            except (ValueError, OSError, KeyError):
                return "unknown"

        def tasks():
            return [{"id": r.get("id"), "status": r.get("status"), "result_path": r.get("result_path")} for r in all_records(session)]
    return work_commands.run(args, session, task_status, tasks)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print(f"tp-agent: {error}", file=sys.stderr)
        sys.exit(1)
