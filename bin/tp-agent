#!/usr/bin/env python3
"""Shared task interface for Pi, Claude Code, and the tmux status pane."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from uuid import uuid4

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
import review_verdict  # noqa: E402
from task_record import refresh_record  # noqa: E402
from contract import satisfies_dependency, task_lifecycle  # noqa: E402  (the one lifecycle classifier, shared with tp-contract)
from worker_process import FINISHED, end_or_refuse, end_process, end_orphan, guard_retry, guard_review, live_process, orphans, pane_table  # noqa: E402

ROLES = ROOT / "agent" / "roles"
TESTS_SCOPES = ("affected", "full", "none")
TESTS_DEFAULT = "affected"
IDENT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
ACTIVE = {"starting", "working", "tool", "permission", "needs_input"}
LOCAL = ("slotstream/", "lmstudio/", "mlx/", "ollama/")


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def read_json(path, default=None):
    try:
        value = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {} if default is None else default
    return value if isinstance(value, dict) else {} if default is None else default  # every record here is an object


def atomic_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as out:
            json.dump(value, out, indent=2)
            out.write("\n")
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def state_dir():
    explicit = os.getenv("TP_STATE_DIR")
    if explicit:
        return Path(explicit).resolve()
    if os.getenv("TMUX"):
        target = ["-t", os.environ["TMUX_PANE"]] if os.getenv("TMUX_PANE") else []
        session = subprocess.check_output(["tmux", "display-message", "-p", *target, "#S"], text=True).strip()
    else:
        session = os.getenv("TP_SESSION", "tmux-pi")
    value = subprocess.check_output(["tmux", "show-options", "-qv", "-t", f"={session}:", "@tp_state_dir"], text=True).strip()
    if not value:
        raise ValueError("no tmux-pi state directory; start a workspace with tp")
    return Path(value)


def refreshed(base, ident, value):
    """After a change of a task's state, bring its canonical record (task.md) up to date, so no reader sees the old state.
    The change stands whatever happens here: a failure is said on stderr and in the answer, not turned into a failed command."""
    problem = refresh_record(base, ident)
    if problem:
        print(f"tp-agent: {problem}", file=sys.stderr)
        value["record"] = problem


def task_dir(base, ident):
    if not IDENT.fullmatch(ident):
        raise ValueError("invalid task id")
    path = base / "tasks" / ident
    if not (path / "meta.json").is_file():
        raise ValueError(f"unknown task: {ident}")
    return path


RESULT_STATUS = re.compile(r"(?m)^RESULT_STATUS:\s*(complete|empty|blocked|incomplete)\b", re.I)


def lifecycle(path):
    # tp-agent does not look at panes: contract.lifecycle reads an unobserved pane as present.
    return task_lifecycle(path)[0]


def record(path, include_result=False):
    meta = read_json(path / "meta.json")
    state = read_json(path / "state.json")
    result_path = path / "result.md"
    report_path = path / "report.md"
    result_text = result_path.read_text() if result_path.exists() else ""
    match = RESULT_STATUS.search(result_text)
    result = {
        "id": meta.get("id", path.name), "role": meta.get("role", "generic"),
        "harness": meta.get("worker", "unknown"), "model": state.get("model") or meta.get("model"),
        "effort": meta.get("thinking"), "status": lifecycle(path),
        "assignment": (path / "request.md").read_text() if (path / "request.md").exists() else "",
        "deliverable": meta.get("deliverable", ""), "parent": meta.get("parent", ""),
        "route": meta.get("route_info", {}), "task_dir": str(path),
        "packet": str(path / "packet.md"), "result_path": str(result_path) if result_path.exists() else None,
        "result_status": match.group(1).lower() if match else None,
        "tool": state.get("tool", ""), "updated": state.get("updated", meta.get("created")),
        "tokens": state.get("tokens"), "cost": state.get("cost"),
        "permission": read_json(path / "permission-request.json") if (path / "permission-request.json").exists() else None,
        "capability_request": read_json(path / "capability-request.json") if (path / "capability-request.json").exists() else None,
        # the same test lib/contract.py uses to hold a task at needs_input for human capability approval
        "capability_pending": (path / "pending-capability.json").exists(),
        # The worker's own report file, kept apart from result.md (the last reply, rewritten at every Stop).
        "report_path": str(report_path) if report_path.is_file() else None,
        "report_bytes": report_path.stat().st_size if report_path.is_file() else None,
        "transcript": (path / "transcript-path").read_text().strip() if (path / "transcript-path").exists()
                      else str(path / "transcript.jsonl") if (path / "transcript.jsonl").exists() else None,
    }
    if (path / "review-of").is_file() and result_text:
        # a reviewer's verdict; a reply that is not one is reported as such, never read as an approval
        try:
            result["verdict"], result["verdict_notes"] = review_verdict.parse(result_text)
        except ValueError as exc:
            result["verdict"], result["verdict_notes"] = "unparseable", str(exc)
    if include_result:
        result["result"] = result_text
    return result


def reap(base, args):
    """List finished tasks whose process is still alive; end them only with --yes."""
    for ident in args.ids:
        task_dir(base, ident)  # an unknown id refuses by name
    table, found = pane_table(), []
    tasks = base / "tasks"
    for path in sorted(tasks.iterdir()) if tasks.exists() else []:
        if not (path / "meta.json").is_file() or (args.ids and path.name not in args.ids):
            continue
        live = live_process(path, table)
        if live and lifecycle(path) in FINISHED:
            found.append({"id": path.name, "status": lifecycle(path), "pane": live[0], "pid": live[1]})
    found += orphans(tasks, args.ids)  # a failed stop's process, its pane gone (process.json)
    failed = []
    for row in found:
        if args.yes:
            row.update(end_orphan(tasks, row) if row.get("orphan") else end_process(tasks / row["id"]))
            if row.get("ended") is False:
                failed.append(row)
    if failed:  # the requested cleanup was not done: non-zero, the survivors named; a later reap retries
        raise RuntimeError("; ".join(f"{row['id']}'s process is still alive: {row.get('reason')} (pane {row.get('pane')}, pid {row.get('pid')})"
                                     for row in failed))
    return {"confirmed": bool(args.yes), "tasks": found,
            **({} if args.yes or not found else {"note": "nothing ended; run again with --yes to end these processes"})}


def all_records(base):
    tasks = base / "tasks"
    rows = [record(path) for path in tasks.iterdir() if (path / "meta.json").is_file()] if tasks.exists() else []
    for path in queue_files(base):
        _, item, reason = queue_entry(path)
        item = item or {}  # a refused entry shows only its file name and why
        rows.append({"id": item.get("id", path.stem), "role": item.get("role"), "harness": item.get("worker"),
                     "model": item.get("model"), "effort": item.get("thinking"), "status": "queued",
                     "assignment": item.get("task"), "deliverable": item.get("deliverable"),
                     "parent": item.get("parent"), "route": item.get("route_info"),
                     "reason": reason or item.get("queue_reason") or None,
                     "task_dir": None, "packet": None, "result_path": None, "updated": item.get("created")})
    return sorted(rows, key=lambda row: row.get("updated") or "")


def write_index(base):
    rows = all_records(base)
    objective = base / "session-objective.md"
    def brief(row):
        return {key: row.get(key) for key in ("id", "role", "harness", "model", "status", "result_status",
                "deliverable", "task_dir", "result_path", "permission", "capability_request", "capability_pending",
                "reason", "updated")}
    value = {
        "schema": "tp-session-index:v1", "updated": now(),
        "objective": objective.read_text().strip() if objective.exists() else "",
        "active": [brief(r) for r in rows if r["status"] in {"queued", "starting", "working", "needs_input"}],
        "pending": [brief(r) for r in rows if r["status"] in {"settled", "failed"}],
        # paused workers, however old: shown to the main agent, never collected
        "unstatused": [brief(r) for r in rows if r["status"] == "paused" and not r.get("result_status")],
        "paused": [brief(r) for r in rows if r["status"] == "paused" and r.get("result_status")],
        "recent": [brief(r) for r in rows[-12:]],
    }
    atomic_json(base / "session-index.json", value)
    return value


ROUTE_INFO_KEYS = ("source", "level", "effort", "effort_abstract", "provider", "decided_by", "reason", "review",
                   "router_review", "steps", "approvals", "local_only", "catalog_version", "prompt_sha256", "card_sha256",
                   "selection_id")


def route_info(result):
    return {key: result.get(key) for key in ROUTE_INFO_KEYS}


def route(task, role, worker, model, thinking, context=(), deliverable="", level=None, approve_effort=False,
          local_only=False, workdir=None, base=None):
    """Choose (worker, model, effort, route_info) with the catalog router (lib/model_router.py). Explicit --worker,
    --model, --thinking and --level are constraints; the pair is always valid, or ValueError says why the user must
    decide. Nothing here calls Laya."""
    sys.path.insert(0, str(ROOT / "lib"))
    import model_router
    result = model_router.select({"task": task, "role": role, "deliverable": deliverable, "context": list(context),
                                  "workdir": workdir, "worker": worker, "model": model, "thinking": thinking,
                                  "level": level, "local_only": local_only, "approve_effort": approve_effort}, base=base)
    return result["worker"], result["model"], result["thinking"], route_info(result)


def escalation_evidence(base, previous):
    """(failed attempts, REQUEST_CHANGES reviews) along the retry lineage that ends at `previous`."""
    failed = changes = 0
    seen, path = set(), previous
    for _ in range(12):
        meta = read_json(path / "meta.json")
        if meta.get("id", path.name) in seen:
            break
        seen.add(meta.get("id", path.name))
        rec = record(path)
        if rec["status"] in {"failed", "stopped"} or rec["result_status"] in {"incomplete", "blocked"}:
            failed += 1
        if meta.get("review"):
            try:
                text = (task_dir(base, meta["review"]) / "result.md").read_text()
                # APPROVED_WITH_NOTES approves; only REQUEST_CHANGES counts toward escalation
                changes += 1 if review_verdict.parse(text)[0] == "REQUEST_CHANGES" else 0
            except (ValueError, OSError):
                pass
        if not meta.get("parent"):
            break
        try:
            path = task_dir(base, meta["parent"])
        except ValueError:
            break
    return failed, changes


def escalation_route(base, previous, args, contexts):
    """(worker, model, effort, route_info) for `retry --escalate`: effort up before level, only after the catalog's
    number of failed attempts or REQUEST_CHANGES reviews."""
    sys.path.insert(0, str(ROOT / "lib"))
    import model_router
    import router_catalog
    catalog = router_catalog.load_catalog()
    failed, changes = escalation_evidence(base, previous)
    need = catalog["escalation"]["after"]
    if max(failed, changes) < need:
        raise ValueError(f"escalation needs {need} failed attempts or {need} REQUEST_CHANGES reviews; found {failed} and "
                         f"{changes}. Retry without --escalate, or request a level explicitly with --level")
    meta = read_json(previous / "meta.json")
    try:  # the task text and admitted context, so the escalation record carries the same card hash as the dispatch
        meta = dict(meta, task=(previous / "request.md").read_text().strip(), context=contexts)
    except OSError:
        pass
    result = model_router.escalate_route(meta, catalog, role=args.role or meta.get("role"), worker=args.worker,
                                         approve_effort=args.approve_effort, base=base,
                                         local_only=getattr(args, "local_only", False))
    return result["worker"], result["model"], result["thinking"], route_info(result)


def capacity(base, item):
    """(ok, reason) for starting a queue item now. The item is validated here, so no caller can pass raw data."""
    item = queue_item(item)
    worker, model = item["worker"], item["model"]
    cfg = read_json(ROOT / "config/orchestration.json")
    active = [r for r in all_records(base) if r["status"] in {"starting", "working", "needs_input"}]
    if len(active) >= int(cfg.get("max_active_workers", 4)):
        return False, "global worker slots full"
    if worker == "pi" and model.startswith(LOCAL):
        local = [r for r in active if r.get("harness") == "pi" and str(r.get("model") or "").startswith(LOCAL)]
        if len(local) >= int(cfg.get("max_local_workers", 2)):
            return False, "local model slots full"
    for parent in item["after"]:
        try:
            predecessor_dir = task_dir(base, parent)
            meta = read_json(predecessor_dir / "meta.json")
            if not meta:
                return False, f"dependency {parent} is unreadable"
            predecessor = record(predecessor_dir)
            life, state, events, reply = task_lifecycle(predecessor_dir)
        except ValueError:
            return False, f"dependency {parent} has not started"
        # The shared answer first (a pause or an unstatused reply never satisfies), then admission's own
        # stricter rule: only a task that has a reply, settled or completed.
        if not satisfies_dependency(life, state, events, reply) or predecessor["status"] not in {"settled", "completed"} \
                or not predecessor["result_path"]:
            return False, f"waiting for {parent}"
    return True, ""


def admitted_context(path, specs):
    """Split context specs by tp-spawn's own omission notes in the packet; file contents are never read."""
    try:
        lines = set((path / "packet.md").read_text().splitlines())
    except OSError:
        return [], list(specs)  # admission cannot be confirmed
    admitted, omitted = [], []
    for spec in specs:
        marker = f"- Sensitive context {spec} was omitted from the packet."
        (omitted if any(line.startswith(marker) for line in lines) else admitted).append(spec)
    return admitted, omitted


def replay_inputs(previous, kept, problem=None):
    """Return (context, notes, remark) to replay from a prior attempt. `kept` is dispatch_record's return value, or
    None with its RecordError as `problem`; an unusable record replays nothing."""
    if kept is None:
        return [], [], ("The prior attempt has no dispatch record, so its selected context and notes were not replayed"
                        if problem is not None and problem.missing
                        else "The prior dispatch record is malformed, so its selected context and notes were not replayed")
    # Recheck against the prior packet too: records written before admission was tracked hold raw specs.
    contexts, omitted = admitted_context(previous, kept["context"])
    omitted = len(set(kept["omitted_context"] + omitted))
    notes = [note for note in kept["notes"] if not note.startswith("Retry of ")]
    return contexts, notes, (f"{omitted} context input(s) omitted as sensitive in the prior attempt were not replayed"
                             if omitted else "")


def launch(base, item):
    item = queue_item(item)  # every field below comes from the validator's return value
    args = [str(ROOT / "bin/tp-spawn"), "--task-id", item["id"], "--role", item["role"],
            "--worker", item["worker"], "--model", item["model"], "--thinking", item["thinking"],
            "--route-json", json.dumps(item["route_info"]), "--tests", item["tests"]]
    if item["deliverable"]:
        args += ["--deliverable", item["deliverable"]]
    args += ["--workdir", item["workdir"]]
    if item["parent"]:
        args += ["--parent", item["parent"]]
    for spec in item["context"]:
        args += ["--context", spec]
    for note in item["notes"]:
        args += ["--note", note]
    for parent in item["after"]:
        predecessor = record(task_dir(base, parent))
        if predecessor.get("result_path"):
            args += ["--note", f"Dependency {parent} result: {predecessor['result_path']}"]
    args += ["--", item["task"]]
    run = subprocess.run(args, text=True, capture_output=True)
    if run.returncode:
        raise RuntimeError(run.stderr.strip() or "tp-spawn failed")
    # Record what the packet actually admitted so retry never replays an omitted sensitive input.
    path = task_dir(base, item["id"])
    admitted, omitted = admitted_context(path, item["context"])
    atomic_json(path / "dispatch.json",
                {"context": admitted, "omitted_context": omitted, "notes": item["notes"], "tests": item["tests"]})
    return record(task_dir(base, item["id"]))


def locked(base):
    base.mkdir(parents=True, exist_ok=True)
    lock = open(base / ".tp-agent.lock", "a")
    fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def check_workdir(role, workdir=None):
    """The canonical absolute workdir tp-spawn --check validated (explicit, else the main pane's); ValueError if
    tp-spawn refuses it or reports anything but an absolute path."""
    command = [str(ROOT / "bin/tp-spawn"), "--check", "--role", role] + (["--workdir", workdir] if workdir else []) + ["--", "check"]
    run = subprocess.run(command, text=True, capture_output=True)
    if run.returncode:
        raise ValueError(run.stderr.strip() or "tp-spawn could not check the workdir")
    effective = run.stdout.strip()
    if not effective.startswith("/") or "\n" in effective:
        raise ValueError(f"tp-spawn did not report a usable workdir: {run.stdout.strip()!r}")
    return effective


def string_list(value):
    return isinstance(value, list) and all(isinstance(entry, str) for entry in value)


QUEUE_TEXT = ("id", "role", "worker", "model", "thinking", "task")


def queue_item(value, name=None):
    """The one check of a queue item (what dispatch writes to queue/<id>.json). It covers every field any reader uses
    and returns a new dict of just those fields, normalised; launch, capacity, tick, the index and the queue views take
    their data only from this return value. Every field but queue_reason is required, tests included: the default
    scope is applied only where dispatch builds the record from the command line, never to a stored one. `name` is
    the file stem the id must match. ValueError says which field is wrong."""
    if not isinstance(value, dict):
        raise ValueError("the queue entry is not an object")
    for key in QUEUE_TEXT:
        if not isinstance(value.get(key), str) or not value[key]:
            raise ValueError(f"the record has no usable {key}")
    if not IDENT.fullmatch(value["id"]) or (name is not None and value["id"] != name):
        raise ValueError(f"the record id {value['id']!r} is not a valid id matching its file")
    if not IDENT.fullmatch(value["role"]) or not (ROLES / f"{value['role']}.md").is_file():
        raise ValueError(f"the record has an unknown role {value['role']!r}")
    if value["worker"] not in ("pi", "claude"):
        raise ValueError(f"the record has an unknown worker {value['worker']!r}")
    workdir = value.get("workdir")
    if not isinstance(workdir, str) or not workdir.startswith("/"):
        raise ValueError(f"the record has no validated workdir ({workdir!r}); dispatch it again with --workdir")
    if "tests" not in value:
        raise ValueError("the record has no test scope")
    tests = value["tests"]
    if not isinstance(tests, str) or tests not in TESTS_SCOPES:
        raise ValueError(f"the record has an invalid test scope {tests!r}")
    if not isinstance(value.get("route_info"), dict):
        raise ValueError("the record has no route information")
    for key in ("created", "deliverable", "parent"):
        if not isinstance(value.get(key), str):
            raise ValueError(f"the record has no usable {key}")
    for key in ("after", "context", "notes"):
        if not string_list(value.get(key)):
            raise ValueError(f"the record's {key} is not a list of strings")
    if not all(IDENT.fullmatch(parent) for parent in value["after"]):
        raise ValueError("the record's after list holds an invalid task id")
    clean = {key: value[key] for key in QUEUE_TEXT + ("workdir", "route_info", "created", "deliverable", "parent")}
    clean.update({key: list(value[key]) for key in ("after", "context", "notes")}, tests=tests)
    if "queue_reason" in value:  # optional (tp-agent's own note, only displayed), but a present value must be text
        if not isinstance(value["queue_reason"], str):
            raise ValueError("the record's queue_reason is not text")
        clean["queue_reason"] = value["queue_reason"]
    return clean


def read_queue_file(path):
    """The decoded content of a queue file. The entry is lstat'ed first and anything that is not a regular file
    (a symlink, readable or dangling, a FIFO, socket, device, directory) is refused unopened, so it can neither block
    a reader nor be followed to a record elsewhere."""
    try:
        if not stat.S_ISREG(path.lstat().st_mode):
            raise ValueError("it is not a regular file")
        return json.loads(path.read_text())
    except (OSError, ValueError, RecursionError) as error:
        raise ValueError(f"cannot read {path.name} ({error})")


def queue_files(base):
    """The queue entries, oldest first. Every *.json name is an entry, a dangling symlink or a directory included
    (queue_entry refuses it with a reason); only one that vanishes while listing is skipped."""
    found = []
    for path in (base / "queue").glob("*.json"):
        try:
            found.append((path.lstat().st_mtime, path))
        except OSError:
            continue
    return [path for _, path in sorted(found)]


def queue_entry(path):
    """(raw, item, reason) for one queue file. raw is the decoded content (None if unreadable); item is queue_item's
    return value, or None with reason 'start refused: why'. The one way any reader gets an item from a file."""
    raw = None
    try:
        raw = read_queue_file(path)
        return raw, queue_item(raw, path.stem), ""
    except ValueError as error:
        return raw, None, f"start refused: {error}"


def printable(text):
    return re.sub(r"[\x00-\x1f\x7f]", "?", str(text))


def queue_view(base):
    """One display line per queue entry, for tp-list and tp-status. A refused entry shows its file name and why;
    it is never shown as an ordinary queued task."""
    lines = []
    for path in queue_files(base):
        _, item, reason = queue_entry(path)
        lines.append(printable(f"  {path.stem}  queued  {reason}") if item is None else
                     printable(f"  {item['id']}  {item['role']}  queued  {item.get('queue_reason', '')}"))
    return lines


class RecordError(ValueError):
    def __init__(self, message, missing=False):
        super().__init__(message)
        self.missing = missing


def dispatch_record(previous):
    """The one check of a task's dispatch.json (what launch writes). Covers every field a reader uses and returns
    {"context", "omitted_context", "notes", "tests"}; tests is None only in an older record that predates the field.
    Retry's replay and its recorded test scope take their data only from this return value. RecordError otherwise;
    omitted_context is optional (older records lack it) but a list of strings when present."""
    path = previous / "dispatch.json"
    try:
        kept = json.loads(path.read_text())
    except FileNotFoundError:
        raise RecordError(f"cannot read the prior dispatch record {path} (no such file)", missing=True)
    except (OSError, ValueError) as error:
        raise RecordError(f"cannot read the prior dispatch record {path} ({error})")
    if not isinstance(kept, dict):
        raise RecordError(f"the prior dispatch record {path} is malformed (not an object)")
    for key in ("context", "notes") + (("omitted_context",) if "omitted_context" in kept else ()):
        if not string_list(kept[key] if key in kept else None):
            raise RecordError(f"the prior dispatch record {path} is malformed ({key} is not a list of strings)")
    tests = kept.get("tests")
    if "tests" in kept and (not isinstance(tests, str) or tests not in TESTS_SCOPES):
        raise RecordError(f"the prior dispatch record {path} has an invalid test scope {tests!r}")
    return {"context": list(kept["context"]), "omitted_context": list(kept.get("omitted_context", [])),
            "notes": list(kept["notes"]), "tests": tests}


def prior_dispatch(previous):
    """(record, None) from dispatch_record, or (None, the RecordError)."""
    try:
        return dispatch_record(previous), None
    except RecordError as error:
        return None, error


def dispatch(args, base):
    if not (ROLES / f"{args.role}.md").is_file():
        raise ValueError(f"unknown role: {args.role}")
    tests = getattr(args, "tests", None)
    if tests is None:  # a caller that never sets the field (not a read value) gets the dispatch default
        tests = TESTS_DEFAULT
    if tests not in TESTS_SCOPES:
        raise ValueError(f"--tests must be one of {', '.join(TESTS_SCOPES)}")
    # Refuse before routing or queueing. tp-spawn resolves the effective workdir (the explicit one, else the main
    # pane's) exactly as it will when it builds the packet, so both dispatch forms are checked the same way.
    # The canonical directory it reports is what the task stores, routing reads and launch passes back, so a queued
    # task cannot start in a different repository than the one validated here.
    workdir = check_workdir(args.role, args.workdir)
    if not args.workdir:  # recheck the resolved directory the way launch will pass it (an explicit --workdir)
        workdir = check_workdir(args.role, workdir)
    chosen = getattr(args, "preroute", None) or route(
        args.task, args.role, args.worker, args.model, args.thinking, args.context or [], args.deliverable,
        level=getattr(args, "level", None), approve_effort=getattr(args, "approve_effort", False),
        local_only=getattr(args, "local_only", False), workdir=workdir, base=base)
    worker, model, thinking, info = chosen
    item = queue_item({"id": f"{args.role}-{uuid4().hex[:10]}", "created": now(), "role": args.role,
            "task": args.task, "workdir": workdir, "worker": worker, "model": model,
            "thinking": thinking, "route_info": info, "deliverable": args.deliverable or "",
            "parent": args.parent or "", "after": args.after or [], "context": args.context or [],
            "notes": args.note or [], "tests": tests})
    with locked(base):
        ok, reason = capacity(base, item)
        if ok:
            value = launch(base, item)
        else:
            item["queue_reason"] = reason
            atomic_json(base / "queue" / f"{item['id']}.json", item)
            value = {"id": item["id"], "status": "queued", "reason": reason, "role": item["role"],
                     "harness": worker, "model": model, "effort": thinking}
        write_index(base)
    return value


def note_queue_reason(path, raw, reason):
    """Leave the entry queued with why it did not start. Only an object can carry a reason; an unreadable or
    non-object entry is never rewritten (that would destroy it) and is reported in tick's output instead."""
    if isinstance(raw, dict) and raw.get("queue_reason") != reason:
        try:
            atomic_json(path, dict(raw, queue_reason=reason))
        except OSError:
            pass


def tick(base):
    started, refused = [], []
    with locked(base):
        for path in queue_files(base):
            raw, item, reason = queue_entry(path)
            if item is None:
                note_queue_reason(path, raw, reason)
                refused.append({"id": path.stem, "reason": reason})
                continue
            try:
                ok, _ = capacity(base, item)
                if not ok:
                    continue
                started.append(launch(base, item)["id"])
                path.unlink()
            except (ValueError, RuntimeError, OSError) as error:
                reason = f"start failed: {error}"
                note_queue_reason(path, raw, reason)
                refused.append({"id": item["id"], "reason": reason})
        write_index(base)
    return {"started": started, "refused": refused}


def discover_context(task, workdir=None):
    """Return {contexts, reasons, skipped} for dispatch --context; tp-spawn still caps and screens every
    spec. skipped lists paths named in the task that were refused unread, each with its reason."""
    root = Path(workdir or os.getcwd()).resolve()
    if not root.is_dir():
        raise ValueError(f"workdir is not a directory: {root}")
    if not task.strip():
        raise ValueError("context needs a task")
    sys.path.insert(0, str(ROOT / "lib"))
    from context_broker import context_reasons, select_context
    out = select_context(task, root)
    return {"contexts": out["contexts"], "reasons": context_reasons(out["manifest"]), "skipped": out["skipped"]}


def review(base, args):
    """Run bin/tp-review for a finished task. The reviewer is chosen by the resolver (lib/model_router.review_plan):
    never the author's provider when another is available."""
    command = [str(ROOT / "bin/tp-review")] + (["--force"] if args.force else []) + (["--force-alive"] if args.force_alive else [])
    for flag, value in (("--level", args.level), ("--thinking", args.thinking)):
        if value:
            command += [flag, value]
    if args.approve_effort:
        command.append("--approve-effort")
    run = subprocess.run(command + [args.id], text=True, capture_output=True, env={**os.environ, "TP_STATE_DIR": str(base)})
    if run.returncode == 3:
        return {"id": args.id, "review": None, "status": "not_needed", "reason": run.stderr.strip()}
    if run.returncode:
        raise RuntimeError(run.stderr.strip() or "tp-review failed")
    value = {"id": args.id, "review": run.stdout.strip().splitlines()[-1], "status": "started"}
    write_index(base)
    return value


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    d = sub.add_parser("dispatch", help="route and start or queue a role task")
    d.add_argument("--role", required=True)
    d.add_argument("--task", required=True)
    d.add_argument("--worker", choices=["pi", "claude"], help="require this harness; the router still picks the model")
    d.add_argument("--model", help="explicit model (skips the router)")
    d.add_argument("--thinking", help="explicit effort; above high needs --approve-effort")
    d.add_argument("--level", help="explicit catalog level key, e.g. top (skips the router)")
    d.add_argument("--approve-effort", action="store_true",
                   help="record that the user approved an effort above high for this task")
    d.add_argument("--local-only", action="store_true", help="private work: local router and local model, or stop and ask")
    d.add_argument("--workdir")
    d.add_argument("--deliverable", default="")
    d.add_argument("--parent")
    d.add_argument("--after", action="append", default=[])
    d.add_argument("--context", action="append", default=[])
    d.add_argument("--note", action="append", default=[])
    d.add_argument("--tests", choices=TESTS_SCOPES, default=TESTS_DEFAULT,
                   help="how much of the test suite the worker runs: affected (default) = the tests that check "
                        "what it changed, full = everything, none")
    retry = sub.add_parser("retry", help="start a linked attempt with a recorded reason")
    retry.add_argument("id")
    retry.add_argument("--reason", required=True)
    retry.add_argument("--task")
    retry.add_argument("--role")
    retry.add_argument("--worker", choices=["pi", "claude"])
    retry.add_argument("--model")
    retry.add_argument("--thinking")
    retry.add_argument("--level", help="explicit catalog level key")
    retry.add_argument("--approve-effort", action="store_true", help="record the user's approval of an effort above high")
    retry.add_argument("--local-only", action="store_true")
    retry.add_argument("--tests", choices=TESTS_SCOPES, help="test scope; default is the prior attempt's")
    retry.add_argument("--force-alive", action="store_true",
                       help="start the attempt although a process is still alive on the same working tree")
    retry.add_argument("--escalate", action="store_true",
                       help="after two failed attempts or two REQUEST_CHANGES: effort up, then level up (never above high unapproved)")
    rv = sub.add_parser("review", help="start an independent reviewer for a finished task (a different provider from the author)")
    rv.add_argument("id")
    rv.add_argument("--force", action="store_true", help="review even when the policy says none")
    rv.add_argument("--level", help="explicit reviewer level key")
    rv.add_argument("--thinking", help="explicit reviewer effort")
    rv.add_argument("--approve-effort", action="store_true", help="record the user's approval of an effort above high")
    rv.add_argument("--force-alive", action="store_true", help="review although a writer is still alive on the same working tree")
    ea = sub.add_parser("end-author", help="end a settled task's process before its review starts (bin/tp-review runs this)")
    ea.add_argument("id")
    gr = sub.add_parser("guard-review", help="refuse while a writer is alive on the task's working tree (bin/tp-review runs this)")
    gr.add_argument("id")
    gr.add_argument("--force-alive", action="store_true")
    rp = sub.add_parser("reap", help="list finished tasks whose process is still alive; --yes ends them")
    rp.add_argument("ids", nargs="*")
    rp.add_argument("--yes", action="store_true", help="confirm: end the listed processes")
    for name in ("list", "tick"):
        sub.add_parser(name)
    # Read-only text lines for the shell views (tp-list, tp-status); the validator stays the only reader.
    sub.add_parser("queue-view")
    # --no-tick: write and print the index without launching queued work.
    sub.add_parser("index").add_argument("--no-tick", action="store_true")
    for name in ("inspect", "collect", "stop"):
        sub.add_parser(name).add_argument("id")
    m = sub.add_parser("message")
    m.add_argument("id")
    m.add_argument("--text", required=True)
    o = sub.add_parser("objective")
    o.add_argument("text")
    q = sub.add_parser("request", help="worker asks main for a skill, tool, or context")
    q.add_argument("--kind", choices=["skill", "tool", "context"], required=True)
    q.add_argument("--what", required=True)
    q.add_argument("--reason", required=True)
    c = sub.add_parser("context", help="suggest context specs for a task; prints contexts and reasons")
    c.add_argument("--task", required=True)
    c.add_argument("--workdir")
    ln = sub.add_parser("lane", help="lane commands (T10)").add_subparsers(dest="lane_command", required=True)
    lc = ln.add_parser("create", help="create a lane: a branch, a worktree and a record; nothing is left behind on failure")
    lc.add_argument("name")
    lc.add_argument("--domain", required=True, help="the independence claim in words")
    lc.add_argument("--touches", nargs="+", required=True, metavar="PATH", help="repo-relative path prefixes the lane will change")
    lc.add_argument("--repo", default=".", help="the repository (default: the current directory)")
    lc.add_argument("--base", help="branch or commit to start from (default: the repository's integration branch, lane/integrate unless configured)")
    ls = sub.add_parser("lanes", help="list the repository's lanes and unrecorded worktrees (read-only)")
    ls.add_argument("name", nargs="?")
    ls.add_argument("--repo", default=".")
    args = parser.parse_args()
    if args.command in ("lane", "lanes"):
        # Lanes live in the repository's git directory, not in a session: no session state is read or written.
        import lane_commands
        if args.command == "lanes":
            print(json.dumps(lane_commands.list_lanes(args.repo, args.name), indent=2))
            return
        value = lane_commands.create_lane(args.repo, args.name, args.domain, args.touches, args.base)
        for warning in value["warnings"]:
            print(f"tp-agent: warning: lanes {' and '.join(warning['lanes'])} overlap on {', '.join(warning['paths'])} "
                  f"({', '.join(warning['basis'])}). They were claimed independent ("
                  + "; ".join(f"{k}: {v!r}" for k, v in warning["claims"].items()) + ").", file=sys.stderr)
        print(json.dumps(value, indent=2))
        return
    if args.command == "context":
        # Read-only suggestion: needs no session state and writes no manifest or log.
        print(json.dumps(discover_context(args.task, args.workdir), indent=2))
        return
    base = state_dir()
    if args.command == "queue-view":
        for line in queue_view(base):
            print(line)
        return
    if args.command == "dispatch":
        value = dispatch(args, base)
    elif args.command == "retry":
        if not args.reason.strip():
            raise ValueError("retry reason must describe what changed")
        previous = task_dir(base, args.id)
        meta = read_json(previous / "meta.json")
        prior = record(previous)
        if prior["status"] in {"starting", "working", "needs_input"}:
            raise ValueError("stop or settle the prior attempt before retrying")
        if not args.force_alive:
            guard_retry(previous)
        original = (previous / "request.md").read_text().strip()
        # Replay only admitted context and notes; spawn re-applies the sensitive-read omission. Skip
        # prior retry notes (rebuilt below) and dependencies (stale; the prior packet records them).
        kept, problem = prior_dispatch(previous)
        contexts, notes, remark = replay_inputs(previous, kept, problem)
        if args.tests:
            tests = args.tests
        elif kept is None:
            raise ValueError(f"{problem}; the prior attempt's test scope is unknown, pass --tests")
        else:
            tests = kept["tests"] or TESTS_DEFAULT  # None only in an older valid record
        preroute = None
        if args.escalate:
            if args.model or args.level or args.thinking:
                raise ValueError("--escalate chooses the next step itself; use --level to request a level instead")
            preroute = escalation_route(base, previous, args, contexts)
        replacement = argparse.Namespace(role=args.role or meta.get("role", "coder"),
                                         task=args.task or original, worker=args.worker,
                                         model=args.model, thinking=args.thinking, level=args.level,
                                         approve_effort=args.approve_effort, preroute=preroute,
                                         local_only=args.local_only or bool((meta.get("route_info") or {}).get("local_only")),
                                         workdir=meta.get("workdir"),
                                         deliverable=meta.get("deliverable", ""),
                                         parent=args.id, after=[], context=contexts,
                                         tests=tests,
                                         note=notes + [f"Retry of {args.id}: {args.reason}. Prior task: {previous}. Prior packet: {previous / 'packet.md'} (original constraints and dependency pointers; re-read as needed). Prior result: {prior['result_path'] or 'none'}. Preserve and inspect partial work before claiming completion. Capability requests and sensitive context from the prior attempt are not re-granted."
                                                      + (f" {remark}; see the prior packet." if remark else "")])
        value = dispatch(replacement, base)
        if problem is not None:  # reachable only through an explicit --tests
            value = dict(value, prior_record=f"not used: {problem}")
    elif args.command == "reap":
        value = reap(base, args)
    elif args.command == "end-author":
        value = {"id": args.id, "process": end_or_refuse(task_dir(base, args.id))}
    elif args.command == "guard-review":
        if not args.force_alive:
            guard_review(task_dir(base, args.id))
        value = {"id": args.id, "guard": "clear"}
    elif args.command == "review":
        task_dir(base, args.id)
        value = review(base, args)
    elif args.command == "tick":
        value = tick(base)
    elif args.command == "index":
        if not args.no_tick:
            tick(base)
        value = write_index(base)
    elif args.command == "list":
        value = all_records(base)
    elif args.command == "objective":
        (base / "session-objective.md").write_text(args.text.strip() + "\n")
        value = write_index(base)
    elif args.command == "request":
        own = os.getenv("TP_TASK_DIR")
        if not own:
            raise ValueError("request is only available inside a worker task")
        path = Path(own).resolve()
        if path.parent != (base / "tasks").resolve() or not (path / "meta.json").is_file():
            raise ValueError("invalid worker task directory")
        value = {"kind": args.kind, "what": args.what, "reason": args.reason,
                 "status": "pending", "requested": now()}
        atomic_json(path / "capability-request.json", value)
        write_index(base)
        refreshed(base, path.name, value)
    elif args.command in {"inspect", "collect", "stop", "message"}:
        queued = base / "queue" / f"{args.id}.json"
        if args.command == "stop" and IDENT.fullmatch(args.id) and (queued.is_symlink() or queued.exists()):
            if queued.is_dir() and not queued.is_symlink():
                queued.rmdir()  # an empty directory named like an entry; a full one refuses (OSError)
            else:
                queued.unlink()
            value = {"id": args.id, "status": "stopped"}
            write_index(base)
            print(json.dumps(value, indent=2))
            return
        path = task_dir(base, args.id)
        if args.command == "inspect":
            value = record(path, include_result=True)
        elif args.command == "collect":
            value = record(path, include_result=True)
            if value["status"] in {"settled", "completed"}:
                # The process is ended BEFORE the completed marker is written (tp-contract collect does the same): a process that
                # survives, or cannot be looked up, fails the command with the task still settled, and the next collect tries
                # again. A task already completed has its cleanup retried here too.
                value["process"] = end_or_refuse(path)
                if value["status"] == "settled":
                    atomic_json(path / "collected.json", {"collected": now()})
                    value["status"] = "completed"
                    write_index(base)
                    refreshed(base, args.id, value)
            elif value["status"] == "paused" and value["result_path"]:
                notice = (f"{args.id} is paused; nothing was collected." if value.get("result_status")
                          else f"{args.id} replied without a result status (paused); nothing was collected.")
                value = {"notice": notice, **value}  # first key, so a reader sees it at once
                print(notice, file=sys.stderr)
        elif args.command == "stop":
            run = subprocess.run([str(ROOT / "bin/tp-kill"), args.id], text=True, capture_output=True)
            if run.returncode:
                raise RuntimeError(run.stderr.strip())
            value = {"id": args.id, "status": "stopped"}
            warning = run.stderr.strip()
            if warning:  # the process is ended; tp-kill still said something (task.md not refreshed): a success that says so
                print(warning, file=sys.stderr)
                value["warning"] = warning
            write_index(base)
        else:
            pane = read_json(path / "meta.json").get("pane")
            if not pane or lifecycle(path) in {"failed", "stopped"}:
                raise ValueError("worker cannot receive a message")
            if (path / "reaped.json").exists():
                raise ValueError("worker's process was ended (task collected or reviewed); retry it instead of messaging")
            subprocess.run(["tmux", "send-keys", "-t", pane, "-l", args.text.replace("\n", " ")], check=True)
            subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True)
            (path / "collected.json").unlink(missing_ok=True)
            value = {"id": args.id, "sent": True}
            try:
                with (path / "messages.jsonl").open("a") as out:
                    out.write(json.dumps({"sent": now(), "text": args.text}) + "\n")
                requested = path / "capability-request.json"
                if requested.exists():
                    pending = read_json(requested)
                    if pending.get("status") == "pending":
                        pending.update({"status": "answered", "answered": now()})
                        atomic_json(requested, pending)
            finally:  # collected.json is already gone: the record is refreshed even if a later write fails
                refreshed(base, args.id, value)
    else:
        raise ValueError("unknown command")
    print(json.dumps(value, indent=2))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print(f"tp-agent: {error}", file=sys.stderr)
        sys.exit(1)
