#!/usr/bin/env python3
"""tp-bench: a fixed benchmark that scores one tmux-pi checkout against another.

  tp-bench init                         create the project's bench-base-v1 tag (never edits its working tree)
  tp-bench seal                         copy bench/answers-src/ to the answers directory and record each sha256 in the specs
  tp-bench verify                       check every answer against the sha256 in its spec
  tp-bench run --arm DIR --label NAME [--tasks GLOB] [--repeat N] [--budget-minutes M] [--max-worker-runs N]
               [--env KEY=VALUE]... [--order random|fixed] [--seed S]
  tp-bench compare A B [--allow-env-diff]

See docs/bench.md. The scorer (this file, lib/bench/, bench/) is fixed: the improvement loop never changes it."""
import argparse
import json
import os
import platform
import re
import sys
from pathlib import Path

ROOT = Path(os.path.realpath(__file__)).parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from bench import answers, compare, project, record, runner, specs  # noqa: E402
from bench.shell import Shell, ShellError  # noqa: E402

DEFAULT_PROJECT = Path.home() / "Documents" / "Projects" / "battle-soccer"
LMSTUDIO = "http://localhost:1234/api/v0/models"


def fail(message, code=2):
    print(f"tp-bench: {message}", file=sys.stderr)
    return code


def output_of(result):
    """A tolerated call's stdout, stripped, when it succeeded; None (unknown) when it failed. A record field is never derived from
    the output of a failed call."""
    return result.stdout.strip() if result.returncode == 0 else None


def first_line(result):
    text = output_of(result)
    return text.splitlines()[0] if text else None


def lmstudio_context(shell):
    """{model id: loaded context length} for the models LM Studio reports as loaded; {} only when the list is valid and none is
    loaded; None (unknown) when it is unreachable, its answer is not the model list, or any loaded item has no string id or no
    positive-int context length. Items that are not loaded are skipped whatever their other fields."""
    got = shell.run(["curl", "-s", "-m", "5", LMSTUDIO], timeout=10,
                    tolerate="an unreachable LM Studio is recorded as null (unknown), not an error")
    text = output_of(got)
    if not text:
        return None
    try:
        body = json.loads(text)
    except ValueError:
        return None
    data = body.get("data") if isinstance(body, dict) else None
    if not isinstance(data, list):
        return None
    loaded = {}
    for model in data:
        if not isinstance(model, dict):
            return None
        if model.get("state") != "loaded":
            continue
        length = model.get("loaded_context_length")
        if not (isinstance(model.get("id"), str) and isinstance(length, int) and not isinstance(length, bool) and length > 0):
            return None  # a loaded model we cannot read is unknown, never a smaller map
        loaded[model["id"]] = length
    return loaded


def versions_of(shell, arm):
    unreported = "a version the tool cannot report is recorded as null (unavailable), not an error"
    commit = shell.run(["git", "-C", arm, "rev-parse", "HEAD"], timeout=30, tolerate="an unreadable arm commit is recorded as null")
    return {"claude": first_line(shell.run(["claude", "--version"], timeout=30, tolerate=unreported))
            if shell.run(["which", "claude"], timeout=10, tolerate="which exits 1 when the tool is absent; that is its answer").returncode == 0 else None,
            "pi": first_line(shell.run(["pi", "--version"], timeout=30, tolerate=unreported))
            if shell.run(["which", "pi"], timeout=10, tolerate="which exits 1 when the tool is absent; that is its answer").returncode == 0 else None,
            "node": first_line(shell.run(["node", "--version"], timeout=30, tolerate=unreported)),
            "python": platform.python_version(), "arm_commit": output_of(commit) or None,
            "lmstudio_context": lmstudio_context(shell)}


def arm_info(shell, arm):
    head = shell.run(["git", "-C", arm, "rev-parse", "HEAD"], timeout=30, tolerate="an unreadable arm commit is recorded as null")
    status = shell.run(["git", "-C", arm, "status", "--porcelain"], timeout=30, tolerate="a failed status is recorded as dirty: null (unknown), not false")
    dirty = output_of(status)
    return {"dir": str(arm), "commit": output_of(head) or None, "dirty": None if dirty is None else bool(dirty)}


def load(args):
    bench_dir = ROOT / "bench"
    return bench_dir, specs.load_specs(bench_dir / "tasks")


def cmd_init(args):
    commit, created = project.ensure_base(Shell(), args.project, ROOT / "bench" / "fixtures" / "agent-tools.json")
    print(f"{project.TAG} {'created at' if created else 'already at'} {commit}")
    return 0


def cmd_seal(args):
    bench_dir, all_specs = load(args)
    for task_id, digest in answers.seal(all_specs, bench_dir / "tasks", bench_dir / "answers-src"):
        print(f"{task_id}  sha256 {digest}")
    return 0


def cmd_verify(args):
    bench_dir, all_specs = load(args)
    for spec in all_specs:
        answers.verify(spec)
    print(f"{len(all_specs)} task(s) checked; answers match their sha256")
    return 0


def cmd_run(args):
    if not LABEL_OK.fullmatch(args.label):
        return fail("--label must be letters, digits, '_' and '-'")
    arm = Path(args.arm).resolve()
    for tool in ("bin/tp", "bin/tp-agent", "bin/tp-exit"):
        if not (arm / tool).is_file():
            return fail(f"--arm {arm} is not a tmux-pi checkout (no {tool})")
    if args.repeat < 1:
        return fail("--repeat must be at least 1")
    bench_dir, all_specs = load(args)
    selected = specs.select(all_specs, args.tasks)
    env = runner.parse_env(args.env)
    shell = Shell()
    work = runner.Runner(shell, bench_dir, args.project, arm, args.results_dir, args.label, env=env, order=args.order, seed=args.seed,
                         work_root=args.work_root, log=lambda text: print(text, flush=True))
    paths = work.run(selected, args.repeat, args.budget_minutes, args.max_worker_runs, versions_of(shell, arm), arm_info(shell, arm))
    for path in paths:
        data = record.load(path)
        shown = ", ".join(f"{k}={'-' if v is None else round(v, 3)}" for k, v in data["metrics"].items())
        print(f"{path}: {shown}")
    return 0


LABEL_OK = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")


def cmd_compare(args):
    a, b = record.load_arm(args.results_dir, args.a), record.load_arm(args.results_dir, args.b)
    text, _ = compare.render(a, b, args.a, args.b, args.allow_env_diff)
    print(text)
    return 0


def parser():
    top = argparse.ArgumentParser(prog="tp-bench", description=__doc__.splitlines()[0])
    top.add_argument("--project", default=os.environ.get("TP_BENCH_PROJECT") or str(DEFAULT_PROJECT), help="the bench project (battle-soccer)")
    top.add_argument("--results-dir", default=os.environ.get("TP_BENCH_RESULTS") or str(ROOT / "bench-results"))
    top.add_argument("--work-root", default=os.environ.get("TP_BENCH_WORK") or str(answers.home() / "work"),
                     help="where project copies are made; run bin/tp-claude-bootstrap on it once so Claude trusts the copies")
    sub = top.add_subparsers(dest="command", required=True)
    sub.add_parser("init", help="create the bench-base-v1 tag in the project")
    sub.add_parser("seal", help="copy bench/answers-src/ to the answers directory and record the sha256 in each spec")
    sub.add_parser("verify", help="check every answer against its recorded sha256")
    run = sub.add_parser("run", help="score a tmux-pi checkout")
    run.add_argument("--arm", required=True, help="a tmux-pi checkout (worktree)")
    run.add_argument("--label", required=True)
    run.add_argument("--tasks", default="*", help="comma-separated globs over task ids (default: all)")
    run.add_argument("--repeat", type=int, default=1)
    run.add_argument("--budget-minutes", type=float, default=None, help="stop starting tasks after this long; the rest are not_run (counted as failed)")
    run.add_argument("--max-worker-runs", type=int, default=runner.DEFAULT_MAX_WORKER_RUNS)
    run.add_argument("--env", action="append", default=[], metavar="KEY=VALUE", help="passed to the workspace and recorded; repeatable")
    run.add_argument("--order", choices=("random", "fixed"), default="random")
    run.add_argument("--seed", type=int, default=None, help="seed of the random order (recorded; default: a fresh one)")
    cmp_ = sub.add_parser("compare", help="compare two labels: A is the control, B the candidate")
    cmp_.add_argument("a")
    cmp_.add_argument("b")
    cmp_.add_argument("--allow-env-diff", action="store_true", help="compare records whose env differs beyond the arm gates")
    return top


def main(argv=None):
    args = parser().parse_args(argv)
    handler = {"init": cmd_init, "seal": cmd_seal, "verify": cmd_verify, "run": cmd_run, "compare": cmd_compare}[args.command]
    try:
        return handler(args)
    except answers.AnswerError as error:
        return fail(f"task {error.task_id}: {error}", 3)
    except (specs.SpecError, runner.RunnerError, project.ProjectError, compare.CompareError, ShellError, ValueError, OSError) as error:
        return fail(str(error))


if __name__ == "__main__":
    sys.exit(main())
