#!/usr/bin/env bash
# tp-claude — run Claude Code with only tmux-pi's settings, plugins and MCP servers.
#
# Skips unrelated user, project and local settings. Uses a dedicated per-machine
# config directory for this workspace's Claude login, trust, and session history.
# Claude Code's built-in skills and plugins still load.
# Extra arguments are passed through to claude. Run `tp-claude-bootstrap` once in
# each target workdir to complete Claude Code's folder-trust prompt before workers run.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
CLAUDE_DIR="$ROOT/claude"
export CLAUDE_CONFIG_DIR="${TP_CLAUDE_CONFIG_DIR:-$HOME/.config/tmux-pi/claude}"
export CLAUDE_CODE_DISABLE_CLAUDE_MDS=1
export CLAUDE_CODE_DISABLE_POLICY_SKILLS=1
export CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
export TP_ROOT="$ROOT"
# One redaction store per Claude process: the hooks and the tmux-pi-safe MCP server share it through this id.
export TP_REDACTION_LAUNCH="$(date +%s)-$$-$RANDOM$RANDOM"
mkdir -p "$CLAUDE_CONFIG_DIR"

settings="$CLAUDE_DIR/settings.json"
# Orchestrator main only: successful Bash output over this many characters is saved
# to a session file by Claude Code, and Claude gets a preview plus the path (default
# 30000). Workers and strict sessions keep the shared file as is. Failure output is
# not affected. The setting is session-wide, so Agent-tool children of main share it.
if [[ -z "${TP_TASK_DIR:-}" && "${TP_MODE:-}" == orchestrator ]]; then
  command -v jq >/dev/null 2>&1 || { echo "tp-claude: jq is required to compose main settings" >&2; exit 1; }
  settings="$(jq -c '. + {bashOutputMaxChars: 10000}' "$settings")" && [[ -n "$settings" ]] ||
    { echo "tp-claude: could not compose main settings from $CLAUDE_DIR/settings.json" >&2; exit 1; }
fi
# Auth headers for the HTTP MCP servers in mcp.json (git-ignored; see README).
[[ ! -f "$CLAUDE_DIR/mcp.local.env" ]] || source "$CLAUDE_DIR/mcp.local.env"

# Offline docs server (api_signature, docs_search) only when TP_DOCS_TOOLS=1: a second --mcp-config beside mcp.json,
# which stays under --strict-mcp-config. Unset, the argument list is exactly the one below without the extra pair.
mcp_args=(--mcp-config "$CLAUDE_DIR/mcp.json")
[[ "${TP_DOCS_TOOLS:-}" != 1 ]] || mcp_args+=(--mcp-config "$CLAUDE_DIR/mcp.docs.json")
# Ctx tools server (ctx_brief, ctx_symbol, ctx_relations, ctx_knowledge, ctx_note) only for a task (TP_TASK_DIR set: tp-ctx logs each
# call there and answers nothing without it) with TP_CTX_TOOLS=1, which bin/tp-spawn passes on to a worker when main has it.
[[ "${TP_CTX_TOOLS:-}" != 1 || -z "${TP_TASK_DIR:-}" ]] || mcp_args+=(--mcp-config "$CLAUDE_DIR/mcp.ctx.json")

# Always include this, including off/shadow: mode can change during a session.
# Keep the suffix and exclusions aligned with lib/redact_hook.py wrap(). The local
# claude --help does not promise repeatable/mixable append flags, so compose one.
suffix_instruction='Append ` || echo exit-code: nonzero` to every Bash command you run, once on the final line. Do not append to empty commands, commands containing <<, background commands (including run_in_background), commands whose final line ends in a backslash, ||, &&, |, &, {, (, do, then or else, commands with an explicit exit, or commands whose final line has a shell comment or unmatched quotes. Strip trailing whitespace and trailing semicolons first (but not ;;). The tmux-pi redaction hook adds it otherwise, and auto mode refuses a command a hook changed.'
launch_args=()
append_prompt=""
while (( $# )); do
  case "$1" in
    --append-system-prompt|--append-system-prompt-file)
      flag="$1"
      (( $# >= 2 )) || { echo "tp-claude: $flag needs a value" >&2; exit 2; }
      value="$2"
      shift 2
      ;;
    --append-system-prompt=*|--append-system-prompt-file=*)
      flag="${1%%=*}"
      value="${1#*=}"
      shift
      ;;
    --)
      launch_args+=("$@")
      break
      ;;
    *)
      launch_args+=("$1")
      shift
      continue
      ;;
  esac
  if [[ "$flag" == --append-system-prompt-file ]]; then
    [[ -f "$value" && -r "$value" ]] || { echo "tp-claude: cannot read append-system-prompt-file: $value" >&2; exit 2; }
    # read rather than command substitution: preserve the file's trailing newlines.
    value_from_file=""
    IFS= read -r -d '' value_from_file < "$value" || :
    value="$value_from_file"
  fi
  append_prompt+="$value"$'\n'
done
append_prompt+="$suffix_instruction"

exec claude \
  --setting-sources "" \
  --settings "$settings" \
  --strict-mcp-config "${mcp_args[@]}" \
  --plugin-dir "$CLAUDE_DIR/plugins" \
  --append-system-prompt "$append_prompt" \
  ${launch_args[@]+"${launch_args[@]}"}
