#!/usr/bin/env bash
# tp-claude — run Claude Code with only tmux-pi's settings, plugins and MCP servers.
#
# Skips unrelated user, project and local settings. Uses a dedicated per-machine
# config directory for this workspace's Claude login, trust, and session history.
# Claude Code's built-in skills and plugins still load.
# Extra arguments are passed through to claude. Run `tp-claude-bootstrap` once in
# each target workdir to complete Claude Code's folder-trust prompt before workers run.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
CLAUDE_DIR="$ROOT/claude"
export CLAUDE_CONFIG_DIR="${TP_CLAUDE_CONFIG_DIR:-$HOME/.config/tmux-pi/claude}"
export CLAUDE_CODE_DISABLE_CLAUDE_MDS=1
export CLAUDE_CODE_DISABLE_POLICY_SKILLS=1
export CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
mkdir -p "$CLAUDE_CONFIG_DIR"

settings="$CLAUDE_DIR/settings.json"
# Orchestrator main only: successful Bash output over this many characters is saved
# to a session file by Claude Code, and Claude gets a preview plus the path (default
# 30000). Workers and strict sessions keep the shared file as is. Failure output is
# not affected. The setting is session-wide, so Agent-tool children of main share it.
if [[ -z "${TP_TASK_DIR:-}" && "${TP_MODE:-}" == orchestrator ]]; then
  command -v jq >/dev/null 2>&1 || { echo "tp-claude: jq is required to compose main settings" >&2; exit 1; }
  settings="$(jq -c '. + {bashOutputMaxChars: 10000}' "$settings")" && [[ -n "$settings" ]] ||
    { echo "tp-claude: could not compose main settings from $CLAUDE_DIR/settings.json" >&2; exit 1; }
fi

exec claude \
  --setting-sources "" \
  --settings "$settings" \
  --strict-mcp-config --mcp-config "$CLAUDE_DIR/mcp.json" \
  --plugin-dir "$CLAUDE_DIR/plugins" \
  "$@"
