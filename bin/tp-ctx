#!/usr/bin/env python3
"""tp-ctx — the context engine's command line (CX1: knowledge store, call log, status).

  tp-ctx status                          engine and note-format versions, note counts, cache age, sources, lockfile reader
  tp-ctx knowledge list [--status S]     notes: approved (default), candidate, superseded or all
  tp-ctx knowledge show ID               one note, with its freshness flags
  tp-ctx knowledge add --kind K --scope GLOB... --text T --evidence E...
                                         write a new CANDIDATE note (never approved, never overwrites)
  tp-ctx knowledge approve ID            a person at a terminal approves a candidate: refused without a TTY and refused when
                                         TP_TASK_DIR or TP_TASK_ID is set (a worker); prints the diff, asks for the id
  tp-ctx knowledge audit                 notes flagged stale_by_version / stale_by_path / old, and files that do not parse
  tp-ctx knowledge import --from-work ID --scope GLOB... --evidence E...
                                         offer a work-store note tagged `lesson` as a candidate (same screens)

The project is --project, $TP_CTX_PROJECT, or found from the working directory (a .tmux-pi directory or a .git); notes live in
<project>/.tmux-pi/knowledge/. Every command except `approve` is logged as one JSON line in $TP_TASK_DIR/ctx-calls.jsonl and
answers nothing if it cannot be (exit 3): add and import need a usable $TP_TASK_DIR, as do the query operations the
other lanes add. Only the operator commands list, show, audit and status may run unlogged, and only at a terminal with neither
TP_TASK_DIR nor TP_TASK_ID set; --log FILE is accepted only for those, at a terminal, with neither set. All output passes the redaction
boundary. Exit: 0 answered, 1 no answer (not found, invalid), 2 usage or refusal, 3 not logged.

Commands the other CX lanes add live in modules named in PLUGINS; a module exposes COMMANDS (the first words it handles,
e.g. ctx_brief) and main(argv) -> int, and is called with the whole argument list.
"""
import argparse
import difflib
import importlib
import importlib.util
import json
import os
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from ctxengine import calls, freshness, redact, search, store  # noqa: E402

ENGINE_VERSION = 1
PLUGINS = ("ctxengine.surface",)
VALUE_FLAGS = {"--project", "--log"}
WORKER_ENV = calls.WORKER_ENV
WRITE_COMMANDS = ("add", "import")  # write a candidate: the write and its log line are one step (calls.call exclusive)
OPERATOR_COMMANDS = ("audit", "show", "list", "status")  # a person's commands (approve has its own gates): see calls.py for what that allows


class Usage(Exception):
    pass


def first_word(argv):
    """The first argument that is not an option or an option's value."""
    skip = False
    for arg in argv:
        if skip:
            skip = False
        elif arg in VALUE_FLAGS:
            skip = True
        elif not arg.startswith("-"):
            return arg
    return None


def plugin_for(word):
    for name in PLUGINS:
        try:
            if importlib.util.find_spec(name) is None:
                continue
        except (ImportError, ValueError):
            continue
        module = importlib.import_module(name)
        if word in getattr(module, "COMMANDS", ()):
            return module
    return None


def pin_reader(project):
    """A `pin(name)` callable from L5's lockfile reader when that module is present, else None (versions are then unchecked)."""
    try:
        from localdocs import lock  # noqa: PLC0415
    except ImportError:
        return None
    return lambda name: lock.pin(project, name)


def layout_for(args):
    chosen = args.project
    project = Path(chosen).resolve() if chosen else store.find_project()
    if project is None or not project.is_dir():
        raise Usage("no project: pass --project DIR or run inside a directory with .tmux-pi or .git")
    return store.Layout(project)


def note_view(note, flags=None):
    view = {"id": note.id, "kind": note.kind, "status": note.status, "title": note.headline, "scope": note.scope,
            "tags": note.tags, "source": note.source, "evidence": note.evidence, "created": note.created,
            "last_reviewed": note.last_reviewed, "body": note.body}
    if note.versions:
        view["versions"] = note.versions
    if note.supersedes:
        view["supersedes"] = note.supersedes
    if flags is not None:
        view.update({k: v for k, v in flags.items() if v})
    return view


def note_text(view):
    head = f"{view['id']}  [{view['kind']}, {view['status']}]  {view['title']}"
    extra = []
    if view.get("flags"):
        extra.append("flags: " + ", ".join(view["flags"]))
    if view.get("version_unchecked"):
        extra.append("version not checked: " + ", ".join(view["version_unchecked"]))
    return head + ("\n  " + "\n  ".join(extra) if extra else "")


def assess_all(layout, notes):
    tree, pin = freshness.Tree(layout.project), pin_reader(layout.project)
    return {n.id: freshness.assess(n, layout.project, tree, pin, search.glob_matches, store.today()) for n in notes}


# ----------------------------------------------------------------------------------------------------------- commands

def cmd_status(args, layout):
    notes, invalid = store.scan(layout, ("approved", "candidate", "superseded"))
    counts = {w: sum(1 for n in notes if n.where == w) for w in store.DIRS}
    cache = search._cache_path(layout)
    age = None
    if os.path.isfile(cache) and not os.path.islink(cache):
        age = max(0, int(time.time() - os.stat(cache).st_mtime))
    try:
        sources = store.list_sources(layout)
    except store.StoreError as exc:
        sources = [{"error": str(exc)}]
    info = {"engine": ENGINE_VERSION, "note_format": 1, "python": sys.version.split()[0], "counts": counts,
            "invalid": len(invalid), "cache_age_s": age, "sources": sources,
            "lockfile_reader": "localdocs" if pin_reader(layout.project) else "unavailable"}
    text = "\n".join(f"{k}: {json.dumps(v) if isinstance(v, (dict, list)) else v}" for k, v in info.items())
    return calls.Answer("ok", text, data=info)


def cmd_list(args, layout):
    wheres = list(store.DIRS) if args.status == "all" else [args.status]
    notes = []
    for where in wheres:
        notes += store.scan(layout, (where,))[0]
    if args.tag:
        notes = [n for n in notes if args.tag in n.tags]
    notes.sort(key=lambda n: n.id)
    flags = assess_all(layout, [n for n in notes if n.where != "superseded"])
    views = [note_view(n, flags.get(n.id)) for n in notes]
    text = "\n".join(note_text(v) for v in views) or "no notes"
    return calls.Answer("ok", text, [n.id for n in notes], data={"notes": views})


def cmd_show(args, layout):
    try:
        note = store.get(layout, args.id)
    except store.StoreError as exc:
        return calls.Answer("invalid", str(exc), reason=str(exc))
    flags = assess_all(layout, [note]).get(note.id) if note.where != "superseded" else None
    view = note_view(note, flags)
    text = note_text(view) + f"\n  scope: {', '.join(note.scope)}\n  source: {note.source}\n  evidence: {', '.join(note.evidence)}\n\n{note.body}"
    return calls.Answer("ok", text, [note.id], data={"note": view})


def _candidate_from(args, layout, text, source):
    versions = {}
    for item in args.version or []:
        package, _, spec = item.partition("=")
        versions[package] = spec
    note = store.Note(id=args.id or "", kind=args.kind, scope=list(args.scope), source=source, body=text.strip("\n"),
                      title=args.title or "", tags=list(args.tag or []), versions=versions, evidence=list(args.evidence or []),
                      supersedes=list(args.supersedes or []))
    note.id = note.id or store.new_id(layout, note.title or text)
    return note


def _unlink(path):
    """Take back a candidate whose call could not be logged (calls.call runs this before it gives up)."""
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def _write_candidate(layout, note):
    try:
        path = store.add_candidate(layout, note, screen=redact.screen_note)
    except (store.NoteError, store.StoreError) as exc:
        problems = exc.problems if isinstance(exc, store.NoteError) else [str(exc)]
        message = "invalid note: " + "; ".join(problems)
        return calls.Answer("invalid", message, reason=message)
    except redact.Refused as refusal:
        return calls.Answer("refused", str(refusal), reason=str(refusal))
    rel = os.path.relpath(path, layout.project)
    return calls.Answer("ok", f"{note.id} written as a candidate ({rel}); it is not approved", [note.id],
                        data={"id": note.id, "status": "candidate", "path": rel}, undo=lambda: _unlink(path))


def cmd_add(args, layout):
    source = args.source or (f"worker:{os.environ['TP_TASK_ID']}" if os.environ.get("TP_TASK_ID") else "human")
    return _write_candidate(layout, _candidate_from(args, layout, args.text, source))


def cmd_import(args, layout):
    try:
        doc = redact.work_note(args.from_work)
    except redact.Refused as refusal:
        return calls.Answer("refused" if "private" in str(refusal) else "invalid", str(refusal), reason=str(refusal))
    args.kind = args.kind or "lesson"
    args.title = args.title or str(doc.meta.get("title", ""))[:store.TITLE_MAX]
    return _write_candidate(layout, _candidate_from(args, layout, doc.body, f"work:{doc.id}"))


def cmd_audit(args, layout):
    notes, invalid = store.scan(layout, ("approved", "candidate"))
    flags = assess_all(layout, notes)
    rows = []
    for note in sorted(notes, key=lambda n: n.id):
        verdict = flags[note.id]
        if verdict.get("flags") or verdict.get("age_days"):
            rows.append({"id": note.id, "status": note.status, **{k: v for k, v in verdict.items() if v}})
    lines = [f"{r['id']} ({r['status']}): {', '.join(r['flags']) or 'old'}" + (f", {r['age_days']} days since review" if r.get("age_days") else "")
             + "".join(f"\n  {reason}" for reason in r.get("path_reasons", [])) for r in rows]
    lines += [f"invalid {bad['path']}: {'; '.join(bad['problems'])}" for bad in invalid]
    return calls.Answer("ok", "\n".join(lines) or "nothing flagged", [r["id"] for r in rows], data={"flagged": rows, "invalid": invalid})


def refuse_worker(env=None):
    env = os.environ if env is None else env
    set_names = [name for name in WORKER_ENV if env.get(name)]
    if set_names:
        raise Usage(f"refused: {', '.join(set_names)} in the environment marks a worker's shell; approval is for a person at a terminal")


def cmd_approve(args):
    refuse_worker()
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise Usage("refused: approval needs an interactive terminal on stdin and stdout")
    layout = layout_for(args)
    try:
        plan = store.approve_plan(layout, args.id, screen=redact.screen_note)
    except (store.NoteError, store.StoreError) as exc:
        raise Usage("not approved: " + (str(exc) or "invalid note")) from None
    candidate, approved, text, replaced = plan
    new = text.splitlines(keepends=True)
    diff = "".join(difflib.unified_diff([], new, "/dev/null", f"b/.tmux-pi/knowledge/approved/{approved.id}.md"))
    out = [f"diff --git a/candidates/{approved.id}.md b/approved/{approved.id}.md", "new file mode 100644", diff]
    out += [f"supersedes {old.id}: {old.headline}  (moves to superseded/)" for old in replaced]
    print(redact.guard("\n".join(out)))
    answer = input(f"Type the note id to approve it ({approved.id}): ")
    if answer.strip() != approved.id:
        print("not approved: the id did not match; nothing was changed")
        return 1
    where = store.approve_apply(layout, plan)
    print(f"approved: {os.path.relpath(where, layout.project)}")
    return 0


COMMANDS = {"status": cmd_status, "list": cmd_list, "show": cmd_show, "add": cmd_add, "import": cmd_import, "audit": cmd_audit}


# ---------------------------------------------------------------------------------------------------------------- main

def build_parser():
    parser = argparse.ArgumentParser(prog="tp-ctx", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--project", help="project directory (default: $TP_CTX_PROJECT, else found from the working directory)")
    parser.add_argument("--log", help="call log file (default: $TP_TASK_DIR/ctx-calls.jsonl); only for an operator command (list, show, audit, "
                                      "status) run by a person at a terminal with no TP_TASK_DIR or TP_TASK_ID")
    parser.add_argument("--json", action="store_true", help="print {status, text, ...data} as JSON")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    know = sub.add_parser("knowledge")
    ks = know.add_subparsers(dest="action", required=True)
    one = ks.add_parser("list")
    one.add_argument("--status", choices=["approved", "candidate", "superseded", "all"], default="approved")
    one.add_argument("--tag")
    two = ks.add_parser("show")
    two.add_argument("id")
    for name in ("add", "import"):
        sp = ks.add_parser(name)
        if name == "add":
            sp.add_argument("--kind", required=True, choices=store.KINDS)
            sp.add_argument("--text", required=True)
        else:
            sp.add_argument("--from-work", required=True)
            sp.add_argument("--kind", choices=store.KINDS)
            sp.set_defaults(text=None)
        sp.add_argument("--scope", action="append", required=True)
        sp.add_argument("--evidence", action="append", required=True)
        sp.add_argument("--title")
        sp.add_argument("--tag", action="append")
        sp.add_argument("--version", action="append", metavar="PKG=RANGE")
        sp.add_argument("--source")
        sp.add_argument("--supersedes", action="append")
        sp.add_argument("--id")
    three = ks.add_parser("approve")
    three.add_argument("id")
    ks.add_parser("audit")
    return parser


def emit(args, answer):
    if args.json:
        payload = {"status": answer.status, "text": answer.text}
        if isinstance(answer.data, dict):
            payload.update(answer.data)
        print(json.dumps(redact.guard_json(payload), ensure_ascii=False))
    else:
        print(redact.guard(answer.text))


def hoist_globals(argv):
    """Move --json, --project X and --log X (also --project=X) to the front, so they work after the subcommand too."""
    front, rest, i = [], [], 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--json" or arg.startswith(("--project=", "--log=")):
            front.append(arg)
        elif arg in VALUE_FLAGS and i + 1 < len(argv):
            front += [arg, argv[i + 1]]
            i += 1
        else:
            rest.append(arg)
        i += 1
    return front + rest


def main(argv=None):
    argv = hoist_globals(list(sys.argv[1:] if argv is None else argv))
    word = first_word(argv)
    if word and word not in ("status", "knowledge"):
        module = plugin_for(word)
        if module:
            return module.main(argv)
    args = build_parser().parse_args(argv)
    if args.command == "knowledge" and args.action == "approve":
        try:
            return cmd_approve(args)
        except Usage as exc:
            print(redact.guard(str(exc)), file=sys.stderr)
            return 2
    name = "status" if args.command == "status" else args.action
    tool = "status" if name == "status" else f"knowledge.{name}"

    def run():
        try:
            layout = layout_for(args)
        except Usage as exc:
            return calls.Answer("no_project", str(exc), reason=str(exc))
        return COMMANDS[name](args, layout)

    params = {k: v for k, v in vars(args).items() if k not in ("command", "action", "json", "log", "project") and v is not None}
    try:
        answer = calls.call(tool, params, run, log_file=args.log, operator=name in OPERATOR_COMMANDS, exclusive=name in WRITE_COMMANDS)
    except calls.LogUnavailable as exc:
        print(f"tp-ctx: {redact.guard(str(exc))}", file=sys.stderr)
        return 3
    except KeyboardInterrupt:
        return 130
    if answer.status != "ok" and not args.json:
        print(redact.guard(answer.text), file=sys.stderr)
    else:
        emit(args, answer)
    return EXIT[answer.status]


EXIT = {"ok": 0, "invalid": 1, "error": 1, "stale_index": 1, "unavailable": 1, "refused": 2, "no_project": 2}


if __name__ == "__main__":
    sys.exit(main())
