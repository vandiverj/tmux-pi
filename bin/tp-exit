#!/usr/bin/env bash
# tp-exit — stop every tmux-pi process and destroy its tmux session.
#
# Usage: tp-exit
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
source "$ROOT/lib/tp.sh"

session="$(tp_session)"

# This stops tracked and untracked workers and restores the viewer before the
# session itself (and therefore its main, status, and viewer panes) is killed.
# Unlike tp-reset, ending a workspace must not leave worker task records to be
# redisplayed as killed workers when the same workdir is opened again. Retain or
# archive task records according to the retention policy; never delete blindly.
state_dir="$(tp_opt "$session" @tp_state_dir)"
# Checkpoint the attached workspaces first, while the task records still say what happened; it never blocks the exit.
if [[ -n "$state_dir" ]]; then
  TP_STATE_DIR="$state_dir" TP_WORK_LOCK_TIMEOUT=2 "$ROOT/bin/tp-agent" work checkpoint --auto --trigger session-end >/dev/null 2>&1 || true
fi
"$ROOT/bin/tp-reset" >/dev/null 2>&1 || true
"$ROOT/bin/tp-task" --state-dir "$state_dir" end-session >/dev/null 2>&1 || true

if tmux has-session -t "=$session" 2>/dev/null; then
  tmux kill-session -t "=$session"
fi
