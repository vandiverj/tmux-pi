#!/usr/bin/env python3
"""Adaptive goal state CLI. This CLI never spawns or authorizes worker/edit tools."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from goal import GoalError, command, plan, gate_input, gate_attempt, pending_task  # noqa: E402


def main():
    p = argparse.ArgumentParser(description="Cooperative goal-turn ledger; dispatcher still owns per-turn authority")
    p.add_argument("--project", default=".", help="absolute approved workdir or current directory")
    sub = p.add_subparsers(dest="action", required=True)
    sub.add_parser("plan").add_argument("--spec", required=True)
    for action in ("start", "status", "reconcile", "admit", "poll", "pause", "stop", "resolve", "resume", "usage", "link-task", "link-reviewer", "settle", "pending", "gate-input", "gate-attempt"):
        cmd = sub.add_parser(action)
        cmd.add_argument("id")
        if action in ("start", "resume", "resolve"):
            cmd.add_argument("--confirm", required=True)
        if action == "start":
            cmd.add_argument("--approve-sha256", required=True)
        if action == "pause":
            cmd.add_argument("--reason", required=True)
        if action == "resume":
            cmd.add_argument("--diagnosis", required=True)
        if action == "resolve":
            cmd.add_argument("--evidence", required=True, help="human-inspected proof old turn cannot still run")
        if action in ("usage", "link-task", "settle", "pending", "gate-input", "gate-attempt"):
            cmd.add_argument("--ticket", required=True)
        if action in ("gate-input", "gate-attempt"):
            cmd.add_argument("--spec-sha256", required=True)
        if action == "gate-attempt":
            for field in ("main", "decision", "preflight", "policy"):
                cmd.add_argument("--" + field + "-json", required=True)
        if action == "link-reviewer":
            cmd.add_argument("--author-id", required=True)
            cmd.add_argument("--reviewer-id", required=True)
        if action == "usage":
            cmd.add_argument("--event-id", required=True)
            for name in ("turns", "tokens", "cost-micros"):
                cmd.add_argument("--" + name, required=True, type=int)
        if action == "link-task":
            cmd.add_argument("--task-id", required=True)
        if action == "settle":
            cmd.add_argument("--outcome", required=True, choices=("progress", "wait", "no_progress", "safety_block", "complete"))
            cmd.add_argument("--evidence", required=True)
            cmd.add_argument("--blocker")
    args = p.parse_args()
    try:
        if args.action == "plan":
            with open(args.spec, encoding="utf-8") as f:
                result = plan(args.project, json.load(f))
        elif args.action == "pending":
            result = pending_task(args.project, args.id, args.ticket)
        elif args.action == "gate-input":
            result = gate_input(args.project, args.id, args.ticket, args.spec_sha256)
        elif args.action == "gate-attempt":
            payload = {name: json.loads(getattr(args, name + "_json")) for name in ("main", "decision", "preflight", "policy")}
            result = gate_attempt(args.project, args.id, args.ticket, args.spec_sha256, **payload)
        else:
            opts = vars(args).copy()
            for name in ("action", "project", "id"):
                opts.pop(name)
            result = command(args.project, args.id, args.action, **opts)
        print(json.dumps(result, sort_keys=True, indent=2))
    except (GoalError, OSError, ValueError) as exc:
        p.exit(2, "tp-goal: " + str(exc) + "\n")


if __name__ == "__main__":
    main()
