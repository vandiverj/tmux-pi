#!/usr/bin/env bash
# tp-kill — stop a subagent and close its window. Its task files are kept.
#
# Usage: tp-kill <id>
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
source "$ROOT/lib/tp.sh"

[[ $# -eq 1 ]] || die "usage: tp-kill <id>"
id="$1"
session="$(tp_session)"
task_dir="$(tp_task_dir "$session" "$id")"
[[ -f "$task_dir/meta.json" ]] || die "no subagent '$id'"
pane="$(tp_meta "$task_dir" pane)"
helper="$ROOT/lib/worker_process.py"

# Read and record the pane's process before anything is written or ended; an unreadable or invalid one refuses here
# and leaves the pane and the task as they were.
python3 "$helper" prepare "$task_dir" "$pane"

# Never kill a pane while it sits in the viewer slot; that would break the layout.
if [[ "$(tp_opt "$session" @tp_viewing)" == "$id" ]]; then
  "$ROOT/bin/tp-view" -
fi
# Kill the pane, escalate on its process group (kill-pane only hangs it up) and confirm it gone. stopped.json is written
# only after that; a survivor exits non-zero, named, and stays recorded in process.json for `tp-agent reap`.
python3 "$helper" finish "$task_dir" "$pane"
printf '{"stopped":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$task_dir/stopped.json.tmp"
mv "$task_dir/stopped.json.tmp" "$task_dir/stopped.json"
