#!/usr/bin/env bash
# tp-list — list subagents in the tmux-pi session (newest last).
#
# Usage: tp-list
#
# ▸ marks the subagent shown in the viewer slot. The current tool, if any, is
# shown on the line below.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
source "$ROOT/lib/tp.sh"

session="$(tp_session)"
current="$(tp_opt "$session" @tp_viewing)"

rows="$(tp_rows "$session")"
if [[ -z "$rows" ]]; then echo "  no subagents"; exit 0; fi
while IFS=$'\x1f' read -r id worker status tool tokens cost model; do
  mark=" "; if [[ "$id" == "$current" ]]; then mark="▸"; fi
  # Pad by characters, not bytes (▸ ↑ ↓ are multibyte).
  printf '%s %s%*s%s%*s%s%*s%s%*s%s%*s%s\n' "$mark" \
    "$id" $((22 - ${#id})) "" "$worker" $((8 - ${#worker})) "" "$status" $((11 - ${#status})) "" \
    "$tokens" $((16 - ${#tokens})) "" "$cost" $((8 - ${#cost})) "" "$model"
  if [[ -n "$tool" ]]; then printf '    %s\n' "$tool"; fi
done <<<"$rows"
