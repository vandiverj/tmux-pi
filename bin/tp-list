#!/usr/bin/env bash
# tp-list — list subagents in the tmux-pi session (newest last).
#
# Usage: tp-list
#
# ▸ marks the subagent shown in the viewer slot. States: starting, working,
# needs_input, paused, settled, completed, failed, killed, stopped, escalated. The line below
# shows elapsed time, turns and tool calls, contract checkpoints, the current tool,
# and for settled work the first line of its reply (bin/tp-contract status).
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
source "$ROOT/lib/tp.sh"

session="$(tp_session)"
current="$(tp_opt "$session" @tp_viewing)"
state_dir="$(tp_opt "$session" @tp_state_dir)"

rows="$(tp_rows "$session")"
if [[ -z "$rows" && ! -d "$state_dir/queue" ]]; then echo "  no subagents"; exit 0; fi
details="$("$ROOT/bin/tp-contract" status 2>/dev/null || true)"
# One process works out every row's status, detail and padding (lib/tp_detail.py --list); it used to be a jq/awk chain per row.
if [[ -n "$rows" ]]; then python3 "$ROOT/lib/tp_detail.py" --list "$state_dir/tasks" "$details" "$current" <<<"$rows"; fi
tp_queue_lines "$state_dir"
