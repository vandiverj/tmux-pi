#!/usr/bin/env bash
# Run the same orchestrator role through either supported main harness.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$ROOT/bin:$PATH"
harness="${TP_MAIN_HARNESS:-pi}"
# Restore the launch directory even if login-shell startup changed cwd.
if [[ -n "${TP_WORKDIR:-}" ]]; then
  cd -- "$TP_WORKDIR"
fi
export TP_MODE=orchestrator
# A main's identity, recorded on every task it dispatches (tp-agent main_id) and matched by `tp-agent list --main`. The harness's
# own session id is not it: Claude Code starts a new one on /clear and on --resume, which cut a main off from its workers.
# Made here, not in bin/tp, because this is what a relaunch runs, and kept in the session's state directory, which every
# relaunch in the same tmux session shares (bin/tp exports TP_STATE_DIR to the pane and the session): the same main keeps its id
# across /clear, --resume, compaction and a second tp-main. Inherited by everything the harness starts (Bash tool, claude -p,
# subagents, background shells). The id exported always matches the pattern: a TP_MAIN_ID given at launch and valid is kept
# and written to the file (a later launch without it keeps it); an empty or bad file is replaced with a fresh id.
id_pattern='^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$'
idfile="${TP_STATE_DIR:+$TP_STATE_DIR/main-id}"
have_dir=0
[[ -n "$idfile" && -d "$TP_STATE_DIR" ]] && have_dir=1
if [[ "${TP_MAIN_ID:-}" =~ $id_pattern ]]; then
  if [[ "$have_dir" == 1 ]]; then
    { printf '%s\n' "$TP_MAIN_ID" > "$idfile.$$" && mv -f "$idfile.$$" "$idfile"; } 2>/dev/null ||
      { rm -f "$idfile.$$"; echo "tp-main: could not record TP_MAIN_ID in $idfile; a later launch without it will not keep this id" >&2; }
  fi
else
  fresh="main-$(python3 -c 'import uuid; print(uuid.uuid4().hex[:16])')"
  main_id="$fresh"
  if [[ "$have_dir" == 1 ]]; then
    main_id="$(cat "$idfile" 2>/dev/null || true)"
    if ! [[ "$main_id" =~ $id_pattern ]]; then
      rm -f "$idfile" 2>/dev/null || true  # an empty file, or one with a bad id in it, is replaced
      # ln fails when the file exists: of two launches racing, the first id wins and both read it back.
      printf '%s\n' "$fresh" > "$idfile.$$" 2>/dev/null && { ln "$idfile.$$" "$idfile" 2>/dev/null || true; }
      rm -f "$idfile.$$" 2>/dev/null || true
      main_id="$(cat "$idfile" 2>/dev/null || true)"
      if ! [[ "$main_id" =~ $id_pattern ]]; then
        main_id="$fresh"
        echo "tp-main: could not read the main id back from $idfile; using $fresh for this launch only" >&2
      fi
    fi
  fi
  export TP_MAIN_ID="$main_id"
fi
core="$(cat "$ROOT/agent/orchestrator.md")"
case "$harness" in
  pi)
    exec "$ROOT/bin/tp-pi" --append-system-prompt "$core

$(cat "$ROOT/agent/orchestrator-pi.md")" "$@"
    ;;
  claude)
    exec "$ROOT/bin/tp-claude" --allowedTools "Bash(tp-agent:*)" --append-system-prompt "$core

$(cat "$ROOT/agent/orchestrator-claude.md")" "$@"
    ;;
  *) echo "tp-main: unsupported harness: $harness" >&2; exit 2 ;;
esac
