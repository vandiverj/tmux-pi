#!/usr/bin/env bash
# tp-pi — run pi with only tmux-pi's config and extensions.
#
# Ignores ~/.pi/agent (PI_CODING_AGENT_DIR=agent/), ~/.agents/skills and
# project skill dirs (--no-skills). The private catalogue selects task-specific
# skill handles; no growing Pi skill inventory is advertised to every model.
# Extra arguments are passed through to pi.
#
# The orchestrator main (TP_TASK_DIR unset and TP_MODE=orchestrator, as set by
# tp-main) also gets Pi's built-in codemode, with --tools naming every main
# tool: --tools replaces the whole selection, so a tool missing from MAIN_TOOLS
# is silently dropped (tests/test_pi_launcher.py checks the list against the
# extensions). Codemode scripts can call every tool in that list, bash, edit and
# write included; it is not a read-only boundary. --no-extensions already keeps
# Pi's built-in MCP support off here; --no-mcp states that explicitly. Workers,
# strict sessions and the ask_local child (which passes its own --tools and
# clears TP_MODE) get none of this.
set -euo pipefail

MAIN_TOOLS=read,bash,edit,write,grep,find,ls,codemode,dispatch_role,task_index,task_collect,tmux_pi_find_skill,ask_local,tool_output,safe_read,safe_grep

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"

# Pi runs on its own pinned Node, not the `node` a project's mise/nvm puts first on
# PATH: a repo pinned to Node 22.14 lacks zlib zstd and pi crashes reading responses.
# Only pi's process uses it; PATH is unchanged, so commands pi runs keep the project's
# Node. TP_PI_NODE overrides the interpreter; set it empty to run `pi` from PATH.
PI_NODE="${TP_PI_NODE-$HOME/.nvm/versions/node/v24.16.0/bin/node}"
pi() {
  [[ -n "$PI_NODE" ]] || exec pi "$@"
  if [[ ! -x "$PI_NODE" || ! -e "$(dirname "$PI_NODE")/pi" ]]; then
    echo "tp-pi: pi is pinned to $PI_NODE with pi installed beside it; run" \
      "'nvm install 24.16.0' and that Node's 'npm install -g @earendil-works/pi-coding-agent'," \
      "or set TP_PI_NODE" >&2
    exit 1
  fi
  exec "$PI_NODE" "$(dirname "$PI_NODE")/pi" "$@"
}

export PI_CODING_AGENT_DIR="$ROOT/agent"
# agent/settings.json is local state (pi rewrites it); seed it from the template once, never overwrite.
[[ -e "$ROOT/agent/settings.json" || ! -f "$ROOT/agent/settings.example.json" ]] ||
  cp "$ROOT/agent/settings.example.json" "$ROOT/agent/settings.json"
# Auth for the MCP servers in agent/mcp.json (git-ignored; shared with tp-claude).
[[ ! -f "$ROOT/claude/mcp.local.env" ]] || source "$ROOT/claude/mcp.local.env"
if [[ "${TP_MODE:-}" == strict ]]; then
  pi --no-skills "$@"
fi

# Normal work loads only the orchestration extensions. Legacy goal, strict
# dispatcher, generic subagent, and automatic escalation code remain available
# for explicit legacy sessions but cannot quietly join this workflow.
extensions=("$ROOT/agent/extensions/reporter.ts" "$ROOT/agent/extensions/sensitive.ts" "$ROOT/agent/extensions/safe.ts")
if [[ -z "${TP_TASK_DIR:-}" ]]; then
  extensions+=("$ROOT/agent/extensions/orchestration.ts" "$ROOT/agent/extensions/assistant.ts" "$ROOT/agent/extensions/catalogue.ts" "$ROOT/agent/extensions/offload.ts")
fi
args=(--no-skills --no-context-files --no-extensions)
for extension in "${extensions[@]}"; do args+=(--extension "$extension"); done
if [[ -z "${TP_TASK_DIR:-}" && "${TP_MODE:-}" == orchestrator ]]; then
  args+=(--extension builtin:codemode --no-mcp --tools "$MAIN_TOOLS")
fi
pi "${args[@]}" "$@"
