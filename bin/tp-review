#!/usr/bin/env bash
# tp-review — spawn a cross-provider reviewer for a completed tmux-pi task.
#
# Usage: tp-review [--force] <task-id>
#
# Consults the review policy (tp-route --review) on the author's task first. When
# the policy says `none`, no reviewer starts and tp-review exits 3; --force skips
# the policy. If the policy can't be reached, the review runs anyway.
# The review packet contains the original task, any follow-up requests, the result, and the
# selected context packet.
# The reviewer must be on the opposite provider (pi <-> claude) from the author.
# Prints the review task id.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
source "$ROOT/lib/tp.sh"

usage() { echo "usage: tp-review [--force] <task-id>" >&2; exit "${1:-1}"; }
force=0
if [[ "${1:-}" == --force ]]; then force=1; shift; fi
[[ $# -eq 1 ]] || usage
id="$1"
[[ "$id" =~ ^[[:alnum:]_.-]+$ ]] || die "bad task id: $id"

session="$(tp_session)"
state_dir="$(tp_opt "$session" @tp_state_dir)"
dir="$state_dir/tasks/$id"
[[ -f "$dir/meta.json" ]] || die "no subagent '$id'"
[[ ! -f "$dir/pending-capability.json" ]] || die "subagent '$id' is waiting for human capability approval; review is blocked"
[[ -f "$dir/result.md" ]] || die "subagent '$id' has no result yet"
# Interactive Pi/Claude sessions remain alive after replying and report `waiting`.
# Accept that settled state as well as a cleanly exited worker.
completed=0
[[ -f "$dir/exit" && "$(cat "$dir/exit")" == 0 ]] && completed=1
if [[ "$completed" != 1 ]]; then
  state="$(jq -r '.state // empty' "$dir/state.json" 2>/dev/null || true)"
  [[ "$state" == waiting ]] || die "subagent '$id' has not completed successfully (state: ${state:-starting})"
fi

# Slice 6/R1: review policy classifies the verbatim request. The canonical
# task record remains contextual evidence in the reviewer packet below.
route_tmp=""
route_file="$dir/request.md"
if [[ ! -f "$route_file" ]]; then
  route_tmp="$(mktemp)"
  python3 - "$ROOT" "$dir" > "$route_tmp" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1] + "/lib")
from task_record import request_text
print(request_text(sys.argv[2]))
EOF
  route_file="$route_tmp"
fi
cleanup_route_tmp() { [[ -z "$route_tmp" ]] || rm -f "$route_tmp"; }
trap cleanup_route_tmp EXIT
if [[ "$force" == 1 ]]; then
  policy=forced
elif out="$("$ROOT/bin/tp-route" --review --file "$route_file")"; then
  policy="$(jq -r '.review' <<<"$out")"
else
  echo "tp-review: review policy unavailable; reviewing anyway" >&2
  policy=unavailable
fi
if [[ "$policy" == none ]]; then
  echo "tp-review: review not needed for '$id' (policy: none); use --force to review anyway" >&2
  exit 3
fi

worker="$(tp_meta "$dir" worker)"
case "$worker" in
  pi) reviewer=claude; model=claude-sonnet-5-5; thinking=medium ;;
  claude) reviewer=pi; model=openai-codex/gpt-6-sol; thinking=medium ;;
  *) die "subagent '$id' has unknown worker '$worker'" ;;
esac

review_task="Review the completed work from subagent '$id'. You are an independent reviewer, not the implementer. Inspect the supplied task, context packet, and result, then inspect the working tree and relevant files as needed. Identify concrete correctness, regression, security, or requirement gaps. Do not change files. The first line of your final reply must be exactly APPROVED or REQUEST_CHANGES, with no Markdown or other formatting. Follow it with a brief rationale or prioritized actionable findings including file paths and line references when possible."

# A research report (M9) is checked for source support rather than code changes.
extra=()
if [[ "$(jq -r '.contract.kind // empty' "$dir/meta.json")" == research ]]; then
  report="$(jq -r '.contract.artifact' "$dir/meta.json")"
  review_task="Review the research report from subagent '$id' at $report (read it in full; the author's final reply is only a summary). You are an independent reviewer. Check each important claim against its cited source where you can reach it: is it supported by a primary source, only by the report's own reasoning, or by nothing? Name hidden assumptions, say whether the conclusions apply to this project's workflow, and note any local measurement or repository fact that contradicts the report. Classify the key claims as verified, report-derived, background knowledge, or synthesis. Do not change files. The first line of your final reply must be exactly APPROVED or REQUEST_CHANGES, with no Markdown or other formatting. Follow it with a brief rationale or prioritized findings (unsupported or wrong claims first)."
  extra=(--note "Research report: $report")
fi

# Messages the user sent the author after its task (written by the dispatcher) are part of what it was asked to do.
followups=()
if [[ -s "$dir/followups.md" ]]; then followups=(--context "$dir/followups.md"); fi
if ! review_id="$("$ROOT/bin/tp-spawn" --worker "$reviewer" --model "$model" --thinking "$thinking" --name "review-$id" \
  --context "$dir/task.md" ${followups[@]+"${followups[@]}"} --context "$dir/packet.md" --context "$dir/result.md" \
  --note "Author task id: $id" ${extra[@]+"${extra[@]}"} \
  --note "Review policy: $policy" \
  --note "The author used worker: $worker. You must independently review; do not accept assertions without checking." \
  -- "$review_task")"; then
  die "opposite-provider reviewer '$reviewer' could not start; ask the human (no same-provider substitute or silent skip)"
fi

jq --arg review "$review_id" --arg reviewer "$reviewer" --arg model "$model" --arg thinking "$thinking" \
  --arg policy "$policy" \
  '. + {review:$review, review_policy:$policy, reviewer:{worker:$reviewer, model:$model, thinking:$thinking}}' \
  "$dir/meta.json" > "$dir/meta.json.tmp"
mv "$dir/meta.json.tmp" "$dir/meta.json"
printf '%s\n' "$id" > "$(tp_task_dir "$session" "$review_id")/review-of"
printf '%s\n' "$review_id"
