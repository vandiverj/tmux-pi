#!/usr/bin/env bash
# tp-review — spawn an independent reviewer for a completed tmux-pi task.
#
# Usage: tp-review [--force] [--force-alive] [--level KEY] [--thinking EFFORT] [--approve-effort] [--evidence FILE]... [--contract FILE] [--dispositions FILE] <task-id>
#
# Asks the model router for a review plan (tp-route --review-plan): whether a review is needed
# (the larger of a deterministic policy over role, files touched, level and effort and the
# router's review field recorded at dispatch) and who reviews. When no review is needed no
# reviewer starts and tp-review exits 3; --force skips the need check. The reviewer is on a
# different provider from the author when one is available (GPT first for Claude- or
# Qwen-authored work), at least mid level. A required review with no independent provider
# stops and asks the human; an optional one may use the author's provider, marked in the record.
# The review packet contains the original task, any follow-up requests, the result, and the
# selected context packet, in this order, claims last (packet_order "claims-last:v1", recorded in the review task's meta.json):
#   (a) the request as given (request.md; for a task record from before request.md existed, the request as task_record.request_text
#       reads it from task.md; its briefs and acceptance list are found in that text the same way), the briefs it names that passed the checks, the follow-up requests, and the acceptance list of the
#       --contract file when it has one (the contract itself stays in (f)); the task text names the item numbers
#   (b) scope, the file `diff-scope.md`: the changed files and scoped git commands (outside git and for a research report: no file)
#   (c) the diff of the current tree against the review base, round 1 included (lib/review_rounds.py diff_now): the last reviewed
#       state when an earlier round recorded one, else the lane's last closed step, else the lane base, else HEAD for a task
#       outside a lane; sensitive paths withheld, secrets redacted, split into labelled segments when large. It is a diff of the
#       working tree as it is (base to files). For a path where HEAD or the index differs from the files, the end of (c) adds, per path
#       and only when non-empty, "Committed since the base, not in the working files:" (base to HEAD) and "Staged, not in the working
#       files:" (HEAD to index), withheld and redacted like the main diff; the same function serves round 1 and later rounds, and
#       the scope (b) names each comparison exactly. The scope's path list is the paths of (c) itself (the main diff and every
#       section; prepare writes scope-input.json and scope reads it with --input), never recomputed; with no commit yet its
#       commands name the empty tree where they would name HEAD
#   (d) the earlier review rounds' findings, oldest first
#   (e) the timer waits in added test lines
#   (f) what Main supplied: --evidence files, --contract, --dispositions, then the --sweep file
#   then, under one heading file `Author's account (read after forming your own findings)`:
#   (g) the author's packet, (h) the author's result, (i) task.md (Main's Orient/Frame and the request as recorded)
# The task text tells the reviewer to form its findings from (c) and the tree first and to check each claim in (g) to (i) against them.
# The packet budget is the same as before the order changed: a packet that cannot hold everything is refused, never trimmed.
# On a retried task (or a task reviewed before) the diff (c) is the one since the last reviewed state and (d) holds the earlier review
# rounds' findings, oldest first (lib/review_rounds.py).
# The reply's first line is APPROVED, APPROVED_WITH_NOTES or REQUEST_CHANGES (lib/review_verdict.py).
# --force-alive skips the checks that end the author's process and look for a writer on the working tree (this session's
# tasks). It does NOT apply to a lane's working tree: a lane's one writer is enforced by the lane's lease, shared by every
# session, and a reviewer is refused beside a live writer whatever flags are given. To review a lane task, end its writer:
# `tp-agent stop <writer task id>` (the id and session are named in the refusal), then run tp-review again.
# --same-provider --approved-by-user "QUOTE": a reviewer from the author's own provider, for when the user has approved that (for
# example the other provider is out of credits). The quote is required and recorded; the plan, the author's record and the
# reviewer's packet say `same_provider_user_approved`. The default is unchanged: no silent same-provider substitute.
# --evidence FILE (repeatable): Main attaches a check output (a count, log or command output the author's report lacks, for
# example what a `Closes by: check` note asked for) to the packet, in order, each under the heading `Evidence supplied by Main:
# <file name>`. The task text tells the reviewer it was produced by the orchestrator, not the author, and can be checked like any
# other claim. tp-review attaches it as it is and does not check that it is true.
# --contract FILE (once): Main attaches the reviewer contract (for a review started without a brief) under `Reviewer contract
# (supplied by Main)`; the task text says to judge the work against it together with the task.
# --dispositions FILE (once, any round): Main attaches what it has ruled on in earlier rounds under `Dispositions of earlier findings
# (supplied by Main)`; the task text says a finding listed there is closed, to be raised again only if the tree changed in a way that
# reopens it, citing the disposition and the change. tp-review does not check the file against the earlier findings.
# All three count against the packet budget like the author's evidence and are split into labelled segments when large; a packet that
# cannot hold them is refused, never trimmed. A file that is missing, not a regular file, unreadable or empty, one named `.env*`,
# and one inside the trust store is refused, naming the file, before any reviewer starts. The flags do not change the verdict rules,
# except the acceptance rule below.
# --sweep FILE (once; tp-agent review passes it for a task dispatched with a sweep.md, the file the harness generates for a gated retry,
# lib/family_sweep.py): the sweep and the coder's `Site | Disposition | Evidence` table, read from the task dir's report.md when it has one, else the author's result (fail closed: an unreadable or missing named report.md is an open row), are attached as
# one context file (`sweep-review.md`); the task text asks the reviewer to confirm each row against the tree and to add every site the
# table missed as a row with the sweep's Family: name. The sites of the `unresolved` rows with no `Closes by:` note in their Evidence are
# recorded beside the review's result (sweep-rows.json) so that lib/review_verdict.py calls an approval of that reply incomplete; a
# REQUEST_CHANGES is not touched. Without --sweep nothing changes. A file that is missing, empty or refused as --evidence is refused.
# Acceptance criteria: when the task's request, a brief the request names (every absolute path ending in .md that passes the checks
# --contract gets; one that does not is noted in the task text as not read, never an error), or the --contract file, has a numbered list
# under a heading `Done means` or `Acceptance criteria` (the lists are merged; an item number counts once), the task text asks for a section headed `Acceptance criteria` with one line per item (number; met, not met or not
# checked; evidence), and the item numbers are recorded beside the review's result (acceptance-items.json) so that
# lib/review_verdict.py calls a reply without that section, or naming fewer item numbers, incomplete. Without such a list nothing changes.
# A lane task's changed-file list and scoped commands start from the lane's last closed step (the lane base when it has none, or its
# commit is not an ancestor of HEAD), and the text names the base used (lib/review_rounds.py scope). The packet also carries a file
# `Timer waits in added test lines` (lib/review_rounds.py timers): the added test lines that call setTimeout(, sleep(, delay(, ...).
# Prints the review task id.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
source "$ROOT/lib/tp.sh"
PACKET_ORDER="claims-last:v1"   # recorded as packet_order in the review task's meta.json; change it whenever the order below changes

usage() {
  echo "usage: tp-review [--force] [--force-alive] [--level KEY] [--thinking EFFORT] [--approve-effort] [--evidence FILE]... [--contract FILE] [--dispositions FILE] [--sweep FILE] <task-id>" >&2
  echo "  --sweep FILE (once): attach the sweep and the coder's table for it; the reviewer confirms each row, and an approval is incomplete while a row is unresolved with no Closes by: note" >&2
  echo "  --evidence FILE (repeatable): attach a check output Main produced to the packet, under 'Evidence supplied by Main: <file name>'; the reviewer is told it is not the author's" >&2
  echo "  --contract FILE (once): attach the reviewer contract under 'Reviewer contract (supplied by Main)'; the reviewer judges the work against it with the task" >&2
  echo "  --dispositions FILE (once): attach what Main ruled on in earlier rounds under 'Dispositions of earlier findings (supplied by Main)'; a finding listed there is closed unless the tree changed in a way that reopens it" >&2
  echo "  a numbered list under 'Done means' or 'Acceptance criteria' in the request, a .md brief it names, or the contract makes the reviewer answer each item in an 'Acceptance criteria' section (a reply without it is incomplete)" >&2
  echo "  --same-provider --approved-by-user QUOTE: review on the author's own provider, only with the user's approval (quoted, recorded)" >&2
  echo "  --force-alive skips ending the author and the session's writer check; it does not apply to a lane's tree (end the writer: tp-agent stop ID)" >&2
  exit "${1:-1}"
}
force=0 force_alive=0 plan_opts=() same_provider=0 approval="" evidence=() contract="" have_contract=0 dispositions="" have_dispositions=0 sweep="" have_sweep=0   # have_*, not -n "$contract": an empty value is a missing file, not no file
[[ "${1:-}" != -h && "${1:-}" != --help ]] || usage 0
while [[ $# -gt 1 ]]; do
  case "$1" in
    --force) force=1; shift ;;
    --force-alive) force_alive=1; shift ;;
    --approve-effort) plan_opts+=(--approve-effort); shift ;;
    --same-provider) same_provider=1; shift ;;
    --approved-by-user) [[ $# -gt 2 ]] || usage; approval="$2"; shift 2 ;;
    --level|--thinking) [[ $# -gt 2 ]] || usage; plan_opts+=("$1" "$2"); shift 2 ;;
    --evidence) [[ $# -gt 2 ]] || usage; evidence+=("$2"); shift 2 ;;
    --contract)
      [[ $# -gt 2 ]] || usage
      [[ "$have_contract" == 0 ]] || { echo "tp-review: --contract may be given only once" >&2; usage; }
      have_contract=1; contract="$2"; shift 2 ;;
    --dispositions)
      [[ $# -gt 2 ]] || usage
      [[ "$have_dispositions" == 0 ]] || { echo "tp-review: --dispositions may be given only once" >&2; usage; }
      have_dispositions=1; dispositions="$2"; shift 2 ;;
    --sweep)
      [[ $# -gt 2 ]] || usage
      [[ "$have_sweep" == 0 ]] || { echo "tp-review: --sweep may be given only once" >&2; usage; }
      have_sweep=1; sweep="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ $# -eq 1 ]] || usage
id="$1"
# Files Main supplies are checked before anything else happens, so a bad one starts no reviewer.
# check_supplied <flag> <file>: refuses (naming the file) a file that is a secret or inside the trust store, missing, not a
# regular file, unreadable or empty. The trust store is ~/.config/tmux-pi/trust and ~/.config/tmux-pi/state/trust under the
# home in the password database (never $HOME); a link is judged by where it leads.
check_supplied() {
  local why
  why="$(supplied_problem "$1" "$2")" || die "$why"
}
# supplied_problem <flag> <file>: prints why the file is refused and returns 1, or prints nothing. A brief the request names is
# judged by the same code but is only noted when refused (below).
supplied_problem() {
  python3 "$ROOT/lib/review_verdict.py" supplied "$1" "$2"   # the one rule (lib/review_verdict.py supplied_problem); tp-agent retry's fix brief uses it too
}
for ((i = 0; i < ${#evidence[@]}; i++)); do check_supplied --evidence "${evidence[$i]}"; done   # by index: an empty name is still one entry
contract_acceptance=""   # the contract's own Done means / Acceptance criteria text, attached with the request (a) so it comes before the diff
if [[ "$have_contract" == 1 ]]; then
  check_supplied --contract "$contract"
  contract_acceptance="$(python3 "$ROOT/lib/review_verdict.py" acceptance-text "$contract")" || die "cannot read the acceptance criteria of the contract '$contract'"
fi
if [[ "$have_dispositions" == 1 ]]; then check_supplied --dispositions "$dispositions"; fi
if [[ "$have_sweep" == 1 ]]; then check_supplied --sweep "$sweep"; fi
if [[ "$same_provider" == 1 ]]; then
  [[ "$approval" =~ [!-~] || -n "${approval//[[:space:]]/}" ]] || die "--same-provider needs --approved-by-user with the user's approval quoted; refused"
  plan_opts+=(--same-provider --approved-by-user "$approval")
elif [[ -n "$approval" ]]; then
  die "--approved-by-user applies only with --same-provider"
fi
[[ "$id" =~ ^[[:alnum:]_.-]+$ ]] || die "bad task id: $id"

session="$(tp_session)"
state_dir="$(tp_opt "$session" @tp_state_dir)"
dir="$state_dir/tasks/$id"
tp_not_link --root "$state_dir" "$dir"
if [[ ! -f "$dir/meta.json" ]]; then
  # the lookup tp-agent uses (lib/task_record.py): stop and collect archive under <id> or <id>-ended-<stamp>[-N]
  archived="$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from task_archive import find_archived_task; found = find_archived_task(sys.argv[2], sys.argv[3]); print(found or "")' "$ROOT/lib" "$state_dir" "$id")" ||
    die "cannot search the session archive for '$id'"
  [[ -z "$archived" ]] || die "subagent '$id' is in the session archive at $archived, not among the active tasks; review works only on active tasks"
  die "no subagent '$id'"
fi
[[ ! -f "$dir/pending-capability.json" ]] || die "subagent '$id' is waiting for human capability approval; review is blocked"
# An unanswered worker request means the author's evidence is incomplete, so no
# review (not even --force) starts. Never echo the request's contents.
if [[ -e "$dir/capability-request.json" || -L "$dir/capability-request.json" ]]; then
  # Only an explicit string status "answered" resolves a request; missing, null,
  # unknown, malformed, or unreadable records all stay blocking.
  req_status="$(jq -r 'if type == "object" and (.status | type) == "string" then .status else "unreadable" end' "$dir/capability-request.json" 2>/dev/null)" || req_status=unreadable
  [[ "$req_status" == answered ]] ||
    die "subagent '$id' has an unresolved context/tool request; answer it before review (--force does not bypass this)"
fi
# capability-request.json mirrors only the newest request (HB4a); any capability request still open in requests/ blocks too.
if [[ -e "$dir/requests" || -L "$dir/requests" ]]; then
  [[ ! -L "$dir/requests" ]] && open_caps="$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import hub_records; print(len(hub_records.open_requests(sys.argv[2], ("capability",))))' "$ROOT/lib" "$dir" 2>/dev/null)" || open_caps=unreadable
  [[ "$open_caps" == 0 ]] ||
    die "subagent '$id' has an unresolved context/tool request; answer it before review (--force does not bypass this)"
fi
[[ -f "$dir/result.md" ]] || die "subagent '$id' has no result yet"
# Interactive Pi/Claude sessions remain alive after replying and report `waiting`.
# Accept that settled state as well as a cleanly exited worker.
completed=0
[[ -f "$dir/exit" && "$(cat "$dir/exit")" == 0 ]] && completed=1
if [[ "$completed" != 1 ]]; then
  state="$(jq -r '.state // empty' "$dir/state.json" 2>/dev/null || true)"
  [[ "$state" == waiting ]] || die "subagent '$id' has not completed successfully (state: ${state:-starting})"
fi
# A paused task (a recorded pause, or a reply with no RESULT_STATUS line) has nothing to review yet; the
# state comes from tp-agent's classifier, which a recorded pause wins in whatever the exit code says.
status="$(TP_STATE_DIR="$state_dir" "$ROOT/bin/tp-agent" inspect "$id" 2>/dev/null | jq -r '.status // empty')" || status=
[[ -n "$status" ]] || die "cannot read the state of subagent '$id'"
[[ "$status" != paused ]] || die "subagent '$id' is paused (replied without a result status, or a pause is recorded); it is not ready for review. See what it needs with: tp-agent collect $id (nothing is collected while it is paused); ask it to finish with: tp-agent message $id --text \"Finish, ending with a line that reads exactly RESULT_STATUS: complete\". If its pane is gone it cannot be asked: tp-agent retry $id --reason \"say what changed\""
python3 "$ROOT/lib/result_status.py" "$dir/result.md" >/dev/null ||
  die "subagent '$id' replied without a result status (paused); it is not ready for review. A reply needs a line of its own that reads RESULT_STATUS: complete (or empty, blocked or incomplete), Markdown around it is fine. Ask for it with: tp-agent message $id --text \"End your reply with a line that reads exactly RESULT_STATUS: complete\", then review again. If its pane is gone it cannot be asked: tp-agent retry $id --reason \"say what changed\""

# The review plan: need and reviewer, from the catalog router's resolver (no classifier service).
[[ "$force" == 0 ]] || plan_opts+=(--force)
set +e
plan="$("$ROOT/bin/tp-route" --review-plan "$dir" ${plan_opts[@]+"${plan_opts[@]}"})"
plan_rc=$?
set -e
case "$plan_rc" in
  0) ;;
  3)
    echo "tp-review: review not needed for '$id' (policy: none); use --force to review anyway" >&2
    exit 3 ;;
  4) die "no independent reviewer is available for '$id'; ask the human (no same-provider substitute or silent skip)" ;;
  *) die "cannot plan a review for '$id' (tp-route --review-plan exited $plan_rc)" ;;
esac
policy="$(jq -r '.review' <<<"$plan")"
reviewer="$(jq -r '.reviewer.worker' <<<"$plan")"
model="$(jq -r '.reviewer.model' <<<"$plan")"
thinking="$(jq -r '.reviewer.thinking' <<<"$plan")"
independence="$(jq -r '.reviewer.independence' <<<"$plan")"
approved_quote="$(jq -r '.reviewer.approved_by_user // empty' <<<"$plan")"
same_provider_note=()
if [[ "$independence" == same_provider_user_approved ]]; then
  [[ -n "$approved_quote" ]] || die "the review plan for '$id' is same-provider without the user's approval quote; refused"
  same_provider_note=(--note "This is a same-provider review approved by the user (\"$approved_quote\"): you share the author's provider and may share its blind spots. Check every claim yourself; do not accept assertions without checking.")
fi
worker="$(tp_meta "$dir" worker)"
case "$worker" in
  pi|claude) ;;
  *) die "subagent '$id' has unknown worker '$worker'" ;;
esac
# The state directory and current main pane can outlive the author's project.
# A review must inspect the author's recorded working tree, even after restart.
author_workdir="$(jq -r 'if (.workdir | type) == "string" then .workdir else empty end' "$dir/meta.json")" ||
  die "cannot read author workdir for '$id'"
[[ -n "$author_workdir" ]] || die "author workdir missing for '$id'; cannot choose a review directory"
# A lane task's reviewer stays in its lane and step and reads the same repository preamble (the lane's worktree has none of
# its own): the three tags are copied from the author's record. A value that is present but not text, or a lane with no
# step, refuses; a task with none of them is not a lane task.
lane_args=()
lane_tag() {  # the record's text field $1, empty when absent, BAD when present but not non-empty text
  jq -r --arg k "$1" 'if has($k) then (if (.[$k] | type) == "string" and (.[$k] | length) > 0 then .[$k] else "BAD" end) else "" end' "$dir/meta.json"
}
author_lane="$(lane_tag lane)" && author_step="$(lane_tag lane_step)" && author_preamble="$(lane_tag preamble_from)" ||
  die "cannot read the lane tags of '$id'"
[[ "$author_lane$author_step$author_preamble" != *BAD* ]] || die "'$id' has an unreadable lane tag in its record; review refused"
[[ -z "$author_lane" && -z "$author_step" ]] || [[ -n "$author_lane" && -n "$author_step" ]] || die "'$id' records a lane without a step (or a step without a lane); review refused"
if [[ -n "$author_lane" ]]; then lane_args+=(--lane "$author_lane" --lane-step "$author_step"); fi
if [[ -n "$author_preamble" ]]; then lane_args+=(--preamble-from "$author_preamble"); fi

findings_rule="Return every finding in this one pass, ranked most severe first and numbered F1, F2, ...; do not hold any back for a later round. Judge the work against the task it was given, not against what you would have asked for. Mark each finding 'defect' or 'note'. A defect is only this: the work does something wrong, unsafe or destructive, breaks something that worked, misses a requirement the task states, or leaves the user stuck with no way out; and you can give the concrete case (the input or state, and the wrong result), reproduced or traced through the code. Everything else is a note: style, naming, structure or wording you would prefer, another way to build it, hardening beyond what the task asks, a gap you cannot give a concrete case for, a missing test for behaviour that is correct, and a concern that belongs to another task or a later slice (name that task). Notes are returned in full but never justify another round. Do not ask for more strictness where the cost is refusing ordinary work; say that as a note. When a finding repeats an earlier one, name the family it belongs to: end it with 'Family: <short-kebab-name>' on its own line, before its 'Closes by:' line, and use the name the earlier finding used; a new finding may name a family too. End every finding with 'Closes by: code', 'Closes by: check', 'Closes by: decision' or 'Closes by: none'. code: the tree must change. check: a command, count or log the author must show. decision: the owner or orchestrator must rule. none: a note. A missing or wrong item in the author's report, or a command the author did not run, is never a defect: label it check and list it under 'Owed before close'. Run it yourself when you can and give the result."
coverage_rule="Review the whole change every time: every changed file, and every area the change can affect (callers and readers of changed functions, files, records and command output; other writers of the same state; documentation and tests that describe the old behaviour). Do not stop when you have enough findings for a verdict; finish the whole change first. End your final reply (the reply itself, not only a findings file) with a section headed Coverage that lists each changed file with 'reviewed' or 'not reviewed: reason', and each affected area with what you checked there and what the change may affect that you could not check. A review without that section is incomplete."
report_coverage_rule="Check every important claim, not a sample, and do not stop when you have enough findings for a verdict. End your final reply (the reply itself, not only a findings file) with a section headed Coverage that lists the claims you checked, the claims you did not and why, and what depends on a claim you could not check."
verdict_rule="The first line of your final reply must be exactly APPROVED, APPROVED_WITH_NOTES or REQUEST_CHANGES, with no Markdown or other formatting: REQUEST_CHANGES only when at least one finding is a defect as defined above and ends 'Closes by: code'; APPROVED_WITH_NOTES when there is no defect but you have notes, listed after the second line under the heading Notes, each with the task it belongs to; APPROVED when you have nothing to report. Put RESULT_STATUS: complete|empty|blocked|incomplete on the second line, then"
review_task="Review the completed work from subagent '$id'. You are an independent reviewer, not the implementer. Start from the request and the acceptance list, then the changed-file scope and the diff, and inspect the working tree and relevant files as needed; the author's packet, result and task.md come last, under the heading 'Author's account (read after forming your own findings)'. Identify concrete correctness, regression, security, or requirement gaps. Do not change files. Form your findings from the diff and the tree first. Then read the author's account and Main's frame and check each claim against what you found; a claim you could not verify is 'Closes by: check'. $findings_rule $coverage_rule $verdict_rule a brief rationale or the findings, including file paths and line references when possible."

# A research report (M9) is checked for source support rather than code changes.
extra=()
if [[ "$(jq -r '.contract.kind // empty' "$dir/meta.json")" == research ]]; then
  report="$(jq -r '.contract.artifact' "$dir/meta.json")"
  review_task="Review the research report from subagent '$id' at $report (read it in full; the author's final reply is only a summary). You are an independent reviewer. Check each important claim against its cited source where you can reach it: is it supported by a primary source, only by the report's own reasoning, or by nothing? Name hidden assumptions, say whether the conclusions apply to this project's workflow, and note any local measurement or repository fact that contradicts the report. Classify the key claims as verified, report-derived, background knowledge, or synthesis. Do not change files. $findings_rule $report_coverage_rule $verdict_rule a brief rationale or the findings (unsupported or wrong claims first)."
  extra=(--note "Research report: $report")
fi
if (( ${#evidence[@]} > 0 )); then
  review_task="$review_task Main (the orchestrator) attached ${#evidence[@]} evidence file(s) before the author's account (after the diff, the earlier findings and the timer waits), each under a heading that reads 'Evidence supplied by Main: <file name>'. That evidence was produced by the orchestrator, not the author, and tp-review has not checked it: it can be checked like any other claim, so check it where you can, and say which finding or Owed-before-close item it answers."
fi
if [[ "$have_contract" == 1 ]]; then
  review_task="$review_task Main attached a reviewer contract under the heading 'Reviewer contract (supplied by Main)'. Judge the work against that contract together with the task."
  if [[ -n "$contract_acceptance" ]]; then   # set below; its acceptance list is also given with the request, ahead of the diff
    review_task="$review_task The contract's acceptance list is also given in the context file headed 'Acceptance criteria (from the reviewer contract supplied by Main)', before the diff."
  fi
fi
if [[ "$have_dispositions" == 1 ]]; then
  review_task="$review_task Main attached the dispositions of earlier findings under the heading 'Dispositions of earlier findings (supplied by Main)'. A finding listed there is closed: raise it again only if the tree changed in a way that reopens it, and then cite the disposition and the change."
fi
# A numbered Done means / Acceptance criteria list in the request or the contract: the reply must account for each item, and
# lib/review_verdict.py holds it to that through the item numbers recorded beside the review's result (below, after the start).
acceptance='{"items":[]}' ac_sources=()
unread_briefs="" read_briefs=()   # read_briefs: the named briefs that passed, attached beside the request (they hold its acceptance list)
excerpt_dir="$(mktemp -d)"   # the request, the briefs, the acceptance list and the packet are read from it; removed on exit (cleanup_excerpts below)
cleanup_excerpts() { [[ -z "$excerpt_dir" ]] || rm -rf "$excerpt_dir"; }
trap cleanup_excerpts EXIT
# The request: request.md, else (a task record from before request.md existed) the request as lib/task_record.py request_text reads it
# from task.md, written to a file here so that the briefs and the acceptance list are found in it the same way. req_file is empty
# when there is no request text at all.
req_file=""
if [[ -f "$dir/request.md" ]]; then
  req_file="$dir/request.md"
else
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from task_record import request_text; print(request_text(sys.argv[2]))' "$ROOT/lib" "$dir" > "$excerpt_dir/request.md" ||
    die "cannot read the request of '$id' from its task record"
  if [[ -n "$(tr -d '[:space:]' < "$excerpt_dir/request.md")" ]]; then req_file="$excerpt_dir/request.md"; fi
fi
if [[ -n "$req_file" ]]; then
  ac_sources+=("$req_file")
  # A request usually says "Read and carry out the brief /abs/path.md": the list is in that brief. Each .md path it names is read
  # when it passes the checks --contract gets; one that does not is not an error, the task text says it was not read and why.
  named="$(python3 "$ROOT/lib/review_verdict.py" briefs "$req_file")" || die "cannot read the request of '$id'"
  while IFS= read -r brief; do
    [[ -n "$brief" ]] || continue
    if why="$(supplied_problem "A brief the request names:" "$brief")"; then
      ac_sources+=("$brief"); read_briefs+=("$brief")
    else
      unread_briefs="$unread_briefs ${why//$'\n'/ }"
    fi
  done < <(jq -r '.briefs[]' <<<"$named")
fi
if [[ "$have_contract" == 1 ]]; then ac_sources+=("$contract"); fi
if (( ${#ac_sources[@]} > 0 )); then
  acceptance="$(python3 "$ROOT/lib/review_verdict.py" acceptance "${ac_sources[@]}")" || die "cannot read the acceptance criteria of '$id'"
fi
if [[ -n "$unread_briefs" ]]; then
  review_task="$review_task Briefs the request names that tp-review did not read for the acceptance list:$unread_briefs."
fi
ac_count="$(jq -r '.items | length' <<<"$acceptance")"
if (( ac_count > 0 )); then
  review_task="$review_task The task (or the reviewer contract) has a numbered list of $ac_count item(s), numbers $(jq -r '.items | map(tostring) | join(", ")' <<<"$acceptance"), under a heading 'Done means' or 'Acceptance criteria'. Include in your final reply a section headed Acceptance criteria with one line per item: its number, then met, not met or not checked, then the evidence (file:line, a test, or a command). A reply without that section, or one that names fewer of the item numbers than the list has, is incomplete."
fi

# tp-spawn caps each context file at 60000 chars and the whole packet at 200000. An
# oversized author packet/result is never excerpted: it is split into ordered, labelled
# segments that together hold every character. If all evidence cannot fit in one
# packet, fail before spawning rather than drop any of it.
# The reserve holds the packet tp-spawn adds around the task, the reviewer's role text (agent/roles/code-reviewer.md) included.
max_file=60000 max_packet=400000 packet_reserve=$(( 20000 + $(wc -c < "$ROOT/agent/roles/code-reviewer.md") )) per_file_overhead=300
ctx_list=()
# add_segments <file> <label> [origin]: appends context paths to ctx_list (runs in this shell,
# so excerpt_dir and ctx_list survive for cleanup and spawning). origin is the path a segment label names (default: the file).
add_segments() {
  local list line
  list="$excerpt_dir/$2.list"
  python3 - "$1" "$excerpt_dir" "$2" "$max_file" "${3:-$1}" > "$list" <<'PYEOF' || die "cannot split '$1' for review"
import sys
path, outdir, label, limit, origin = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4]), sys.argv[5]
text = open(path, encoding="utf-8", errors="surrogateescape").read()
def size(t): return len(t.encode("utf-8", "surrogateescape"))
if size(text) <= limit:
    print(path); sys.exit()
body_max = limit - 1000  # leaves room for the segment label
segs, i = [], 0
while i < len(text):
    j = min(len(text), i + body_max)
    while size(text[i:j]) > body_max: j = i + max(1, (j - i) * 9 // 10)
    segs.append((i, j)); i = j
for n, (a, b) in enumerate(segs, 1):
    out = f"{outdir}/{label}-{n:02d}-of-{len(segs):02d}.md"
    head = (f"[Review segment {n} of {len(segs)} of {label}; original path: {origin}; "
            f"characters {a}-{b} of {len(text)}. Segments are complete and in order; none omitted.]\n\n")
    with open(out, "w", encoding="utf-8", errors="surrogateescape") as f: f.write(head + text[a:b])
    print(out)
PYEOF
  while IFS= read -r line; do ctx_list+=("$line"); done < "$list"
}
# The context list is in reading order, claims last (packet_order claims-last:v1; the order is in the header comment): (a) what the
# author was asked, (b) the scope, (c) the change, (d) earlier findings, (e) timer waits, (f) what Main supplied, then under one
# heading the author's account: (g) its packet, (h) its result, and (i) task.md, which tp-spawn is handed last.
# (a) The request as given, any brief it names that passed the checks, and the messages the user sent the author after its task
# (written by the dispatcher; part of what it was asked to do). A task record from before request.md existed keeps the request in
# task.md: lib/task_record.py request_text reads it from there, so (a) is never empty for it.
if [[ -n "$req_file" ]]; then add_segments "$req_file" request; fi
for ((i = 0; i < ${#read_briefs[@]}; i++)); do add_segments "${read_briefs[$i]}" "brief-$(printf '%02d' $(( i + 1 )))"; done
if [[ -s "$dir/followups.md" ]]; then add_segments "$dir/followups.md" followups; fi
# The reviewer contract's own acceptance list, ahead of the diff; the contract itself stays in (f).
if [[ -n "$contract_acceptance" ]]; then
  printf '# Acceptance criteria (from the reviewer contract supplied by Main)\n\n%s\n' "$contract_acceptance" > "$excerpt_dir/contract-acceptance.md" || die "cannot write the contract's acceptance criteria"
  add_segments "$excerpt_dir/contract-acceptance.md" contract-acceptance
fi
scope_at=${#ctx_list[@]}   # (b), the scope file, is inserted here once the packet's headroom is known (below)
# (c) and (d): the change, then the earlier review rounds of this task and its retry ancestors. The change is the tree now against
# the review base (the last reviewed state, else the lane's last closed step, else the lane base, else HEAD).
# Recorded state that cannot be used refuses; nothing is guessed.
mkdir "$excerpt_dir/rounds"
rounds="$(python3 "$ROOT/lib/review_rounds.py" prepare "$state_dir" "$id" "$author_workdir" "$excerpt_dir/rounds" "$author_lane")" ||
  die "cannot gather the earlier review rounds for '$id'"
round_count="$(jq -r '.rounds' <<<"$rounds")"
snapshot="$(jq -c '.snapshot' <<<"$rounds")"
while IFS= read -r skipped; do
  echo "tp-review: earlier review '$skipped' has no reply; not attached" >&2
done < <(jq -r '.skipped[]' <<<"$rounds")
while IFS= read -r withheld; do
  if (( round_count > 0 )); then echo "tp-review: sensitive path '$withheld' changed since the last round; its contents were withheld from the diff" >&2
  else echo "tp-review: sensitive path '$withheld' changed against the review base; its contents were withheld from the diff" >&2; fi
done < <(jq -r '.withheld[]' <<<"$rounds")
redactions="$(jq -r '.redactions' <<<"$rounds")"
if (( redactions > 0 )); then echo "tp-review: $redactions secret-like value(s) in the earlier findings and diff were replaced with placeholders" >&2; fi
while IFS= read -r f; do add_segments "$f" "$(basename "$f" .md)"; done < <(jq -r '.contexts[]' <<<"$rounds")
# (e) The added test lines that wait on a clock (a research report has no diff). Computed here, never by the reviewer; facts only.
# The changed-file list prepare computed with the diffs (scope-input.json): the scope (b) and the timer waits read it, never
# working it out again (timers uses it only when it is the round-1 plan it would make itself).
scope_input=(); scope_file="$(jq -r '.scope_input // empty' <<<"$rounds")"
if [[ -n "$scope_file" ]]; then scope_input=(--input "$scope_file"); fi
if [[ -z "${extra[*]+x}" ]]; then
  python3 "$ROOT/lib/review_rounds.py" timers "$author_workdir" "$author_lane" "$excerpt_dir/timer-waits.md" ${scope_input[@]+"${scope_input[@]}"} || die "cannot compute the timer waits for '$id'"
  add_segments "$excerpt_dir/timer-waits.md" timer-waits
  review_task="$review_task The context file headed 'Timer waits in added test lines' lists the added test lines that wait on a clock, as path:line: text; they are facts only, and you judge whether each is a defect."
fi
# (f) What Main supplied: each file is copied under its heading, then split like the author's evidence when large. A segment's label
# names the file Main gave. The evidence comes first, in the order given, then the contract, the dispositions and the sweep.
supplied_n=0
attach_supplied() {  # <file> <heading> <note, may be empty> <label>
  local out="$excerpt_dir/$4.md"
  { printf '# %s\n\n' "$2"; [[ -z "$3" ]] || printf '%s\n\n' "$3"; cat -- "$1"; } > "$out" || die "cannot read '$1' to attach it to the review"
  add_segments "$out" "$4" "$1"
}
for ((i = 0; i < ${#evidence[@]}; i++)); do
  f="${evidence[$i]}"
  supplied_n=$(( supplied_n + 1 ))
  attach_supplied "$f" "Evidence supplied by Main: $(basename "$f")" "(Produced by the orchestrator, not the author. Check it like any other claim.)" "main-evidence-$(printf '%02d' "$supplied_n")"
done
if [[ "$have_contract" == 1 ]]; then attach_supplied "$contract" "Reviewer contract (supplied by Main)" "" main-contract; fi
if [[ "$have_dispositions" == 1 ]]; then attach_supplied "$dispositions" "Dispositions of earlier findings (supplied by Main)" "" main-dispositions; fi
# The sweep this work was given and the coder's table for it (tp-agent review passes --sweep): one file, the sweep then the rows as the
# report gave them. The unresolved rows with no Closes by: note are recorded after the start (lib/review_verdict.py holds an approval to them).
sweep_open='[]'
if [[ "$have_sweep" == 1 ]]; then
  mkdir "$excerpt_dir/sweep"
  sweep_info="$(python3 "$ROOT/lib/family_sweep.py" review "$sweep" "$dir/result.md" "$excerpt_dir/sweep" "$dir/report.md")" || die "cannot attach the sweep '$sweep' to the review of '$id'"
  add_segments "$(jq -r '.file' <<<"$sweep_info")" sweep-review
  sweep_open="$(jq -c '.open' <<<"$sweep_info")"
  sweep_family="$(jq -r '.family // empty' <<<"$sweep_info")"
  sweep_rows="$(jq -r '.rows' <<<"$sweep_info")"
  if [[ -n "$sweep_family" ]]; then sweep_label="'Family: $sweep_family' (before its 'Closes by:' line)"
  else sweep_label="the same 'Family:' line the sweep's earlier findings used, when it lists one (before its 'Closes by:' line)"; fi
  review_task="$review_task This work was given a sweep: a brief the harness generated from the earlier reviews so that its retry fixes every site of the finding. The context file headed 'The sweep this work was given' is that brief, and the part headed 'The coder's report table for it' holds the $sweep_rows row(s) the coder reported. Confirm each row against the tree: for every row say confirmed or not confirmed, citing its site and the line or command that shows it. Search for the sites the table missed (the sweep says how) and add every site the table missed as a row of your own, a defect among them as a finding that ends with $sweep_label."
  if [[ "$sweep_open" != '[]' ]]; then
    review_task="$review_task The coder left $(jq -r 'length' <<<"$sweep_open") row(s) unresolved with no 'Closes by:' note in the Evidence cell ($(jq -r '.[:10] | map(.[:100]) | join(", ")' <<<"$sweep_open")$(jq -r 'if length > 10 then ", and \(length - 10) more" else "" end' <<<"$sweep_open")): this work cannot be APPROVED or APPROVED_WITH_NOTES until each has such a note (an approval is then recorded as incomplete); say so as a finding that ends 'Closes by: decision' or 'Closes by: code'."
  fi
fi
# The author's account, after every independent item: a heading file, then (g) its packet and (h) its result; (i) task.md (Main's
# Orient/Frame and the request as recorded) follows as the last context, handed to tp-spawn below.
cat > "$excerpt_dir/author-account.md" <<'EOF'
# Author's account (read after forming your own findings)

The files after this one are the author's packet and the author's result, and then task.md, which holds the request as recorded and
Main's Orient/Frame. They are claims, not evidence: form your findings from the diff and the tree first, then check each claim
here against what you found.
EOF
ctx_list+=("$excerpt_dir/author-account.md")
add_segments "$dir/packet.md" author-packet
add_segments "$dir/result.md" author-result
# (b) The changed-file list and the scoped git commands, so the reviewer never needs an unscoped diff (which may print credential files).
# They are the context file diff-scope.md, placed between the request and the diff (at scope_at), sized to the packet's remaining headroom.
# Any overflow list goes to $dir/review-changed-files.txt (named in the file, not attached, so it cannot exceed the packet budget).
# Never fails the review: when the list cannot be made, the file says so in one line.
scope=""
if [[ -z "${extra[*]+x}" ]]; then  # a research report has no diff
  scope_note=" The changed files and the scoped git commands are in the context file headed 'Scope of the change', between the request and the diff."
  review_task="$review_task$scope_note"
  # The scope text may use only what the packet has left after the evidence and the round text (reserve 2000 chars for that line, and
  # the file's heading and per-file overhead).
  scope_heading=$'# Scope of the change (changed files and scoped git commands)\n\n'
  scope_budget=$(( max_packet - packet_reserve - ${#review_task} - 2000 - ${#scope_heading} - per_file_overhead ))
  for f in "$dir/task.md" "${ctx_list[@]}"; do
    scope_budget=$(( scope_budget - $(wc -c < "$f") - per_file_overhead ))
  done
  (( scope_budget >= 0 )) || scope_budget=0
  # The changed-file list is the one prepare computed with the diffs above (scope_input, set after prepare), never worked out again.
  scope="$(python3 "$ROOT/lib/review_rounds.py" scope "$author_workdir" "$author_lane" "$dir/review-changed-files.txt" "$scope_budget" ${scope_input[@]+"${scope_input[@]}"} 2>/dev/null | jq -r '.text' 2>/dev/null)" || scope=""
  [[ -n "$scope" ]] || scope="Diff scope: the changed-file list could not be computed; inspect the files you need directly."
  printf '%s%s\n' "$scope_heading" "$scope" > "$excerpt_dir/diff-scope.md" || die "cannot write the scope of '$id'"
  ordered=()   # ctx_list with the scope file at scope_at (always before the author's account, so the list is never empty here)
  for ((i = 0; i < ${#ctx_list[@]}; i++)); do
    if (( i == scope_at )); then ordered+=("$excerpt_dir/diff-scope.md"); fi
    ordered+=("${ctx_list[$i]}")
  done
  ctx_list=("${ordered[@]}")
fi
if (( round_count > 0 )); then
  review_task="$review_task This is review round $(( round_count + 1 )) of this work. The diff of the working tree since the last reviewed state is attached after the request and the scope (against the review base instead when an earlier round recorded no usable state), then the findings of the $round_count earlier round(s), oldest first. For each earlier finding say whether it is fixed, citing it by round and number (for example round 1 F2); when a new finding repeats an earlier one, name that family. Review the whole change again, not only the fixes: the diff shows only what changed since the last round, and a fix can break what an earlier round passed."
  used_families="$(jq -r '[.families | to_entries[] | select(.value | length > 0) | "round \(.key + 1): \(.value | join(", "))"] | join("; ")' <<<"$rounds")"
  if [[ -n "$used_families" ]]; then
    review_task="$review_task Family names used by the earlier rounds: $used_families. For each finding that belongs to one of these families end it with 'Family: <that name>' exactly as written (before its 'Closes by:' line); for a finding that is new, say in the finding that it is new."
  else
    review_task="$review_task No earlier round named a finding family. If a finding repeats an earlier one, name the family with 'Family: <short-kebab-name>'; if every finding is new, say so."
  fi
  summarised="$(jq -r '.summarised | if length > 0 then "rounds \(.[0].round) to \(.[-1].round) (full text: \([.[] | .result] | join(", ")))" else empty end' <<<"$rounds")"
  if [[ -n "$summarised" ]]; then
    review_task="$review_task Review $summarised are summarised on one line each, without finding bodies, on purpose: a retry made with a gated route changed the rule or the design after them, and the findings from the review that triggered it on are attached in full; name a family that recurs from a summarised round when a finding repeats it."
  fi
  if (( round_count >= 2 )); then
    review_task="$review_task From round 3 on, a REQUEST_CHANGES reply with no 'Family:' line is flagged in the verdict summary."
  fi
fi
total=$(( packet_reserve + ${#review_task} ))
for f in "$dir/task.md" "${ctx_list[@]}"; do
  total=$(( total + $(wc -c < "$f") + per_file_overhead ))
done
(( total <= max_packet )) ||
  die "review packet for '$id' needs ~$total chars (max $max_packet) without dropping author evidence; use a deliberate source-review workflow instead"
# A reviewer is read-only and runs beside no writer on the same working tree (T3); every caller passes here. The settled
# author is the writer that matters: its process is ended first (pane and scrollback kept, task not collected), and the review
# is refused if that cannot be done or checked. The guard then covers every task on the tree, the author included.
if [[ "$force_alive" != 1 ]]; then
  TP_STATE_DIR="$state_dir" "$ROOT/bin/tp-agent" end-author "$id" >/dev/null || die "review of '$id' refused: its process could not be ended; end it with \`tp-agent stop $id\`, or pass --force-alive${author_lane:+ (--force-alive does not apply to lane $author_lane: end the writer instead)}"
  TP_STATE_DIR="$state_dir" "$ROOT/bin/tp-agent" guard-review "$id" >/dev/null || die "review of '$id' refused; end the writer it names with the command above${author_lane:+ (--force-alive does not apply to lane $author_lane)}"
fi
ctx_args=()
for f in "${ctx_list[@]}"; do ctx_args+=(--context "$f"); done
if ! review_id="$("$ROOT/bin/tp-spawn" --worker "$reviewer" --model "$model" --thinking "$thinking" --name "review-$id" --workdir "$author_workdir" --preamble-role code-reviewer --review-of "$id" ${lane_args[@]+"${lane_args[@]}"} \
  ${ctx_args[@]+"${ctx_args[@]}"} --context "$dir/task.md" \
  --note "Author task id: $id" ${extra[@]+"${extra[@]}"} \
  --note "Review policy: $policy ($independence)" ${same_provider_note[@]+"${same_provider_note[@]}"} \
  --note "The author used worker: $worker. You must independently review; do not accept assertions without checking." \
  -- "$review_task")"; then
  die "reviewer '$reviewer' ($model) could not start; ask the human (no silent skip or substitute)"
fi

jq --arg review "$review_id" --arg reviewer "$reviewer" --arg model "$model" --arg thinking "$thinking" \
  --arg policy "$policy" --arg independence "$independence" --arg approved "$approved_quote" \
  '. + {review:$review, reviews:((.reviews // (if .review then [.review] else [] end)) + [$review]), review_policy:$policy, reviewer:({worker:$reviewer, model:$model, thinking:$thinking, independence:$independence} + (if $approved != "" then {approved_by_user:$approved} else {} end))}' \
  "$dir/meta.json" | tp_write "$dir/meta.json" --root "$state_dir" --fresh
review_dir="$(tp_task_dir "$session" "$review_id")"
tp_not_link --root "$state_dir" "$review_dir"
printf '%s\n' "$id" | tp_write "$review_dir/review-of" --root "$state_dir"
# The order version of the packet this reviewer was given, so evals can split reviews made before and after the order changed.
jq --arg order "$PACKET_ORDER" '. + {packet_order:$order}' "$review_dir/meta.json" | tp_write "$review_dir/meta.json" --root "$state_dir" --fresh
# The sweep rows the reply must not approve past; lib/review_verdict.py read_review applies them for every reader of the reply.
if [[ "$have_sweep" == 1 ]]; then jq -nc --argjson open "$sweep_open" '{open:$open}' | tp_write "$review_dir/sweep-rows.json" --root "$state_dir"; fi
# The working tree this reviewer saw; the next round's diff starts here. Absent when the workdir is not a git repository.
if [[ "$snapshot" != null ]]; then printf '%s\n' "$snapshot" | tp_write "$review_dir/reviewed-state.json" --root "$state_dir"; fi
# The acceptance items the reply must account for; lib/review_verdict.py read_review applies them for every reader of the reply.
if (( ac_count > 0 )); then printf '%s\n' "$acceptance" | tp_write "$review_dir/acceptance-items.json" --root "$state_dir"; fi
printf '%s\n' "$review_id"
