#!/usr/bin/env python3
"""Choose a validated tmux-pi worker model and thinking level for a task."""

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from router import RouterError, load_config, local_base_url, route_task  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("task", nargs="*", help="task text; reads stdin when omitted")
    parser.add_argument("--file", help="read task text from a file")
    parser.add_argument("--config", default=str(Path(__file__).resolve().parent.parent / "config/router.json"))
    parser.add_argument("--backend", choices=("laya", "openai"), default=os.environ.get("TP_ROUTER_BACKEND"),
                        help="classifier backend (default: config, which selects Laya)")
    parser.add_argument("--base-url", default=os.environ.get("TP_ROUTER_BASE_URL"))
    parser.add_argument("--router-model", default=os.environ.get("TP_ROUTER_MODEL"))
    parser.add_argument("--check", action="store_true", help="validate config without contacting the endpoint")
    args = parser.parse_args()
    try:
        config = load_config(args.config)
        backend = args.backend or config["backend"]
        if backend not in ("laya", "openai"):
            raise RouterError("backend must be laya or openai")
        if args.base_url is not None:
            local_base_url(args.base_url, backend)
        if args.router_model is not None and not args.router_model.strip():
            raise RouterError("router model must be a nonempty string")
        if args.check:
            print("router config valid: {} models".format(len(config["models"])))
            return 0
        if args.file and args.task:
            parser.error("use either --file or task arguments")
        if args.file:
            task = Path(args.file).read_text(encoding="utf-8")
        elif args.task:
            task = " ".join(args.task)
        else:
            task = sys.stdin.read()
        print(json.dumps(route_task(task, config, backend, args.base_url, args.router_model), separators=(",", ":")))
        return 0
    except (RouterError, OSError) as exc:
        print("tp-route: {}".format(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
