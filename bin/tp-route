#!/usr/bin/env python3
"""Choose a validated tmux-pi worker model and thinking level for a task.

With --review, print the task's review level (none, optional or required) instead.
With --dispatch, print the main agent's full decision: route target, intent, review,
execution scope and placement (main or subagent), honoring +here/+delegate/+review.
With --follow-up, read {"message", "tasks": [{"id", "task", "reply"}]} as JSON on stdin
and print {"target": id or null, "ask": [ids]}: the running task the message belongs to.
With --pick-files WORKDIR --model M, print the tp-spawn -c specs to put in the packet of
a worker on M, one per line (nothing unless M is listed in local packet_files).

Routing and --dispatch append an experimental selection record to the session's
.tmux-pi/evals log (lib/routing_evals.py; TP_ROUTING_EVALS=0 turns it off). The log is
best-effort evidence: a failed append never changes the decision or the exit status, and
--dispatch output gains a selection_id only when the record was written.
"""

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from router import (RouterError, dispatch, follow_up, load_config, local_base_url, pick_files,  # noqa: E402
                    review_task, route_task)


def log_selection(task, config, config_path, kind, backend, decision, trace, error=None):
    """Append a selection record; return its id, or None. Never raises."""
    try:
        import routing_evals
        record = routing_evals.selection_record(task, config, config_path, kind=kind, backend=backend,
                                                decision=decision, trace=trace, error=error)
        routing_evals.log_selection(record)
        return record["selection_id"]
    except Exception as exc:  # noqa: BLE001 - eval logging must never change routing
        if "no tmux-pi state dir" not in str(exc):
            print("tp-route: routing eval not logged: {}".format(exc), file=sys.stderr)
        return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("task", nargs="*", help="task text; reads stdin when omitted")
    parser.add_argument("--file", help="read task text from a file")
    parser.add_argument("--config", default=str(Path(__file__).resolve().parent.parent / "config/router.json"))
    parser.add_argument("--backend", choices=("laya", "openai"), default=os.environ.get("TP_ROUTER_BACKEND"),
                        help="classifier backend (default: config, which selects Laya)")
    parser.add_argument("--base-url", default=os.environ.get("TP_ROUTER_BASE_URL"))
    parser.add_argument("--router-model", default=os.environ.get("TP_ROUTER_MODEL"))
    parser.add_argument("--check", action="store_true", help="validate config without contacting the endpoint")
    parser.add_argument("--dispatch", action="store_true",
                        help="print the main agent's decision: target, intent, review, scope, placement")
    parser.add_argument("--follow-up", action="store_true",
                        help="print the running task a message belongs to (JSON on stdin)")
    parser.add_argument("--pick-files", metavar="WORKDIR",
                        help="print packet file specs for a worker on --model (task on stdin)")
    parser.add_argument("--model", help="worker model for --pick-files")
    parser.add_argument("--review", action="store_true",
                        help="print {\"review\": none|optional|required} from Laya instead of a route")
    args = parser.parse_args()
    try:
        config = load_config(args.config)
        backend = args.backend or config["backend"]
        if backend not in ("laya", "openai"):
            raise RouterError("backend must be laya or openai")
        if args.base_url is not None:
            local_base_url(args.base_url, backend)
        if (args.review or args.dispatch) and backend != "laya":
            raise RouterError("--review and --dispatch need the laya backend")
        if args.router_model is not None and not args.router_model.strip():
            raise RouterError("router model must be a nonempty string")
        if args.check:
            print("router config valid: {} models".format(len(config["models"])))
            return 0
        if args.follow_up:
            try:
                request = json.loads(sys.stdin.read())
                message, tasks = request["message"], request["tasks"]
                if not isinstance(message, str) or not isinstance(tasks, list) or any(
                        not isinstance(t, dict) or not isinstance(t.get("id"), str) or not isinstance(t.get("task"), str)
                        or not isinstance(t.get("reply", ""), str) for t in tasks):
                    raise ValueError("needs a message string and tasks with string id, task and reply")
            except (ValueError, KeyError, TypeError) as exc:
                raise RouterError("--follow-up input: {}".format(exc)) from exc
            print(json.dumps(follow_up(message, tasks, config), separators=(",", ":")))
            return 0
        if args.file and args.task:
            parser.error("use either --file or task arguments")
        if args.file:
            task = Path(args.file).read_text(encoding="utf-8")
        elif args.task:
            task = " ".join(args.task)
        else:
            task = sys.stdin.read()
        if args.pick_files:
            if not args.model:
                raise RouterError("--pick-files needs --model")
            for spec in pick_files(task, args.pick_files, args.model, config):
                print(spec)
            return 0
        if args.dispatch:
            trace = {}
            try:
                decision = dispatch(task, config, args.base_url, args.router_model, trace=trace)
            except RouterError as exc:
                log_selection(task, config, args.config, "dispatch", backend, None, trace, exc)
                raise
            selection_id = log_selection(task, config, args.config, "dispatch", backend, decision, trace)
            if selection_id:
                decision["selection_id"] = selection_id
            print(json.dumps(decision, separators=(",", ":")))
            return 0
        if args.review:
            print(json.dumps({"review": review_task(task, config, args.base_url, args.router_model)},
                             separators=(",", ":")))
            return 0
        trace = {}
        try:
            decision = route_task(task, config, backend, args.base_url, args.router_model, trace=trace)
        except RouterError as exc:
            log_selection(task, config, args.config, "route", backend, None, trace, exc)
            raise
        # Plain routing output stays exactly worker/model/thinking; it is joined by task hash.
        log_selection(task, config, args.config, "route", backend, decision, trace)
        print(json.dumps(decision, separators=(",", ":")))
        return 0
    except (RouterError, OSError) as exc:
        print("tp-route: {}".format(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
