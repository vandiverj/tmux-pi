#!/usr/bin/env python3
"""Run a shell command after substituting redaction placeholders with their real values.

Usage: tp-secret-exec --session NAME -- 'command containing placeholders'

The PreToolUse hook wraps Bash commands that contain placeholders in this script, so the approval
prompt shows only placeholders. It runs only a command the hook recorded for that tool call, once.
Values reach bash over a pipe (never argv or a file), only for placeholders the hook recorded for
this session, and the real exit status is printed as
`exit-code: N` because this script always exits 0: that keeps failing output on PostToolUse,
which redacts it again.
"""
import argparse
import os
from pathlib import Path
import subprocess
import sys
import threading

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from placeholders import find, resolve_all, substitute_command
from redaction_store import Store


def finish(code, message=None):
    sys.stdout.flush()
    if message:
        print("tp-secret-exec: " + message, file=sys.stderr)
    print("exit-code: {}".format(code))
    sys.exit(0)


def main():
    parser = argparse.ArgumentParser(allow_abbrev=False)  # the hook refuses commands naming this script with --session
    parser.add_argument("--session", required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    words = args.command[1:] if args.command[:1] == ["--"] else args.command
    command = " ".join(words)
    names = find(command)
    store = Store(args.session)
    # Only the exact command the hook saw, approved and wrapped, and only once: a direct or replayed run gets nothing.
    if not store.claim_run(command):
        finish(126, "this command was not wrapped by the tmux-pi hook (or already ran); run it as a normal Bash "
                    "command with placeholders")
    data = store.peek()
    refused = [n for n in names if data.get("grants", {}).get(n) not in ("pending", "granted")]
    if refused:
        finish(126, "no approval is recorded for {}".format(", ".join(refused)))
    values = resolve_all(data, names)
    missing = [n for n in names if n not in values]
    if missing:
        finish(126, "cannot recover {} (its source file changed or is gone); read it again".format(", ".join(missing)))
    script = substitute_command(command, values)
    if script is None:
        finish(126, "this command form (heredoc, or special characters inside $(...) or backticks) cannot take "
                    "a placeholder safely; pass the value through a file or a simpler command")
    read, write = os.pipe()

    def feed():
        with os.fdopen(write, "wb") as pipe:
            try:
                pipe.write(script.encode("utf-8", "surrogateescape"))
            except BrokenPipeError:
                pass

    threading.Thread(target=feed, daemon=True).start()
    try:
        code = subprocess.call(["bash", "/dev/fd/{}".format(read)], pass_fds=(read,))
    except OSError as exc:
        finish(126, "could not run bash: {}".format(type(exc).__name__))
    finally:
        os.close(read)
    finish(128 - code if code < 0 else code)


if __name__ == "__main__":
    main()
