#!/usr/bin/env python3
"""Classify or request permission for credential-bearing reads."""
import argparse
import json
import os
from pathlib import Path
import sys
from datetime import datetime, timezone

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import safe_write
from sensitive_read import classify, response_for, safe_route, worker_task
from redact_hook import mode as redaction_mode, settled_record, write_request


def save_request(result, status, call=None, agent_id=None):
    task = os.getenv("TP_TASK_DIR")
    if not task:
        return
    path = Path(task) / "permission-request.json"
    value = {"status": status, "target": result.get("target"), "reason": result.get("reason"),
             "updated": datetime.now(timezone.utc).isoformat(timespec="seconds"),
             **{k: v for k, v in (("call", call), ("agent_id", agent_id)) if v}}
    safe_write.write_atomic(path, json.dumps(value) + "\n", root=safe_write.task_root(task), keep_mode=False)


def resolver(args, quiet=False):
    """The owner's trust record as the classifier's resolver (lib/trust_lift.py), or None.

    Only a caller that prompts the owner asks for it (`--trusted`); anything that goes wrong building it
    means no lifts, which is what every caller without the flag gets.
    """
    if not args.trusted:
        return None
    try:
        import trust_lift
        return (trust_lift.Quiet if quiet else trust_lift.Resolver)(
            "claude" if args.claude_hook else "pi", home=args.home, temp_roots=args.temp_root)
    except Exception:
        return None


def _decide(event, args):
    try:
        cwd = event.get("cwd") if isinstance(event.get("cwd"), str) else None
        return classify(event.get("tool_name", ""), event.get("tool_input", {}), cwd, resolver(args))
    except Exception as error:
        return {"error": str(error)}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--claude-hook", action="store_true")
    parser.add_argument("--batch", action="store_true",
                        help="stdin is a JSON array of events; print a JSON array with one decision per event, in order")
    parser.add_argument("--route", choices=("claude", "pi"),
                        help="with a sensitive answer, add \"safe\": the safe tool call (that harness's names) to use instead, when there is one")
    parser.add_argument("--trusted", action="store_true",
                        help="lift prompts that a name or directory guess raised in a tree the owner vouched for")
    # Test seams: where the trust store and its log live, and which directories count as temporary.
    parser.add_argument("--home", help=argparse.SUPPRESS)
    parser.add_argument("--temp-root", action="append", help=argparse.SUPPRESS)
    args = parser.parse_args()
    event = json.load(sys.stdin)
    if args.batch:
        # One start for many reads (bin/tp-spawn screens every --context file in one call). Each event is judged exactly as a
        # single call judges it; one that cannot be judged has no "sensitive": false, which a caller treats as sensitive.
        print(json.dumps([_decide(item, args) for item in event] if isinstance(event, list) else []))
        return
    # The shell's directory when the tool ran; relative paths and search roots are
    # judged from it. Absent (older callers), the classifier assumes nothing.
    cwd = event.get("cwd") if isinstance(event.get("cwd"), str) else None
    if args.claude_hook:
        if redaction_mode() == "on":
            return  # tp-redact --claude-hook owns gating and permission records
        name = event.get("hook_event_name")
        if name in {"PostToolUse", "PermissionDenied"}:
            old = Path(os.getenv("TP_TASK_DIR", "/nonexistent")) / "permission-request.json"
            if old.is_file():
                prior = json.loads(old.read_text())
                current = classify(event.get("tool_name", ""), event.get("tool_input", {}), cwd,
                                   resolver(args, quiet=True))
                # A request the turn branch (redact_hook.settle_declined) marked `declined` is overtaken by a late answer for
                # the same call; authorized and denied are final.
                waiting = prior.get("status") == "pending" or (
                    prior.get("status") == "declined" and prior.get("call") and prior["call"] == event.get("tool_use_id"))
                if waiting and current.get("sensitive") and current.get("target") == prior.get("target"):
                    # The prior record with the outcome: every field stays (event, call, agent_id, any other), not rebuilt from `current`.
                    write_request(os.environ["TP_TASK_DIR"], settled_record(prior, "authorized" if name == "PostToolUse" else "denied", name))
            return
        if name != "PreToolUse":
            return
        result = classify(event.get("tool_name", ""), event.get("tool_input", {}), cwd, resolver(args))
        if result["sensitive"]:
            # An ask a shell search or read caused ("search_read") names the safe tools that replace it; in a worker task it
            # is refused, not asked. Any other ask stays an ask in both.
            searched = result.get("search_read")
            route = safe_route(event.get("tool_name", ""), event.get("tool_input", {}), "claude", cwd) if searched else None
            refuse = bool(searched) and worker_task()
            save_request({**result, "reason": f"{result['reason']}. {route}" if route else result["reason"]},
                         "refused" if refuse else "pending", event.get("tool_use_id"), event.get("agent_id"))
            print(json.dumps(response_for(result, route, refuse)))
    else:
        result = classify(event.get("tool_name", ""), event.get("tool_input", {}), cwd, resolver(args))
        route = args.route and result.get("search_read") and safe_route(event.get("tool_name", ""), event.get("tool_input", {}), args.route, cwd)
        print(json.dumps({**result, "safe": route} if route else result))


if __name__ == "__main__":
    main()
