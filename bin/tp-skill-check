#!/usr/bin/env python3
"""Validate a NEW or explicitly named skill directory. Never scans the catalogue."""
import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from skill_check import check_skill  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description="Validate one skill directory (portable Agent Skills subset).")
    ap.add_argument("path", help="skill directory containing SKILL.md")
    ap.add_argument("--single-file", action="store_true",
                    help="catalogue-only skill: fail any relative link (packet inlines SKILL.md alone)")
    ap.add_argument("--legacy", action="store_true",
                    help="existing catalogue skill without frontmatter: size and single-file checks only")
    args = ap.parse_args()
    errors = check_skill(args.path, single_file=args.single_file, legacy=args.legacy)
    for e in errors:
        print(f"error: {e}", file=sys.stderr)
    if errors:
        return 1
    print(f"ok: {args.path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
