#!/usr/bin/env bash
# tp-status — interactive subagent list for the status slot.
#
# Keys:  j/k or ↑/↓   move (past the first or last row it loads older or newer tasks)
#        g / G        top / bottom of the whole list (also Home / End)
#        PgUp / PgDn  move a page
#        enter        show the selected subagent in the viewer
#        s            toggle session token usage page (by model; legacy bucket separate)
#        click        left-click a subagent row = enter (other lines ignored)
#        o            show it and move focus into it (to type to it)
#        -            clear the viewer
#        r / t        read its result / context packet in a popup
#        x            kill it (asks first)
#        c            archive killed subagents (tp-clean)
#
# Checks every second, painting only when the displayed frame changes, from each task's state.json (written by the reporters)
# and its pane. A key only redraws from what the last check read (load_data); only the once-a-second timer, and a key that
# changes something (view, kill, clean, read, or a move past the loaded window), reads the task records again.
#
# However many tasks the session has, the pane holds a window of them (lib/tp_window.py): the newest $TP_STATUS_WINDOW
# (60), and every task that is starting, working, needs_input or paused whatever its age. Older tasks are read from their
# records when a key moves to them (j/k at the first row, PgUp, g). Nothing on disk is deleted. When the newest task is
# selected the pane follows new workers; a task outside the window whose files changed gets its record (task.md) refreshed
# through tp-contract status (the C lines of tp_window.py); a background tick (tp-agent tick) that fails, or runs over a
# minute, is said in the footer on every frame until a later one succeeds; once the selection is anywhere else it stays put and the header says
# "new worker below" until G or moving down reaches the newest again. States (bin/tp-contract status): starting, working, needs_input,
# paused, settled (a reply is ready), completed (handed off), failed, killed, stopped (tp-kill),
# escalated. Under each row: elapsed time, turns, tool calls, for a contract (M9)
# its checkpoint state and when its artifact was last written, and for settled work
# the first line of its reply (or its question). Started by tp in the status slot;
# runs until the session ends.
set -o pipefail   # no -u: bash 3.2 treats empty arrays as unbound

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
source "$ROOT/lib/tp.sh"

session="$(tp_session)" || exit 1
state_dir="$(tp_opt "$session" @tp_state_dir)"
tasks="$state_dir/tasks"
session_label="session ${session//[[:cntrl:]]/?}"   # the header says whose tasks these are; they are this session's alone
last_tick=-5 tick_pid="" tick_note=""   # tick_note: why the background tick is not doing its work, shown in the footer
keep="${TP_STATUS_WINDOW-60}"
[[ "$keep" =~ ^[1-9][0-9]{0,5}$ ]] || { echo "tp-status: TP_STATUS_WINDOW must be a positive number, not '$keep'" >&2; exit 1; }
# What lib/tp_window.py learns about the tasks is kept between refreshes in this file, so a refresh reads only the records
# that changed. It is derived from the task files, private to this process, and removed with it.
cache_dir="$(mktemp -d "${TMPDIR:-/tmp}/tp-status.XXXXXX")" || { echo "tp-status: cannot make a cache directory" >&2; exit 1; }

esc=$'\e'
reset="${esc}[0m" bold="${esc}[1m" dim="${esc}[2m" rev="${esc}[7m"
red="${esc}[31m" green="${esc}[32m" yellow="${esc}[33m" magenta="${esc}[35m" cyan="${esc}[36m"

selected=""   # id of the selected row; kept across refreshes
follow=1      # 1 while the newest task is selected: a new worker is selected and scrolled to
win_start=newest   # where the loaded window starts: a list position, or newest while following
wstart=0 total=0 newest="" prev_newest="" seen_newest="" new_below=0   # from the last load
want="" want_pos=""   # what to select once a slid window has loaded: first / last row (g, G), or the row at a list position
row_pos=()    # list position of each row in ids
page_step=10  # rows a page key moves (the rows the last frame could show, less one)
message=""    # one-line feedback shown in the footer
ids=()
last_frame="" last_cols="" last_lines=""

page=list    # list, or stats (s): session token usage page
top=0         # first task shown when the list overflows the pane
row_ids=()    # screen line (1-based) -> subagent id, from the last painted frame

# Mouse tracking (button press + SGR coordinates) is on only while this process
# runs, so tmux's own mouse handling (copy-mode, focus) is untouched elsewhere.
#
# The tty stays non-echoing and non-canonical for the whole life of this process,
# not just inside `read -s` (which restores the mode it found after each read):
# mouse reports arriving while a frame is being rendered would otherwise be
# echoed into the pane as literal ^[[<64;x;yM. The previous mode is put back on
# exit so a shell that owns this tty (or a restarted status process) is not left
# without echo. No stty or no tty: carry on with per-read -s only.
tty_saved=""
if [[ -t 0 ]] && command -v stty >/dev/null 2>&1; then
  tty_saved="$(stty -g 2>/dev/null)" || tty_saved=""
  if [[ -n "$tty_saved" ]]; then stty -echo -icanon min 1 time 0 2>/dev/null || tty_saved=""; fi
fi
cleanup() {
  [[ -z "$cache_dir" ]] || rm -rf -- "$cache_dir"
  printf '%s[?1006l%s[?1000l%s[?25h%s[0m' "$esc" "$esc" "$esc" "$esc"
  if [[ -n "$tty_saved" ]]; then stty "$tty_saved" 2>/dev/null; fi
  return 0
}
printf '%s[?25l%s[?1000h%s[?1006h' "$esc" "$esc" "$esc"
trap cleanup EXIT
trap 'exit 143' TERM HUP INT

# The drawing helpers return their text in R (never a command substitution): a redraw forks and runs nothing.
color_for() {
  case "$1" in
    settled|waiting|done) R="$green" ;;
    working|tool|starting) R="$yellow" ;;
    needs_input|permission|paused) R="$magenta" ;;
    failed*|error) R="$red" ;;
    killed|stopped|completed|escalated) R="$dim" ;;
    *) R="" ;;
  esac
}

# clip <width> <text> — cut to the pane width so rows never wrap.
clip() { local w="$1"; shift; local t="$*"; if (( ${#t} > w )); then t="${t:0:w-1}…"; fi; R="$t"; }

# pad <width> <text> — left-align in characters (printf pads bytes, and ▸ ↑ ↓ are multibyte).
pad() { local t="$2"; printf -v R '%s%*s' "$t" $(( $1 > ${#t} ? $1 - ${#t} : 1 )) ""; }

# parse_window <output of lib/tp_window.py> — the task rows (R lines), the usage summary (U lines) and the window's
# facts (H line: total tasks, where the window starts, the newest task, each row's list position).
parse_window() {
  local line pos
  rows="" usage_lines=() row_pos=() changed_ids=()
  while IFS= read -r line; do
    case "$line" in
      H*) IFS=$'\x1f' read -r _ total wstart newest pos <<<"$line"
          IFS=, read -ra row_pos <<<"$pos" ;;
      R*) rows+="${line:1}"$'\n' ;;
      C*) changed_ids+=("${line:1}") ;;
      U*) usage_lines+=("${line:1}") ;;
    esac
  done <<<"$1"
  rows="${rows%$'\n'}"
}

# in_ids <id> — is the task one of the loaded rows?
in_ids() { local i; for i in "${!ids[@]}"; do [[ "${ids[$i]}" == "$1" ]] && return 0; done; return 1; }

# pick_wanted — select what a key asked for once the window it asked for has loaded: the first or last row (g, G), or the
# row at (the nearest to) the list position a move past the loaded rows asked for.
pick_wanted() {
  local i n=${#ids[@]} best=-1 gap
  (( n > 0 )) || { want="" want_pos=""; return 0; }
  case "$want" in
    first) selected="${ids[0]}" ;;
    last) selected="${ids[n - 1]}" ;;
  esac
  if [[ -n "$want_pos" ]]; then
    for (( i = 0; i < n; i++ )); do
      gap=$(( row_pos[i] > want_pos ? row_pos[i] - want_pos : want_pos - row_pos[i] ))
      if (( best < 0 || gap < best )); then best=$gap selected="${ids[i]}"; fi
    done
  fi
  want="" want_pos=""
}

# settle_follow — follow new workers exactly while the newest task is the selected one. Anywhere else the window stays
# where it is, and the newest task seen is remembered so a newer one can be announced.
settle_follow() {
  if [[ -z "$newest" || "$selected" == "$newest" ]]; then
    follow=1 win_start=newest seen_newest=""
  else
    if (( follow )); then seen_newest="$newest"; fi
    follow=0 win_start="$wstart"
  fi
  new_below=0
  if (( ! follow )) && [[ "$newest" != "$seen_newest" ]]; then new_below=1; fi
}

# tick_check — look at the background tick (tp-agent tick) started earlier without waiting for it. One that ended with a
# failure leaves tick_note, which the footer shows on every frame until a later tick succeeds; one that is still running
# after a minute is said too. The pane keeps painting either way.
tick_check() {
  local rc=0 detail
  [[ -n "$tick_pid" ]] || return 0
  if kill -0 "$tick_pid" 2>/dev/null; then
    (( SECONDS - last_tick > 60 )) && tick_note="background tick has run for $(( SECONDS - last_tick )) s"
    return 0
  fi
  wait "$tick_pid" 2>/dev/null || rc=$?
  tick_pid=""
  if (( rc == 0 )); then tick_note=""; return 0; fi
  detail="$(head -c 160 "$cache_dir/tick.err" 2>/dev/null | tr '\n' ' ')"
  tick_note="background tick failed (exit $rc)${detail:+: $detail}"
}

# load_data — read everything the frame is drawn from: the task rows of the window, their lifecycle details, the viewed
# task, the queue, the pane size, the usage page. render draws from these variables alone, so redrawing (a key that only
# moves the selection or scrolls) reads no file and runs no program. One process (lib/tp_window.py) picks the window
# and reads only the task records that changed since the last load; another (lib/tp_detail.py) works out, per row: final
# status, detail line, and the first lines of task.md and result.md that the selected row shows. The lifecycle details
# (tp-contract status) are asked for only the rows shown.
rows="" details="" current="" has_queue=0 nq=0 cols=80 frame_lines=24
rc_status=() rc_detail=() rc_has_reply=() rc_task=() rc_reply=()   # per row index
usage_lines=() queue_lines=() changed_ids=()   # changed_ids: tasks outside the window whose files changed since the last load
load_data() {
  local out id queued line panes pass
  tick_check
  if (( SECONDS - last_tick >= 5 )) && [[ -z "$tick_pid" ]]; then   # tp-agent tick reads every record; never wait for it here
    "$ROOT/bin/tp-agent" tick >/dev/null 2>"$cache_dir/tick.err" &
    tick_pid=$! last_tick=$SECONDS   # last_tick moves only when a tick was started, not while the last one still runs
  fi
  cols="$(tput cols)"
  frame_lines="$(tput lines)"
  panes="$(tmux list-panes -a -F '#{pane_id} #{pane_dead}')"
  for pass in 1 2; do
    if ! out="$(python3 "$TP_LIB_DIR/tp_window.py" "$tasks" "$panes" "$cache_dir/window.json" "$keep" "$win_start" 2>"$cache_dir/err")"; then
      message="cannot read the task list: $(head -c 200 "$cache_dir/err" | tr '\n' ' ')"
      return 0
    fi
    parse_window "$out"
    ids=()
    if [[ -n "$rows" ]]; then
      while IFS=$'\x1f' read -r id _; do ids+=("$id"); done <<<"$rows"
    fi
    pick_wanted
    if (( follow )) && [[ -n "$newest" ]] && [[ -z "$selected" || "$newest" != "$prev_newest" ]]; then selected="$newest"; fi
    prev_newest="$newest"
    # A selection that is no longer a row (cleaned away, or aged out of a window that was not following): the newest.
    if [[ -n "$selected" ]] && ! in_ids "$selected"; then
      selected="$newest" follow=1 win_start=newest
      (( pass == 1 )) && continue   # load the window of the newest tasks
    fi
    break
  done
  settle_follow
  details=""
  # Asked for: the rows shown, and the tasks outside the window whose files just changed (C lines): tp-contract status is the
  # writer of task.md, so asking is what keeps the record of a task nobody is looking at from going stale.
  if [[ -n "$rows" || ${#changed_ids[@]} -gt 0 ]]; then
    details="$("$ROOT/bin/tp-contract" status "${ids[@]}" "${changed_ids[@]}" 2>/dev/null)"
  fi
  current="$(tp_opt "$session" @tp_viewing)"
  rc_status=() rc_detail=() rc_has_reply=() rc_task=() rc_reply=()
  if [[ -n "$rows" ]]; then
    local st de hr tf rf
    while IFS=$'\x1f' read -r st de hr tf rf; do
      rc_status+=("$st") rc_detail+=("$de") rc_has_reply+=("$hr") rc_task+=("$tf") rc_reply+=("$rf")
    done < <(python3 "$TP_LIB_DIR/tp_detail.py" "$tasks" "$details" <<<"$rows")
  fi
  qfiles=()
  for queued in "$state_dir"/queue/*.json; do [[ -e "$queued" || -L "$queued" ]] && qfiles+=("$queued"); done
  nq=${#qfiles[@]}
  has_queue=0
  if compgen -G "$state_dir/queue/*.json" >/dev/null; then has_queue=1; fi
  queue_lines=()
  if (( nq )); then
    while IFS= read -r line; do queue_lines+=("$line"); done < <(tp_queue_lines "$state_dir")
  fi
}

render() {
  local qi qshow out i id worker status tool tokens cost model line c sel_index detail life role y header hint count_label n hdr budget sum_text sum_n sel_text sel_n msg_text msg_n need want used area full vis lines_left permission requested ul sl compact
  frame_cols="$cols"
  compact=0
  (( frame_lines < 16 )) && compact=1

  row_ids=()
  # Keep the selection on the same id; fall back to the newest subagent.
  sel_index=-1
  for i in "${!ids[@]}"; do if [[ "${ids[$i]}" == "$selected" ]]; then sel_index=$i; fi; done
  if (( sel_index < 0 && ${#ids[@]} > 0 )); then sel_index=$(( ${#ids[@]} - 1 )); selected="${ids[$sel_index]}"; fi
  if (( ${#ids[@]} == 0 )); then selected=""; fi

  # A tick that failed (or that runs too long) is flagged in the header, which every page and every pane height draws; the
  # footer carries the words, but the usage page and a compact pane have no footer.
  tick_flag=""
  case "$tick_note" in
    "background tick failed"*) tick_flag=" · ⚠ tick failed" ;;
    "") ;;
    *) tick_flag=" · ⚠ tick slow" ;;
  esac

  if [[ "$page" == stats ]]; then
    # Usage page: bounded to the pane, no clickable rows, any overflow counted.
    local nl keep=$(( frame_lines - 2 ))
    ul=("${usage_lines[@]}")
    (( ${#ul[@]} )) || ul=("no usage reported yet")
    nl=${#ul[@]}
    if (( nl > keep )); then
      (( keep < 1 )) && keep=1
      ul=("${ul[@]:0:keep-1}" "… $((nl - keep + 1)) more lines (enlarge pane)")
    fi
    out=""
    for line in "${ul[@]}"; do clip "$cols" "$line"; out+="${dim}${R}${reset}${esc}[K"$'\n'; done
    clip $((cols - 8 - ${#tick_flag} - ${#session_label} - 3)) "s back to list"
    header="${esc}[H${bold}usage${tick_flag} · ${session_label}${reset}${dim}  ${R}${reset}${esc}[K"$'\n'
    frame="${header}${out}${esc}[J"
    return 0
  fi
  out=""
  agents=0                   # task rows actually drawn
  n=${#ids[@]}

  # Frame budget: every line ends in a newline, so the last screen line stays
  # free (a newline there would scroll the header away and shift click rows).
  hdr=$(( compact ? 1 : 2 ))
  budget=$(( frame_lines - 1 - hdr )); (( budget < 0 )) && budget=0

  # Optional blocks, in priority order; each is dropped when it would squeeze
  # the task list below min(need, 6) lines.
  sum_text="" sum_n=0 sel_text="" sel_n=0 msg_text="" msg_n=0
  if (( ! compact )); then
    ul=("${usage_lines[@]}")
    if (( ${#ul[@]} )); then
      sum_text="${esc}[K"$'\n'; sum_n=1
      for sl in "${ul[@]}"; do clip "$cols" "$sl"; sum_text+="${dim}${R}${reset}${esc}[K"$'\n'; sum_n=$((sum_n + 1)); done
    fi
    if [[ -n "$selected" && $sel_index -ge 0 ]]; then   # the selected task's first lines were read by load_data
      clip "$cols" "── $selected "
      sel_text="${esc}[K"$'\n'"${cyan}${R}${reset}${esc}[K"$'\n'
      clip $((cols - 6)) "${rc_task[sel_index]}"
      sel_text+="${dim}task  ${reset}${R}${esc}[K"$'\n'; sel_n=4   # the lines, plus the one a here-string newline added to the old wc -l count
      if [[ -n "${rc_has_reply[sel_index]}" ]]; then
        clip $((cols - 6)) "${rc_reply[sel_index]}"
        sel_text+="${dim}reply ${reset}${R}${esc}[K"$'\n'; sel_n=5
      fi
    fi
    if [[ -n "$message" || -n "$tick_note" ]]; then   # a key's feedback first; the tick's failure otherwise, until it is gone
      clip "$cols" "${message:-$tick_note}"
      msg_text="${esc}[K"$'\n'"${yellow}${R}${reset}${esc}[K"$'\n'; msg_n=2
    fi
  fi
  need=$(( (compact ? (n > 0 ? n : 1) : (n > 0 ? 2 * n : 1)) + nq ))
  want=$(( need < 6 ? need : 6 ))
  used=0
  if (( budget - used - sum_n >= want )); then used=$((used + sum_n)); else sum_text=""; fi
  if (( budget - used - sel_n >= want )); then used=$((used + sel_n)); else sel_text=""; fi
  if (( budget - used - msg_n >= want )); then used=$((used + msg_n)); else msg_text=""; fi
  area=$(( budget - used ))

  full=0
  (( ! compact && need <= area )) && full=1
  vis=$n; (( vis > area )) && vis=$area
  (( full )) && vis=$n
  page_step=$(( vis > 2 ? vis - 1 : 1 ))
  # Keep the selected task inside the visible window of an overflowing list.
  if (( vis >= n )); then top=0; elif (( vis > 0 )); then
    (( sel_index < top )) && top=$sel_index
    (( sel_index >= top + vis )) && top=$(( sel_index - vis + 1 ))
    (( top > n - vis )) && top=$(( n - vis ))
    (( top < 0 )) && top=0
  fi
  y=$(( hdr + 1 ))           # first line below the header (and blank line)
  lines_left=$area
  if [[ -z "$rows" ]]; then
    if (( area >= 1 )); then
      if (( has_queue )); then
        out+="${dim}  waiting for a worker slot or dependency${reset}${esc}[K"$'\n'
      else
        out+="${dim}  no subagents yet${reset}${esc}[K"$'\n'
      fi
      y=$((y + 1)); lines_left=$((lines_left - 1))
    fi
  else
    i=0
    while IFS=$'\x1f' read -r id worker status tool tokens cost model; do
      if (( i < top || i >= top + vis )); then i=$((i + 1)); continue; fi
      status="${rc_status[i]}" detail="${rc_detail[i]}"
      if [[ "$id" == "$current" ]]; then line="▸ "; else line="  "; fi
      pad 20 "$id"; line+="$R"; pad 7 "$worker"; line+="$R"; pad 12 "$status"; line+="$R"
      pad 15 "$tokens"; line+="$R"; pad 8 "$cost"; line+="$R$model"
      color_for "$status"; c="$R"
      if (( i == sel_index )); then c+="$rev"; fi
      clip "$cols" "$line"
      out+="${c}${R}${reset}${esc}[K"$'\n'
      agents=$((agents + 1)); lines_left=$((lines_left - 1))
      row_ids[y]="$id"; y=$((y + 1))
      if (( full )); then
        if [[ -n "$tool" ]]; then detail="${detail:+$detail · }$tool"; fi
        if [[ -n "$detail" ]]; then clip $((cols - 4)) "$detail"; out+="${dim}    ${R}${reset}${esc}[K"$'\n'; y=$((y + 1)); lines_left=$((lines_left - 1)); fi
      fi
      i=$((i + 1))
    done <<<"$rows"
  fi
  if (( nq && lines_left >= 1 )); then
    # Every queue line that does not fit is counted: the last line left says how many are not shown (an entry shown
    # there instead would hide that others exist).
    qshow=${#queue_lines[@]}
    if (( qshow > lines_left )); then qshow=$(( lines_left - 1 )); fi
    for (( qi = 0; qi < qshow; qi++ )); do
      clip "$cols" "${queue_lines[qi]}"
      out+="${magenta}${R}${reset}${esc}[K"$'\n'
    done
    if (( qshow < ${#queue_lines[@]} )); then
      clip "$cols" "+$(( ${#queue_lines[@]} - qshow )) more queued (enlarge pane)"
      out+="${magenta}${R}${reset}${esc}[K"$'\n'
    fi
    lines_left=$(( lines_left - qshow - (qshow < ${#queue_lines[@]} ? 1 : 0) ))
  fi
  out+="$sum_text$sel_text$msg_text"
  count_label="subagents $agents"
  if (( agents < total )); then count_label+="/$total"; fi
  # No line was left for the queue (active rows filled the pane): the header carries the count instead, so queued and
  # refused entries are never silently absent.
  if (( nq && lines_left < 1 )); then count_label+=" · ${#queue_lines[@]} queued/refused (enlarge pane)"; fi
  if (( new_below )); then count_label+=" · ↓ new worker (G)"; fi
  count_label+="$tick_flag · $session_label"
  clip $((cols - ${#count_label} - 2)) "s stats · click/j/k move · g/G top/bottom · PgUp/PgDn · enter view · o focus · - clear · r result · t packet · x kill · c clean"
  header="${esc}[H${bold}${count_label}${reset}${dim}  ${R}${reset}${esc}[K"$'\n'
  (( compact )) || header+="${esc}[K"$'\n'
  frame="${header}${out}${esc}[J"
}

# Keep the one-second bounded poll (including elapsed contract info), but leave
# the terminal untouched when nothing visible changed. Repaint after a resize
# even if clipping happens to produce the same bytes (tmux may have cleared it).
paint() {
  render
  if [[ "$frame" != "$last_frame" || "$frame_cols" != "$last_cols" || "$frame_lines" != "$last_lines" ]]; then
    printf '%s' "$frame"
    last_frame="$frame" last_cols="$frame_cols" last_lines="$frame_lines"
  fi
}

# move <rows> — move the selection by that many tasks of the whole list. A task that is loaded is selected at once; one
# that is not (past the first or last loaded row, or in a gap between an old active task and the rest) is asked for: the
# window slides to put it in the middle and the next load reads it.
move() {
  local i idx=-1 n=${#ids[@]} pos target
  (( n > 0 )) || return 0
  for i in "${!ids[@]}"; do if [[ "${ids[$i]}" == "$selected" ]]; then idx=$i; fi; done
  (( idx >= 0 )) || return 0
  pos=${row_pos[idx]}
  target=$(( pos + $1 ))
  (( target < 0 )) && target=0
  (( target > total - 1 )) && target=$(( total - 1 ))
  (( target == pos )) && return 0
  for i in "${!row_pos[@]}"; do
    if (( row_pos[i] == target )); then selected="${ids[$i]}"; settle_follow; return 0; fi
  done
  leave_follow
  win_start=$(( target - keep / 2 )); (( win_start > total - keep )) && win_start=$(( total - keep )); (( win_start < 0 )) && win_start=0
  want_pos=$target reload=1
}

# leave_follow — the selection is about to leave the newest task: remember which one that was.
leave_follow() { if (( follow )); then seen_newest="$newest"; fi; follow=0; }

# go_top / go_bottom — g and G: the oldest and the newest task of the whole list.
go_top() {
  leave_follow
  if (( wstart == 0 && ${#ids[@]} > 0 )); then selected="${ids[0]}"; settle_follow; return 0; fi
  win_start=0 want=first reload=1
}
go_bottom() { follow=1 win_start=newest want=last reload=1; }

# run <cmd...> — run a tp-* command, showing its error (if any) in the footer.
run() { local err; if ! err="$("$@" 2>&1 >/dev/null)"; then message="${err##*: }"; fi; }

popup() {
  local file="$tasks/$selected/$1"
  if [[ ! -s "$file" ]]; then message="no $1 yet for $selected"; return; fi
  # Target an attached client explicitly; with none, display-popup would block.
  local client
  client="$(tmux list-clients -t "=$session:" -F '#{client_name}' 2>/dev/null | head -1)"
  if [[ -z "$client" ]]; then message="no attached client to show the popup"; return; fi
  run tmux display-popup -c "$client" -E -w 90% -h 80% -T " $selected: $1 " "less -R $(printf %q "$file")"
}

# Input that changes nothing (wheel, drag, release, unknown sequences) is drained
# without a repaint, so a scroll flood cannot build a backlog behind one render
# per event; the frame still refreshes at most once a second meanwhile.
#
# reload: read the task records again (load_data). The timer sets it, and so does any key that changes what is
# shown (view, focus, clear, read, clean, kill, click, g/G, a move past the loaded window). dirty: only redraw from what
# was last read (j/k, PgUp/PgDn inside the window, s).
dirty=1 reload=1 painted_at=-1
while true; do
  if (( dirty || reload || SECONDS != painted_at )); then
    if (( reload || SECONDS != painted_at )); then load_data; reload=0; fi
    paint
    painted_at=$SECONDS dirty=0
    message=""
  fi
  key=""
  IFS= read -rsn1 -t 1 key; rc=$?
  if (( rc > 128 )); then dirty=1 reload=1; continue; fi  # timeout: just refresh
  if (( rc != 0 )); then sleep 1; dirty=1 reload=1; continue; fi  # no tty (e.g. during resize)
  if [[ "$key" == "$esc" ]]; then
    key=ignore rest=""   # not Enter: unrecognised sequences and clicks fall through the key case
    # Consume one whole CSI sequence (through its final byte) so no tail is left
    # behind to be read as keys; a truncated sequence times out and is dropped.
    if IFS= read -rsn1 -t 1 c && [[ "$c" == "[" ]]; then
      n=0
      while (( n < 32 )) && IFS= read -rsn1 -t 1 c; do
        if [[ "$c" == "$esc" ]]; then   # cut short by the next sequence: start over on that one
          rest="" n=0
          IFS= read -rsn1 -t 1 c && [[ "$c" == "[" ]] || break
          continue
        fi
        n=$((n + 1)); rest+="$c"
        case "$c" in   # parameter/intermediate bytes continue; anything else is final
          [0-9\;\<\=\>\?\ \!\"\#\$%\&\'\(\)\*+,./-]) ;;
          *) break ;;
        esac
      done
    elif [[ "$c" == O ]]; then   # application-mode keys (ESC O H / ESC O F): one more byte
      IFS= read -rsn1 -t 1 c && rest="$c"
    fi
    case "$rest" in
      A) key=k ;;
      B) key=j ;;
      H|1~|7~) key=g ;;   # Home
      F|4~|8~) key=G ;;   # End
      5~) key=pgup ;;
      6~) key=pgdn ;;
      # SGR mouse "<b;x;yM": only a plain left press (b=0) on a task row acts.
      "<0;"*";"*M)
        if [[ "$rest" =~ ^\<0\;[0-9]+\;([0-9]+)M$ && -n "${row_ids[${BASH_REMATCH[1]}]:-}" ]]; then
          selected="${row_ids[${BASH_REMATCH[1]}]}"; settle_follow
          run "$ROOT/bin/tp-view" "$selected"
          dirty=1 reload=1
        fi ;;
    esac
  fi
  [[ "$key" == ignore ]] || dirty=1
  if [[ "$page" == stats && "$key" != s ]]; then key=ignore; fi   # list actions stay off the usage page
  case "$key" in
    s) if [[ "$page" == stats ]]; then page=list; else page=stats; fi ;;
    j) move 1 ;;
    k) move -1 ;;
    g) go_top ;;
    G) go_bottom ;;
    pgup) move $(( -page_step )) ;;
    pgdn) move "$page_step" ;;
    "") if [[ -n "$selected" ]]; then run "$ROOT/bin/tp-view" "$selected"; fi; reload=1 ;;
    o)
      reload=1
      if [[ -n "$selected" ]]; then
        run "$ROOT/bin/tp-view" "$selected"
        if [[ -z "$message" ]]; then tmux select-pane -t "$(tp_meta "$tasks/$selected" pane)"; fi
      fi ;;
    -) run "$ROOT/bin/tp-view" -; reload=1 ;;
    r) reload=1
       if [[ -n "$selected" ]]; then
         popup result.md
         "$ROOT/bin/tp-agent" collect "$selected" >/dev/null 2>&1   # read here = handed off
       fi ;;
    t) if [[ -n "$selected" ]]; then
         # Tasks spawned before M4 have no packet.
         if [[ -f "$tasks/$selected/packet.md" ]]; then popup packet.md; else popup task.md; fi
       fi ;;
    c) message="$("$ROOT/bin/tp-clean" 2>&1)"; reload=1 ;;
    x)
      reload=1
      if [[ -n "$selected" ]]; then
        message="kill $selected? y/n"; paint; message=""
        IFS= read -rsn1 answer
        if [[ "$answer" == y ]]; then run "$ROOT/bin/tp-kill" "$selected"; fi
      fi ;;
  esac
done
