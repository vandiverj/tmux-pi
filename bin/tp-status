#!/usr/bin/env bash
# tp-status — interactive subagent list for the status slot.
#
# Keys:  j/k or ↑/↓   move
#        enter        show the selected subagent in the viewer
#        o            show it and move focus into it (to type to it)
#        -            clear the viewer
#        r / t        read its result / context packet in a popup
#        x            kill it (asks first)
#        c            archive killed subagents (tp-clean)
#
# Checks every second, painting only when the displayed frame changes, from each task's state.json (written by the reporters)
# and its pane. States (bin/tp-contract status): starting, working, needs_input,
# paused, settled (a reply is ready), completed (handed off), failed, killed,
# escalated. Under each row: elapsed time, turns, tool calls, for a contract (M9)
# its checkpoint state and when its artifact was last written, and for settled work
# the first line of its reply (or its question). Started by tp in the status slot;
# runs until the session ends.
set -o pipefail   # no -u: bash 3.2 treats empty arrays as unbound

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"
source "$ROOT/lib/tp.sh"

session="$(tp_session)" || exit 1
tasks="$(tp_opt "$session" @tp_state_dir)/tasks"

esc=$'\e'
reset="${esc}[0m" bold="${esc}[1m" dim="${esc}[2m" rev="${esc}[7m"
red="${esc}[31m" green="${esc}[32m" yellow="${esc}[33m" magenta="${esc}[35m" cyan="${esc}[36m"

selected=""   # id of the selected row; kept across refreshes
message=""    # one-line feedback shown in the footer
ids=()
last_frame="" last_cols="" last_lines=""

printf '%s[?25l' "$esc"
trap 'printf "%s[?25h%s[0m" "$esc" "$esc"' EXIT

color_for() {
  case "$1" in
    settled|waiting|done) echo "$green" ;;
    working|tool|starting) echo "$yellow" ;;
    needs_input|permission|paused) echo "$magenta" ;;
    failed*|error) echo "$red" ;;
    killed|completed|escalated) echo "$dim" ;;
    *) echo "" ;;
  esac
}

# clip <width> <text> — cut to the pane width so rows never wrap.
clip() { local w="$1"; shift; local t="$*"; if (( ${#t} > w )); then t="${t:0:w-1}…"; fi; printf '%s' "$t"; }

# pad <width> <text> — left-align in characters (printf pads bytes, and ▸ ↑ ↓ are multibyte).
pad() { local t="$2"; printf '%s%*s' "$t" $(( $1 > ${#t} ? $1 - ${#t} : 1 )) ""; }

render() {
  local cols rows current out i id worker status tool tokens cost model line c sel_index details detail life
  cols="$(tput cols)"
  frame_cols="$cols"
  frame_lines="$(tput lines)"
  rows="$(tp_rows "$session")"
  details=""
  if [[ -n "$rows" ]]; then details="$("$ROOT/bin/tp-contract" status 2>/dev/null)"; fi
  current="$(tp_opt "$session" @tp_viewing)"

  ids=()
  if [[ -n "$rows" ]]; then
    while IFS=$'\x1f' read -r id _; do ids+=("$id"); done <<<"$rows"
  fi
  # Keep the selection on the same id; fall back to the newest subagent.
  sel_index=-1
  for i in "${!ids[@]}"; do if [[ "${ids[$i]}" == "$selected" ]]; then sel_index=$i; fi; done
  if (( sel_index < 0 && ${#ids[@]} > 0 )); then sel_index=$(( ${#ids[@]} - 1 )); selected="${ids[$sel_index]}"; fi
  if (( ${#ids[@]} == 0 )); then selected=""; fi

  out="${esc}[H${bold}subagents${reset}${dim}  $(clip $((cols - 11)) "j/k move · enter view · o focus · - clear · r result · t packet · x kill · c clean")${reset}${esc}[K"$'\n'"${esc}[K"$'\n'
  if [[ -z "$rows" ]]; then
    out+="${dim}$(clip "$cols" "  no subagents — tp-spawn \"task\" to start one")${reset}${esc}[K"$'\n'
  else
    i=0
    while IFS=$'\x1f' read -r id worker status tool tokens cost model; do
      life="$(awk -F $'\x1f' -v id="$id" '$1 == id { print $2 }' <<<"$details")"
      if [[ -n "$life" ]]; then status="$life"; fi
      if [[ "$id" == "$current" ]]; then line="▸ "; else line="  "; fi
      line+="$(pad 20 "$id")$(pad 7 "$worker")$(pad 12 "$status")$(pad 15 "$tokens")$(pad 8 "$cost")$model"
      c="$(color_for "$status")"
      if (( i == sel_index )); then c+="$rev"; fi
      out+="${c}$(clip "$cols" "$line")${reset}${esc}[K"$'\n'
      detail="$(awk -F $'\x1f' -v id="$id" '$1 == id { print $3 }' <<<"$details")"
      if [[ -n "$tool" ]]; then detail="${detail:+$detail · }$tool"; fi
      if [[ -n "$detail" ]]; then out+="${dim}    $(clip $((cols - 4)) "$detail")${reset}${esc}[K"$'\n'; fi
      i=$((i + 1))
    done <<<"$rows"
  fi

  # Aggregate main + all worker state by exact model. Keep cache separate from
  # uncached input so the session's context reuse is visible.
  local totals tm ti tc to
  totals="$( { find "$tasks" -mindepth 2 -maxdepth 2 -name state.json -print 2>/dev/null; echo "$(dirname "$tasks")/main/state.json"; } | while IFS= read -r f; do
    [[ -f "$f" ]] && cat "$f"
  done | jq -rs '
    map(select(.model != null and .model != "" and .tokens != null))
    | sort_by(.model) | group_by(.model)[]
    | {model: .[0].model, input: (map(.tokens.input // 0) | add), cache: (map((.tokens.cacheRead // 0) + (.tokens.cacheWrite // 0)) | add), output: (map(.tokens.output // 0) | add)}
    | "\(.model)\u001f\(.input)\u001f\(.cache)\u001f\(.output)"' -r 2>/dev/null)"
  if [[ -n "$totals" ]]; then
    out+="${esc}[K"$'\n'"${bold}session tokens by model${reset}${esc}[K"$'\n'
    while IFS=$'\x1f' read -r tm ti tc to; do
      out+="${dim}$(pad 30 "$tm")${reset}in $(pad 9 "$ti") cache $(pad 9 "$tc") out $to${esc}[K"$'\n'
    done <<<"$totals"
  fi

  if [[ -n "$selected" ]]; then
    local d="$tasks/$selected" first
    out+="${esc}[K"$'\n'"${cyan}$(clip "$cols" "── $selected ")${reset}${esc}[K"$'\n'
    first="$(grep -m1 -v '^[[:space:]]*$' "$d/task.md" 2>/dev/null)"
    out+="${dim}task  ${reset}$(clip $((cols - 6)) "$first")${esc}[K"$'\n'
    if [[ -s "$d/result.md" ]]; then
      first="$(grep -m1 -v '^[[:space:]]*$' "$d/result.md")"
      out+="${dim}reply ${reset}$(clip $((cols - 6)) "$first")${esc}[K"$'\n'
    fi
  fi
  if [[ -n "$message" ]]; then out+="${esc}[K"$'\n'"${yellow}$(clip "$cols" "$message")${reset}${esc}[K"$'\n'; fi
  out+="${esc}[J"
  frame="$out"
}

# Keep the one-second bounded poll (including elapsed contract info), but leave
# the terminal untouched when nothing visible changed. Repaint after a resize
# even if clipping happens to produce the same bytes (tmux may have cleared it).
paint() {
  render
  if [[ "$frame" != "$last_frame" || "$frame_cols" != "$last_cols" || "$frame_lines" != "$last_lines" ]]; then
    printf '%s' "$frame"
    last_frame="$frame" last_cols="$frame_cols" last_lines="$frame_lines"
  fi
}

move() {
  local i n=${#ids[@]}
  (( n > 0 )) || return 0
  for i in "${!ids[@]}"; do
    if [[ "${ids[$i]}" == "$selected" ]]; then
      i=$(( i + $1 )); (( i < 0 )) && i=0; (( i >= n )) && i=$(( n - 1 ))
      selected="${ids[$i]}"; return 0
    fi
  done
}

# run <cmd...> — run a tp-* command, showing its error (if any) in the footer.
run() { local err; if ! err="$("$@" 2>&1 >/dev/null)"; then message="${err##*: }"; fi; }

popup() {
  local file="$tasks/$selected/$1"
  if [[ ! -s "$file" ]]; then message="no $1 yet for $selected"; return; fi
  # Target an attached client explicitly; with none, display-popup would block.
  local client
  client="$(tmux list-clients -t "=$session:" -F '#{client_name}' 2>/dev/null | head -1)"
  if [[ -z "$client" ]]; then message="no attached client to show the popup"; return; fi
  run tmux display-popup -c "$client" -E -w 90% -h 80% -T " $selected: $1 " "less -R $(printf %q "$file")"
}

while true; do
  paint
  message=""
  key=""
  IFS= read -rsn1 -t 1 key; rc=$?
  if (( rc > 128 )); then continue; fi          # timeout: just refresh
  if (( rc != 0 )); then sleep 1; continue; fi  # no tty (e.g. during resize)
  if [[ "$key" == "$esc" ]]; then
    IFS= read -rsn2 -t 1 rest
    case "$rest" in "[A") key=k ;; "[B") key=j ;; *) key="" ;; esac
  fi
  case "$key" in
    j) move 1 ;;
    k) move -1 ;;
    "") if [[ -n "$selected" ]]; then run "$ROOT/bin/tp-view" "$selected"; fi ;;
    o)
      if [[ -n "$selected" ]]; then
        run "$ROOT/bin/tp-view" "$selected"
        if [[ -z "$message" ]]; then tmux select-pane -t "$(tp_meta "$tasks/$selected" pane)"; fi
      fi ;;
    -) run "$ROOT/bin/tp-view" - ;;
    r) if [[ -n "$selected" ]]; then
         popup result.md
         "$ROOT/bin/tp-contract" collect "$selected" >/dev/null 2>&1   # read here = handed off
       fi ;;
    t) if [[ -n "$selected" ]]; then
         # Tasks spawned before M4 have no packet.
         if [[ -f "$tasks/$selected/packet.md" ]]; then popup packet.md; else popup task.md; fi
       fi ;;
    c) message="$("$ROOT/bin/tp-clean" 2>&1)" ;;
    x)
      if [[ -n "$selected" ]]; then
        message="kill $selected? y/n"; paint; message=""
        IFS= read -rsn1 answer
        if [[ "$answer" == y ]]; then run "$ROOT/bin/tp-kill" "$selected"; fi
      fi ;;
  esac
done
