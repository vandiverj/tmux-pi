{
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob",
      "Bash(ls:*)", "Bash(pwd)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
      "Bash(grep:*)", "Bash(rg:*)", "Bash(find:*)", "Bash(sed -n:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git branch --show-current)",
      "Bash(python3 -m unittest:*)", "Bash(pytest:*)", "Bash(npm test:*)", "Bash(npm run test:*)", "Bash(cargo test:*)", "Bash(go test:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)", "Bash(sudo:*)", "Bash(git push:*)", "Bash(git reset --hard:*)", "Bash(git clean:*)",
      "Bash(curl:* | sh)", "Bash(wget:* | sh)"
    ]
  }
}
