{
  "backend": "laya",
  "laya": {
    "base_url": "http://127.0.0.1:11436",
    "model": "typed-decisions"
  },
  "openai": {
    "base_url": "http://127.0.0.1:11435/v1",
    "model": "qwen3.8-flash-next:4bit"
  },
  "timeout_seconds": 60,
  "models": [
    {
      "worker": "pi",
      "model": "slotstream/qwen3.8-flash-next:4bit",
      "thinking": ["off", "low", "medium"]
    },
    {
      "worker": "pi",
      "model": "lmstudio/qwen/qwen3.6-35b-a3b",
      "thinking": ["off"]
    },
    {
      "worker": "pi",
      "model": "openai/gpt-6-luna",
      "thinking": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
    },
    {
      "worker": "pi",
      "model": "openai/gpt-6-sol",
      "thinking": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
    },
    {
      "worker": "pi",
      "model": "openai/gpt-6-astra",
      "thinking": ["minimal", "low", "medium", "high", "xhigh", "max"]
    },
    {
      "worker": "claude",
      "model": "claude-haiku-5-5",
      "thinking": ["low", "medium", "high"]
    },
    {
      "worker": "claude",
      "model": "claude-sonnet-5-5",
      "thinking": ["low", "medium", "high"]
    },
    {
      "worker": "claude",
      "model": "claude-opus-5-5",
      "thinking": ["low", "medium", "high"]
    }
  ],
  "routes": {
    "simple": {"model": "slotstream/qwen3.8-flash-next:4bit", "thinking": "off"},
    "standard": {"model": "slotstream/qwen3.8-flash-next:4bit", "thinking": "low"},
    "coding": {"model": "openai/gpt-6-sol", "thinking": "medium"},
    "complex": {"model": "openai/gpt-6-sol", "thinking": "high"},
    "expert": {"model": "claude-opus-5-5", "thinking": "high"}
  },
  "claude_preference": {
    "ordinary": {"model": "claude-sonnet-5-5", "thinking": "medium"},
    "heavy": {"model": "claude-opus-5-5", "thinking": "high"},
    "heavy_when": {"difficulty_at_least": 2.5, "high_risk_at_least": 0.5, "sensitive_at_least": 0.5,
                   "scopes": []}
  },
  "laya_model": "laya-model.json"
}
