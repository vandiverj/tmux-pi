{
  "_comment": "Probes for lib/routines.py (tp-improve routines). Order is significant: the first matching probe claims a call, so specific probes come before the general ones they are part of. probes match a Bash command (heredoc bodies cut out); path_probes match the path a Read/Edit/Write call targets. The \"git fetch\" entry is a placeholder that keeps its place in the order (keys_for matches it from git's parsed subcommand). Most entries are specific to the Airtera/DMP monorepo; lane_pattern names its lanes.",
  "lane_pattern": "\\bdmp-\\d+[\\w-]*",
  "probes": {
    "deno binary path discovery (mise path/which deno)": "mise/installs/deno|DENO=|which deno|command -v deno|deno --version",
    "gitleaks run": "gitleaks",
    "semgrep run": "semgrep",
    "node_modules/.bin lookup (ls/which)": "ls [^;|&]*node_modules/\\.bin|which (prettier|jest|tsc)|ls [^;|&]*node_modules( |$)",
    "prettier --check/--write": "prettier",
    "eslint": "\\beslint\\b",
    "web jest zod4 scratch config": "jest\\.zod4|zod4",
    "path with (protected) parens in a command": "\\(protected\\)",
    "jest --runTestsByPath": "runTestsByPath",
    "web jest (any)": "\\bjest\\b",
    "api DB test wrapper api-db-test*.sh": "api-db-test",
    "direct deno task test": "deno task test|\\$DENO test|deno test",
    "revert deno.lock/deno.test.json after tests": "checkout -- [^;&]*deno\\.(lock|test\\.json)|git checkout [^;&]*deno\\.lock",
    "typecheck (tsc / deno check)": "\\btsc\\b|deno check|npm run typecheck",
    "gate: npm run check:*": "npm run check:",
    "gate: npm run smoke:*": "npm run smoke:",
    "npm run build": "npm run build",
    "drizzle migration/journal/snapshot": "drizzle|_journal|snapshot\\.json|prevId|meta/\\d{4}",
    "lane base / merge-base / origin base": "merge-base|sprint2-base|origin/DMP|origin/develop",
    "git fetch": "(?!)",
    "git status/log orientation": "git (-C \\S+ )?(status|log --oneline|branch --show-current)",
    "git add+commit": "git (-C \\S+ )?commit",
    "read review report": "review-[\\w-]+/report\\.md|tasks/review",
    "tp-agent --help/-h/help": "tp-agent (--help|-h|help)\\b",
    "tp-agent request": "tp-agent request\\b",
    "tp-agent (any)": "tp-agent",
    "test-runs log dir (campaign logs)": "test-runs/",
    "pre-commit gate bundle (prettier|eslint|gitleaks|tsc|deno check)": "prettier|\\beslint\\b|gitleaks|\\btsc\\b|deno check",
    "find prior task dir (ls .../tasks)": "ls [^|;&]*tasks(/| |$)|ls -t[^|;&]*tasks|find [^|;&]*tasks",
    "find worktree (worktree list / ls Projects)": "git (-C \\S+ )?worktree list|ls [^|;&]*airtera-monorepo-wt|ls [^|;&]*Projects( |$)",
    "serialized 5-run loop": "for \\w+ in (1 2 3 4 5|\\$\\(seq 1 5\\)|\\{1\\.\\.5\\})|seq 1 5",
    "check-requirements prototype script": "check:requirements|check-requirements"
  },
  "path_probes": {
    "Read: lane/brief common brief (lane-common/brief-common)": "lane-common|brief-common",
    "Read: campaign research/decision doc": "campaigns/[^/]+/(research|briefs/sprint|cases)/",
    "Read: review report.md": "review-[\\w-]+/report\\.md|tasks/review",
    "Read: prototype (engineering-context damp-prototype)": "engineering-context/domains/drug/damp-prototype",
    "Write/Edit: scratch jest zod4 config": "jest\\.zod4",
    "Read: prior task result/report": "tasks/(coder|researcher|tester)-[0-9a-f]+/(result|report)\\.md"
  }
}
