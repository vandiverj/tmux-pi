+    def test_the_archive_name_is_owned_before_the_move_so_a_third_party_directory_is_never_replaced_or_removed(self):
+        # theirs appears (empty) just before our mkdir: it is skipped, the next name is used, theirs is still there and empty
+        e = self.legacy_task("name-taken")
+        real_mkdir = os.mkdir
+
+        def mkdir(path, *a, **kw):
+            if Path(path).name == "name-taken" and not os.path.lexists(path):
+                real_mkdir(path)   # the other party wins the race for this name
+            return real_mkdir(path, *a, **kw)
+        with mock.patch.object(task_record.os, "mkdir", side_effect=mkdir):
+            dest = task_record.archive_task(self.state, e)
+        self.assertNotEqual(dest, self.archive_of("name-taken"))
+        self.assertTrue(dest.name.startswith("name-taken-ended-"))
+        self.assertEqual(list(self.archive_of("name-taken").iterdir()), [])   # theirs: not renamed onto, not removed
+        self.assertReadersFindTheArtifactIn(dest)
+        # theirs tries to take the name we own, between the reservation and the move: it fails, ours is the one renamed onto
+        f = self.legacy_task("name-owned")
+        real_rename, theirs = os.rename, []
+
+        def rename(src, dst):
+            try:
+                real_mkdir(dst)
+            except FileExistsError:
+                theirs.append("refused")
+            return real_rename(src, dst)
+        with mock.patch.object(task_record.os, "rename", side_effect=rename):
+            dest = task_record.archive_task(self.state, f)
+        self.assertEqual((theirs, dest), (["refused"], self.archive_of("name-owned")))
+        self.assertReadersFindTheArtifactIn(dest)
