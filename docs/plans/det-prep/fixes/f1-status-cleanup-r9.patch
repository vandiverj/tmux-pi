+class AfterArchivingTests(StepCase):
+    """What other commands do with a task still in tasks/ is the same once the retired ones have gone: `lane close` on a closed
+    step, a review of a kept author. (A lane's records are the real ones: a repository, a worktree, lane.json.)"""
+
+    def retire(self):
+        with mock.patch.object(worker_process, "kill_dead_pane", return_value="gone"):
+            return task_record.retire(self.state, panes={}, now=time.time() + 7200, settings=SETTINGS)
+
+    def test_lane_close_on_a_closed_step_and_the_next_step_behave_as_before_its_writer_is_archived(self):
+        author, reviewer = self.approved_and_committed()
+        before = self.closes()
+        result = self.retire()
+        self.assertEqual(sorted(result["archived"]), sorted([author, reviewer]))
+        self.assertEqual(list((self.state / "tasks").iterdir()), [])
+        self.assertTrue((self.state / "archive" / author).is_dir())
+        self.untouched(self.close, "step s1 is already closed at", before["closed"][0]["commit"], "nothing to do")
+        item, _ = self.existing(step="s2")                      # and the lane takes its next step
+        self.assertEqual((item["lane"], item["lane_step"]), ("alpha", "s2"))
+
+    def test_a_kept_author_can_still_be_reviewed(self):
+        author, _ = self.writer()                               # step s1 is open: its writer is not retired
+        self.edit()
+        self.commit()
+        result = self.retire()
+        self.assertEqual((result["archived"], result["kept"]), ([], [(author, "open lane step s1")]))
+        reviewer = self.new_reviewer(author)                    # tp-agent review AUTHOR --force, as a person types it
+        self.assertTrue((reviewer / "review-of").read_text().strip() == author)
+        self.assertTrue((self.state / "tasks" / author).is_dir())
