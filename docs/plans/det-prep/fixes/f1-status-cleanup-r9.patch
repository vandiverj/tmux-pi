+def make_task(tasks, panes, name, pane="gone", exit=None, reply=REPLY, state="waiting", files=None, meta=None, minutes=120, now=NOW,
+              worker="pi"):
+    """A task directory `name` in `tasks`. pane: gone (not in the pane list), dead or alive (its entry in `panes`, {id: alive}).
+    exit: the exit file's text. meta: more keys for meta.json, or the file's raw text. Every file is `minutes` old at `now`."""
+    d = tasks / name
+    d.mkdir()
+    pane_id = pane_of(name)
+    if pane != "gone":
+        panes[pane_id] = pane == "alive"
+    record = {"id": name, "worker": worker, "pane": pane_id, "model": "", "thinking": ""}
+    record = meta if isinstance(meta, str) else {**record, **(meta or {})}
+    (d / "meta.json").write_text(record if isinstance(record, str) else json.dumps(record))
+    (d / "state.json").write_text(json.dumps({"state": state, "model": "m", "tokens": {}}))
+    if reply is not None:
+        (d / "result.md").write_text(reply)
+    if exit is not None:
+        (d / "exit").write_text(str(exit))
+    for fname, value in (files or {}).items():
+        (d / fname).write_text(value if isinstance(value, str) else json.dumps(value))
+    stamp = now - minutes * 60
+    for path in d.iterdir():
+        os.utime(path, (stamp, stamp))
+    return d
+
