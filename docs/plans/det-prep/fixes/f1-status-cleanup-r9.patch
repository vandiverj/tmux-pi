+    def legacy_task(self, name, **kw):
+        """A legacy task (task.md is the raw request, no request.md) naming a ticket and an artifact inside itself: the reconcile
+        writes request.md, retention.json, task.md and meta.json."""
+        whole = {"kind": "task", "artifact": str(self.tasks / name / "out.md"), "stall": 10 ** 9, "grace": 1, "checkpoints": {},
+                 "budget": {"seconds": 10 ** 9, "turns": None, "tokens": None}}   # whole enough for the ledger row to be worked out
+        d = self.task(name, meta={"contract": whole}, **kw)
+        (d / "task.md").write_text("youtrack: ABC-12 fix please\n")
+        (d / "out.md").write_text("artifact\n")
+        os.utime(d / "meta.json", (NOW - 7200, NOW - 7200))
+        return d
+
+    def archive_of(self, name):
+        return self.state / "archive" / name
+
+    def assertReadersFindTheArtifactIn(self, d):
+        """Every reader of the contract artifact (the shared resolver, the ledger row, tp-contract's own lookups, task.md's status
+        line) finds out.md in the directory `d` it is read from, whatever meta.json holds, and task.md names no other location."""
+        meta = json.loads((d / "meta.json").read_text())
+        expected = str(d / "out.md")
+        self.assertTrue(os.path.isfile(task_archive.artifact_path(d, meta["contract"]["artifact"])))
+        self.assertEqual(task_archive.artifact_path(d, meta["contract"]["artifact"]), expected)
+        self.assertEqual(contract.ledger_row(d, NOW)["artifact"], expected)
+        self.assertEqual(contract.ledger_row(d, NOW)["artifact_chars"], len("artifact\n"))
+        if d.parent == self.tasks:   # tp-contract works on active tasks only
+            for _, found in (tp_contract().find(self.state, d.name),):
+                self.assertEqual(found["contract"]["artifact"], expected)
+            self.assertEqual([m["contract"]["artifact"] for _, m in tp_contract().tasks(self.state)], [expected])
+        text = (d / "task.md").read_text()
+        if task_record.is_canonical(text):   # (a task.md writer that failed leaves the legacy text, which names nothing)
+            self.assertIn("(present)", text)   # task.md's own status line found the file too
+            self.assertNotIn(str(self.state / "archive"), text)   # it says nothing of where the task will be
+            self.assertEqual([line for line in text.splitlines() if str(d) in line and "origin" not in line], [])   # nor of where it is read from now
+
+    def assertStaysAndArchivesLater(self, d):
+        """The task is still in tasks/, still a task (its meta.json reads, nothing stray beside it, nothing in archive/), every reader
+        of its artifact finds it there, and a second run with nothing failing archives it, readers finding it at the archive."""
+        self.assertTrue(d.is_dir())
+        self.assertEqual(json.loads((d / "meta.json").read_text())["id"], d.name)
+        self.assertEqual(sorted(p.name for p in self.tasks.iterdir()), [d.name])
+        self.assertEqual(list((self.state / "archive").iterdir()), [])
+        self.assertReadersFindTheArtifactIn(d)
+        dest = task_record.archive_task(self.state, d)
+        self.assertEqual(dest, self.archive_of(d.name))
+        self.assertFalse(d.exists())
+        self.assertEqual(json.loads((dest / "meta.json").read_text())["contract"]["artifact"], "out.md")
+        self.assertReadersFindTheArtifactIn(dest)
