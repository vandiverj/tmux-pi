+
+    def depth(name):   # how many retired ancestors the task has: the deepest (the children) go first
+        seen, count = {name}, 0
+        while isinstance(parents.get(name), str) and parents[name] in parents and parents[name] not in seen:
+            name = parents[name]
+            seen.add(name)
+            count += 1
+        return count
