+class TpCleanRetiredTests(StateFixture):
+    """`tp-clean --retired` as a program, tmux a stub that serves a pane list and logs the panes it is asked to kill."""
+
+    def setUp(self):
+        super().setUp()
+        bin_dir = self.root / "bin"
+        bin_dir.mkdir()
+        tmux = bin_dir / "tmux"
+        tmux.write_text('#!/bin/sh\ncase "$1" in\n has-session) exit 0 ;;\n show-options) printf \'%s\\n\' "$TP_STATE_DIR" ;;\n'
+                        ' list-panes) cat "$FAKE_PANES" ;;\n'
+                        ' kill-pane) [ -z "$FAKE_KILL_FAIL" ] || { echo "no permission" >&2; exit 1; }; echo "$3" >> "$FAKE_KILLS"; grep -v "^$3 " "$FAKE_PANES" > "$FAKE_PANES.new"; mv "$FAKE_PANES.new" "$FAKE_PANES" ;;\n'
+                        'esac\n')
+        tmux.chmod(0o755)
+        self.pane_file, self.kill_file = self.root / "panes", self.root / "kills"
+        self.env = {**os.environ, "PATH": str(bin_dir) + os.pathsep + os.environ["PATH"], "TP_STATE_DIR": str(self.state),
+                    "TP_SESSION": "fixture", "FAKE_PANES": str(self.pane_file), "FAKE_KILLS": str(self.kill_file)}
+        self.env.pop("TMUX", None)
+        self.env.pop("TP_ORCHESTRATION_CONFIG", None)
+        self.now = time.time()
+
+    def build(self):
+        self.task("dead-failed", pane="dead", exit=1, reply=None, now=self.now)
+        self.task("gone-killed", now=self.now)
+        self.task("live-failed", pane="alive", exit=1, now=self.now)
+        self.task("fresh-killed", minutes=10, now=self.now)
+        self.task("busy", pane="alive", state="working", reply=None, now=self.now)
+        self.pane_file.write_text("".join("%s %d\n" % (pane, 0 if alive else 1) for pane, alive in self.panes.items()))
+
+    def task(self, name, **kw):
+        return make_task(self.tasks, self.panes, name, **kw)
+
+    def run_clean(self, *args):
+        return subprocess.run([str(ROOT / "bin/tp-clean"), *args], env=self.env, text=True, capture_output=True, timeout=30)
+
+    def kills(self):
+        return self.kill_file.read_text().split() if self.kill_file.exists() else []
+
+    def present(self):
+        return sorted(p.name for p in self.tasks.iterdir())
+
+    def test_it_archives_the_retired_set_closes_only_their_dead_panes_and_a_second_run_does_nothing(self):
+        self.build()
+        reasons = "fresh-killed: finished 10 min ago (kept 30 min); live-failed: pane %s still runs" % pane_of("live-failed")
+        first = self.run_clean("--retired")
+        self.assertEqual((first.returncode, first.stdout.strip()), (0, "archived 2, kept 2 (reasons: %s)" % reasons), first.stderr)
+        self.assertEqual(self.kills(), [pane_of("dead-failed")])                 # the dead pane; the gone one is not there to close
+        self.assertEqual(self.present(), ["busy", "fresh-killed", "live-failed"])
+        self.assertEqual(sorted(p.name for p in (self.state / "archive").iterdir()), ["dead-failed", "gone-killed"])
+        self.assertEqual(sorted(self.pane_file.read_text().split("\n")), sorted(["", pane_of("busy") + " 0", pane_of("live-failed") + " 0"]))
+        second = self.run_clean("--retired")
+        self.assertEqual((second.returncode, second.stdout.strip()), (0, "archived 0, kept 2 (reasons: %s)" % reasons), second.stderr)
+        self.assertEqual(self.kills(), [pane_of("dead-failed")])                 # nothing closed again
+        self.assertEqual(self.present(), ["busy", "fresh-killed", "live-failed"])
+        self.assertEqual(sorted(p.name for p in (self.state / "archive").iterdir()), ["dead-failed", "gone-killed"])
+
+    def test_a_task_waits_for_the_configured_minutes(self):
+        self.task("killed", minutes=10, now=self.now)
