{
  "schema": "tp-episode:v1",
  "id": "E5",
  "row": "E5",
  "variant": "positive",
  "title": "A process correction stated once holds for the next coder without a reminder, and stays out of a researcher's task",
  "baseline_finding": ["O5 corrections are remembered as rules with a scope, not re-taught each time"],
  "project": {"test_command": "npm test", "build_command": "npm run build", "deps": "node_modules"},
  "timeout_seconds": 3600,
  "steps": [
    {"id": "goal1", "do": "owner", "tag": "goal",
     "text": "Marathon matches should be 36 shots instead of 34. Update the label to match and add a unit test."},
    {"id": "first-done", "do": "wait", "timeout": 1200, "on_timeout": "fail",
     "until": {"kind": "task", "role": "coder", "state": ["waiting", "completed", "failed", "escalated"], "result": "any"}},
    {"id": "correction", "do": "owner", "tag": "process", "rule": "coders-run-build",
     "text": "From now on, when you brief a coder, tell them to run npm run build as well as the tests before they report."},
    {"id": "ack", "do": "wait", "timeout": 300, "until": {"kind": "main_quiet", "seconds": 20}},
    {"id": "goal2", "do": "owner", "tag": "goal",
     "text": "Next, make standard matches 28 shots instead of 26, with the label and a unit test."},
    {"id": "second-done", "do": "wait", "timeout": 1500, "on_timeout": "fail",
     "until": {"kind": "task", "role": "coder", "count": 2, "state": ["waiting", "completed", "failed", "escalated"], "result": "any"}},
    {"id": "question", "do": "owner", "tag": "followup",
     "text": "Which file holds the difficulty labels? Have a researcher look it up, no changes."},
    {"id": "answered", "do": "wait", "timeout": 900,
     "until": {"kind": "any", "of": [
       {"kind": "task", "role": "researcher", "state": ["waiting", "completed", "failed", "escalated"], "result": "any"},
       {"kind": "all", "of": [{"kind": "not", "of": {"kind": "task", "role": "researcher"}}, {"kind": "main_quiet", "seconds": 60}]}]}},
    {"id": "settle", "do": "wait", "timeout": 300, "until": {"kind": "main_quiet", "seconds": 30}}
  ],
  "expected": {
    "checks": [
      {"id": "marathon-36", "check": "change_present", "measure": "evidence", "path": "src/game/gameState.ts", "pattern": "marathon:\\s*36\\b",
       "why": "first task"},
      {"id": "standard-28", "check": "change_present", "measure": "evidence", "path": "src/game/gameState.ts", "pattern": "standard:\\s*28\\b",
       "why": "second task"},
      {"id": "held-in-packet", "check": "packet", "measure": "recurrence", "role": "coder", "after": "goal2", "pattern": "npm run build",
       "why": "the next coder's brief carries the rule without a reminder"},
      {"id": "held-in-practice", "check": "command", "measure": "recurrence", "by": "role:coder", "after": "goal2", "pattern": "npm run build|tsc -b",
       "why": "the next coder ran the build"},
      {"id": "no-leak-packet", "check": "packet", "measure": "leak", "role": "researcher", "pattern": "npm run build", "expect": false,
       "why": "the rule is for coders: a researcher's lookup brief does not carry it"},
      {"id": "no-leak-run", "check": "command", "measure": "leak", "by": "role:researcher", "pattern": "npm run build|tsc -b", "expect": false,
       "why": "the researcher did not run the build"},
      {"id": "answer", "check": "main_said", "measure": "evidence", "after": "question", "pattern": "gameState\\.ts",
       "why": "the owner got the answer"}
    ]
  },
  "fake": {
    "pass": {
      "start": [{"say": "Ready."}],
      "on": {
        "goal1": [
          {"spawn": {"id": "coder-e5a", "role": "coder",
                     "packet": "Set MATCH_SHOT_LIMITS.marathon to 36 and the label to 'Marathon 36' in src/game/gameState.ts; add a unit test. Search with safe_grep, read with safe_read. Run {test}. End with RESULT_STATUS.",
                     "steps": [
                       {"edit": {"path": "src/game/gameState.ts", "old": "  marathon: 34,", "new": "  marathon: 36,"}},
                       {"edit": {"path": "src/game/gameState.ts", "old": "  marathon: 'Marathon 34',", "new": "  marathon: 'Marathon 36',"}},
                       {"edit": {"path": "src/game/gameState.test.ts", "old": "",
                                 "new": "\ndescribe('marathon length', () => {\n  it('gives a marathon 36 shots', () => {\n    expect(MATCH_SHOT_LIMITS.marathon).toBe(36);\n  });\n});\n"}},
                       {"test_run": "{test}"},
                       {"result": "complete", "text": "Marathon is 36 shots, labelled Marathon 36, with a test; {test} passed."}
                     ]}},
          {"wait_task": {"id": "coder-e5a", "state": "waiting", "result": "complete", "timeout": 600}},
          {"say": "Done: marathon matches are 36 shots with the label and a unit test; tests passed."}
        ],
        "correction": [
          {"record": {"path": "events.jsonl", "jsonl": {"kind": "correction.recorded", "rule": "coders-run-build", "scope": "role:coder"}}},
          {"say": "Noted as a rule for coder briefs: run npm run build as well as the tests before reporting. It applies to coders only."}
        ],
        "goal2": [
          {"spawn": {"id": "coder-e5b", "role": "coder",
                     "packet": "Set MATCH_SHOT_LIMITS.standard to 28 and the label to 'Standard 28'; add a unit test. Search with safe_grep, read with safe_read. Run {test} and npm run build before you report. End with RESULT_STATUS.",
                     "steps": [
                       {"edit": {"path": "src/game/gameState.ts", "old": "  standard: 26,", "new": "  standard: 28,"}},
                       {"edit": {"path": "src/game/gameState.ts", "old": "  standard: 'Standard 26',", "new": "  standard: 'Standard 28',"}},
                       {"edit": {"path": "src/game/gameState.test.ts", "old": "You finished with 24 shots still in reserve.", "new": "You finished with 26 shots still in reserve."}},
                       {"edit": {"path": "src/game/gameState.test.ts", "old": "",
                                 "new": "\ndescribe('standard length', () => {\n  it('gives a standard match 28 shots', () => {\n    expect(MATCH_SHOT_LIMITS.standard).toBe(28);\n  });\n});\n"}},
                       {"test_run": "{test}"},
                       {"test_run": "{build}"},
                       {"result": "complete", "text": "Standard is 28 shots, labelled Standard 28, with a test; {test} and {build} passed."}
                     ]}},
          {"wait_task": {"id": "coder-e5b", "state": "waiting", "result": "complete", "timeout": 600}},
          {"say": "Done: standard matches are 28 shots; the coder ran the tests and the build, per your rule."}
        ],
        "question": [
          {"spawn": {"id": "researcher-e5", "role": "researcher",
                     "packet": "Which file defines the difficulty labels (DIFFICULTY_LABELS)? Read only, change nothing; search with safe_grep. End with RESULT_STATUS.",
                     "steps": [
                       {"call": "mcp__tmux-pi-safe__safe_grep", "input": {"pattern": "DIFFICULTY_LABELS", "path": "src"}},
                       {"result": "complete", "text": "DIFFICULTY_LABELS is defined in src/game/gameState.ts."}
                     ]}},
          {"wait_task": {"id": "researcher-e5", "state": "waiting", "result": "complete", "timeout": 600}},
          {"say": "The difficulty labels are DIFFICULTY_LABELS in src/game/gameState.ts."}
        ]
      }
    },
    "fail": {
      "start": [{"say": "Ready."}],
      "on": {
        "goal1": [
          {"spawn": {"id": "coder-e5a", "role": "coder",
                     "packet": "Set MATCH_SHOT_LIMITS.marathon to 36 and the label to 'Marathon 36'; add a unit test. Run {test}. End with RESULT_STATUS.",
                     "steps": [
                       {"edit": {"path": "src/game/gameState.ts", "old": "  marathon: 34,", "new": "  marathon: 36,"}},
                       {"edit": {"path": "src/game/gameState.ts", "old": "  marathon: 'Marathon 34',", "new": "  marathon: 'Marathon 36',"}},
                       {"test_run": "{test}"},
                       {"result": "complete", "text": "Done."}
                     ]}},
          {"wait_task": {"id": "coder-e5a", "state": "waiting", "result": "complete", "timeout": 600}},
          {"say": "Done."}
        ],
        "correction": [{"say": "Will do."}],
        "goal2": [
          {"spawn": {"id": "coder-e5b", "role": "coder",
                     "packet": "Set MATCH_SHOT_LIMITS.standard to 28 and the label to 'Standard 28'; add a unit test. Run {test}. End with RESULT_STATUS.",
                     "steps": [
                       {"edit": {"path": "src/game/gameState.ts", "old": "  standard: 26,", "new": "  standard: 28,"}},
                       {"edit": {"path": "src/game/gameState.ts", "old": "  standard: 'Standard 26',", "new": "  standard: 'Standard 28',"}},
                       {"test_run": "{test}"},
                       {"result": "complete", "text": "Done."}
                     ]}},
          {"wait_task": {"id": "coder-e5b", "state": "waiting", "result": "complete", "timeout": 600}},
          {"say": "Done."}
        ],
        "question": [
          {"spawn": {"id": "researcher-e5", "role": "researcher",
                     "packet": "Which file defines the difficulty labels? Run npm run build as well as the tests before you report. End with RESULT_STATUS.",
                     "steps": [
                       {"call": "Bash", "input": {"command": "grep -rn DIFFICULTY_LABELS src"}},
                       {"test_run": "{build}"},
                       {"result": "complete", "text": "src/game/gameState.ts"}
                     ]}},
          {"wait_task": {"id": "researcher-e5", "state": "waiting", "result": "complete", "timeout": 600}},
          {"say": "src/game/gameState.ts."}
        ]
      }
    }
  }
}
